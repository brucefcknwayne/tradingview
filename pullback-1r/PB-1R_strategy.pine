//@version=6
strategy("NQ Pullback 1:1", shorttitle = "PB-1R", overlay = true, pyramiding = 0,
     default_qty_type = strategy.fixed, default_qty_value = 1, slippage = 1,
     commission_type = strategy.commission.cash_per_contract, commission_value = 2.5,
     use_bar_magnifier = true, process_orders_on_close = false)

// ─────────────────────────────────────────────────────────────────────────────
//  Kurzfristige Überdehnung gegen den Trend kaufen/verkaufen, exakt 1:1 RR.
//    Long : Trend oben (Kurs > EMA 200, EMA 50 > EMA 200) + RSI(2) unter 10
//    Short: Trend unten                                  + RSI(2) über 90
//    SL = ATR × Faktor, TP = gleicher Abstand (vom echten Einstiegskurs gemessen)
//  Jeder Filter ist einzeln abschaltbar, damit man sieht, was wirklich hilft.
//
//  TEST-ZEITRAUM: Parameter NUR an den Trades VOR "Test ab" einstellen.
//  Die Zeile "Test" in der Tabelle ist der ehrliche Wert – nur der zählt.
// ─────────────────────────────────────────────────────────────────────────────

const string G_E = "Einstieg"
const string G_F = "Filter"
const string G_X = "Ausstieg"
const string G_T = "Test-Zeitraum"

int    rsiLen   = input.int(2, "RSI-Länge", minval = 2, group = G_E)
float  rsiLo    = input.float(10, "Long, wenn RSI unter", minval = 1, maxval = 50, group = G_E)
float  rsiHi    = input.float(90, "Short, wenn RSI über", minval = 50, maxval = 99, group = G_E)
bool   allowL   = input.bool(true, "Longs", inline = "d", group = G_E)
bool   allowS   = input.bool(true, "Shorts", inline = "d", group = G_E)

bool   useTrend = input.bool(true, "Nur mit dem Trend (EMA)", group = G_F)
int    emaFastL = input.int(50, "EMA schnell", minval = 2, inline = "e", group = G_F)
int    emaSlowL = input.int(200, "EMA langsam", minval = 2, inline = "e", group = G_F)
bool   useVwap  = input.bool(false, "Long nur unter VWAP · Short nur über VWAP", group = G_F)
bool   useSess  = input.bool(true, "Nur in der Handelszeit", group = G_F)
string sess     = input.session("0945-1530", "Handelszeit (New York)", group = G_F)
int    maxDay   = input.int(3, "Max. Trades pro Tag", minval = 1, group = G_F)

float  slATR    = input.float(1.5, "SL = ATR ×", minval = 0.25, step = 0.25, group = G_X)
int    atrLen   = input.int(14, "ATR-Länge", minval = 2, group = G_X)
float  rr       = input.float(1.0, "TP = SL ×", minval = 0.25, step = 0.25, group = G_X, tooltip = "1.0 = 1:1")
bool   flatEOD  = input.bool(true, "Flat um 15:55 New York", group = G_X)

int    testFrom = input.time(timestamp("2026-03-24"), "Test ab", group = G_T, tooltip = "Alles davor = Training (hier darfst du Parameter drehen). Alles danach = Test (nicht mehr anfassen).")

// ═══════════════════════════ BERECHNUNG ═══════════════════════════
float rsi    = ta.rsi(close, rsiLen)
float emaF   = ta.ema(close, emaFastL)
float emaS   = ta.ema(close, emaSlowL)
float vw     = ta.vwap(hlc3)
float atr    = ta.atr(atrLen)

bool  inSess = not useSess or not na(time(timeframe.period, sess, "America/New_York"))
bool  eod    = flatEOD and not na(time(timeframe.period, "1555-1800", "America/New_York"))
bool  newDay = timeframe.change("D")

bool  upT    = not useTrend or (close > emaS and emaF > emaS)
bool  dnT    = not useTrend or (close < emaS and emaF < emaS)
bool  longS  = allowL and inSess and upT and rsi < rsiLo and (not useVwap or close < vw)
bool  shortS = allowS and inSess and dnT and rsi > rsiHi and (not useVwap or close > vw)

var int dayCount = 0
if newDay
    dayCount := 0

// ═══════════════════════════ ORDERS ═══════════════════════════
if barstate.isconfirmed
    if eod and strategy.position_size != 0
        strategy.close_all(comment = "EOD")

    if strategy.position_size == 0 and dayCount < maxDay and not eod and not na(atr)
        // SL/TP in Ticks → gemessen vom echten Einstiegskurs, also exakt 1:1
        int slTicks = math.max(1, math.round(slATR * atr / syminfo.mintick))
        int tpTicks = math.max(1, math.round(rr * slATR * atr / syminfo.mintick))
        if longS
            strategy.entry("L", strategy.long)
            strategy.exit("LX", "L", loss = slTicks, profit = tpTicks, comment_loss = "SL", comment_profit = "TP")
            dayCount += 1
        else if shortS
            strategy.entry("S", strategy.short)
            strategy.exit("SX", "S", loss = slTicks, profit = tpTicks, comment_loss = "SL", comment_profit = "TP")
            dayCount += 1

plot(useTrend ? emaS : na, "EMA langsam", color.new(color.gray, 40), 1)
bgcolor(time >= testFrom and time[1] < testFrom ? color.new(color.yellow, 60) : na, title = "Beginn Test-Zeitraum")

// ═══════════════════════════ AUSWERTUNG ═══════════════════════════
var table tbl = table.new(position.top_right, 5, 4, bgcolor = #131722, frame_color = #2a2e39, frame_width = 1, border_color = #2a2e39, border_width = 1)

f_row(int r, string name, int n, int w, float gp, float gl, float net) =>
    color  fg = #d1d4dc
    string wr = n > 0 ? str.tostring(100.0 * w / n, "#.0") + " %" : "–"
    string pf = gl > 0 ? str.tostring(gp / gl, "#.00") : "–"
    table.cell(tbl, 0, r, name, text_color = color.new(fg, 30), text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 1, r, str.tostring(n), text_color = fg, text_size = size.small)
    table.cell(tbl, 2, r, wr, text_color = n > 0 and 100.0 * w / n >= 65 ? #4caf50 : fg, text_size = size.small)
    table.cell(tbl, 3, r, pf, text_color = fg, text_size = size.small)
    table.cell(tbl, 4, r, str.tostring(net, "#,###") + " $", text_color = net >= 0 ? #4caf50 : #ff5252, text_size = size.small)

if barstate.islast
    int   nA   = 0
    int   wA   = 0
    float gpA  = 0.0
    float glA  = 0.0
    float netA = 0.0
    int   nB   = 0
    int   wB   = 0
    float gpB  = 0.0
    float glB  = 0.0
    float netB = 0.0
    if strategy.closedtrades > 0
        for i = 0 to strategy.closedtrades - 1
            float p   = strategy.closedtrades.profit(i)
            bool  oos = strategy.closedtrades.entry_time(i) >= testFrom
            if oos
                nB   += 1
                wB   += p > 0 ? 1 : 0
                gpB  += math.max(p, 0)
                glB  += math.max(-p, 0)
                netB += p
            else
                nA   += 1
                wA   += p > 0 ? 1 : 0
                gpA  += math.max(p, 0)
                glA  += math.max(-p, 0)
                netA += p
    table.cell(tbl, 0, 0, "",              text_color = #8a8f9c, text_size = size.small)
    table.cell(tbl, 1, 0, "Trades",        text_color = #8a8f9c, text_size = size.small)
    table.cell(tbl, 2, 0, "Trefferquote",  text_color = #8a8f9c, text_size = size.small)
    table.cell(tbl, 3, 0, "Profit-Faktor", text_color = #8a8f9c, text_size = size.small)
    table.cell(tbl, 4, 0, "Netto",         text_color = #8a8f9c, text_size = size.small)
    f_row(1, "Training", nA, wA, gpA, glA, netA)
    f_row(2, "Test",     nB, wB, gpB, glB, netB)
    f_row(3, "Gesamt",   nA + nB, wA + wB, gpA + gpB, glA + glB, netA + netB)
