//@version=6
indicator("Gotham Daily VWAP", overlay = true, max_bars_back = 5000)

// ═════════════════════════════════════════════════════════════════════════
// Only the blended VWAP from Gotham Signals Indi v2 (port of the MotiveWave
// "VWAP Blend", com.zera) – no bands, no signals.
//
// Starts as the overnight VWAP (from the daily open) and migrates into the RTH
// VWAP after the NY open, paced by a volume clock rather than wall-clock time:
//   RTH weight = RTH volume / (RTH volume + K)
// K automatic = median RTH volume 25 min after the open, last 20 days.
//
// Plus the inner (2σ) and outer (3σ) bands, and a ±0.5 stdev zone around it (stdev of the blended distribution), shaded
// grey: the stretch of price the mean is currently comfortable with.
// ═════════════════════════════════════════════════════════════════════════

// ─────────────── Time ───────────────
tzSel      = input.string("America/New_York", "Timezone", options = ["Exchange", "America/New_York", "America/Chicago", "Europe/London", "Europe/Berlin", "Asia/Tokyo", "Asia/Shanghai", "UTC"], group = "Time")
openHHMM   = input.string("1800", "Daily market open (HHMM)", group = "Time", tooltip = "In the timezone selected above. Futures (NQ/ES/GC) open at 1800 New York time.")
blockHours = input.float(2.0, "Blackout after open (hours)", minval = 0.0, maxval = 12.0, step = 0.5, group = "Time", tooltip = "Only used when 'Start VWAP after blackout' is on.")
vwapAfterBlackout = input.bool(false, "Start VWAP after blackout", group = "Time", tooltip = "On = blackout bars are excluded from the VWAP calculation.")

// ─────────────── VWAP blend (fixed, not adjustable) ───────────────
// NY open 09:30, session end 17:00 (through 16:59), K automatic with 150000
// as fallback for the first days before samples exist.
const int   rthHH = 930
const int   endHH = 1700
const bool  kAuto = true
const float kMan  = 150000

vwapColor = input.color(color.gray, "VWAP color", group = "Display")
vwapWidth = input.int(2, "VWAP width", minval = 1, maxval = 5, group = "Display")
bandMult   = input.float(2.0, "Inner band (× stdev)", minval = 0.5, maxval = 5.0, step = 0.1, group = "Bands", tooltip = "0.5 – 5. Hidden with the switch below.")
sdOuter    = input.float(3.0, "Outer band (× stdev)", minval = 0.5, maxval = 8.0, step = 0.1, group = "Bands", tooltip = "Clamped to at least the inner band.")
showInner  = input.bool(true, "Show inner band", group = "Bands")
showOuter  = input.bool(true, "Show outer band", group = "Bands")
bandColor  = input.color(color.gray, "Inner band color", group = "Bands")
band2Color = input.color(color.new(color.gray, 55), "Outer band color", group = "Bands")
sdZone    = input.float(0.5, "Zone (× stdev)", minval = 0.0, maxval = 5.0, step = 0.1, group = "Display", tooltip = "0 hides it.")
showZone  = input.bool(true, "Shade the zone", group = "Display")
zoneLine  = input.color(color.new(color.gray, 65), "Zone line color", group = "Display")
zoneFill  = input.color(color.new(color.gray, 85), "Zone fill color", group = "Display")

tz = tzSel == "Exchange" ? syminfo.timezone : tzSel

openMin    = nz(str.tonumber(str.substring(openHHMM, 0, 2))) * 60 + nz(str.tonumber(str.substring(openHHMM, 2, 4)))
curMin     = hour(time, tz) * 60 + minute(time, tz)
sinceOpen  = (curMin - openMin + 1440) % 1440
inBlackout = sinceOpen < blockHours * 60

hhmm(int v) => int(v / 100) * 60 + v % 100

ovnMin = openMin
rthMin = hhmm(rthHH)
endMin = hhmm(endHH)

inOvn = ovnMin > endMin ? (curMin >= ovnMin or curMin < endMin) : (curMin >= ovnMin and curMin < endMin)
inRth = curMin >= rthMin and curMin < endMin

// New session = minutes-since-anchor drops (works across the CME break,
// midnight and weekends; a false→true flag would never fire on futures).
sinceOvn = (curMin - ovnMin + 1440) % 1440
sinceRth = (curMin - rthMin + 1440) % 1440

newOvn = na(sinceOvn[1]) or sinceOvn < sinceOvn[1]
newRth = na(sinceRth[1]) or sinceRth < sinceRth[1]

var float ovnPV  = 0.0
var float ovnV   = 0.0
var float ovnPPV = 0.0
var float rthPV  = 0.0
var float rthV   = 0.0
var float rthPPV = 0.0
var int   anchorMs  = 0
var bool  kCaptured = false
var float kCur      = kMan
var array<float> kHist = array.new<float>()

medianOf(array<float> arr, float fb) =>
    n = array.size(arr)
    float r = fb
    if n > 0
        srt = array.copy(arr)
        array.sort(srt)
        h = int(n / 2)
        r := n % 2 == 1 ? array.get(srt, h) : (array.get(srt, h - 1) + array.get(srt, h)) / 2.0
    r

if newOvn
    ovnPV  := 0.0
    ovnV   := 0.0
    ovnPPV := 0.0

if newRth
    rthPV  := 0.0
    rthV   := 0.0
    rthPPV := 0.0
    anchorMs  := time
    kCaptured := false
    kCur      := kAuto ? medianOf(kHist, kMan) : kMan

// weight is based on the volume accumulated BEFORE this bar
vBefore = rthV

vBar = math.max(nz(volume), 0.0)
pBar = hlc3

takeBar = not (vwapAfterBlackout and inBlackout)

if inOvn and takeBar
    ovnPV  += pBar * vBar
    ovnV   += vBar
    ovnPPV += pBar * pBar * vBar

if inRth and takeBar
    rthPV  += pBar * vBar
    rthV   += vBar
    rthPPV += pBar * pBar * vBar

// K sample: RTH volume 25 minutes after the open, once per day, last 20 kept
if inRth and not kCaptured and (time - anchorMs) >= 25 * 60000
    array.push(kHist, rthV)
    while array.size(kHist) > 20
        array.shift(kHist)
    kCaptured := true

float vwapV  = na
float stdevV = na

if ovnV > 0
    vo   = ovnPV / ovnV
    varO = math.max(ovnPPV / ovnV - vo * vo, 0.0)
    if not inRth or rthV <= 0
        vwapV  := vo
        stdevV := math.sqrt(varO)
    else
        vr   = rthPV / rthV
        varR = math.max(rthPPV / rthV - vr * vr, 0.0)
        kk   = kCur > 0 ? kCur : kMan
        l    = math.min(math.max(vBefore / (vBefore + kk), 0.0), 1.0)
        b    = l * vr + (1.0 - l) * vo
        dR   = vr - b
        dO   = vo - b
        vwapV  := b
        // stdev of the blended distribution, not a blend of the two stdevs:
        // the distance of each mean from the blended mean is part of the spread
        stdevV := math.sqrt(math.max(l * (varR + dR * dR) + (1.0 - l) * (varO + dO * dO), 0.0))

plot(vwapV, "Gotham Daily VWAP", color = vwapColor, linewidth = vwapWidth)

// outer band clamped to at least the inner one
bandDist  = nz(bandMult * stdevV)
bandDist2 = math.max(nz(sdOuter * stdevV), bandDist)
plot(showInner ? vwapV + bandDist  : na, "Upper band",         color = color.new(bandColor, 30), linewidth = 2)
plot(showInner ? vwapV - bandDist  : na, "Lower band",         color = color.new(bandColor, 30), linewidth = 2)
plot(showOuter ? vwapV + bandDist2 : na, "Upper band (outer)", color = band2Color, linewidth = 1)
plot(showOuter ? vwapV - bandDist2 : na, "Lower band (outer)", color = band2Color, linewidth = 1)

zUp = plot(sdZone > 0 ? vwapV + sdZone * stdevV : na, "Zone +", color = zoneLine, linewidth = 1)
zDn = plot(sdZone > 0 ? vwapV - sdZone * stdevV : na, "Zone -", color = zoneLine, linewidth = 1)
fill(zUp, zDn, color = showZone and sdZone > 0 ? zoneFill : color.new(color.gray, 100), title = "Zone fill")
