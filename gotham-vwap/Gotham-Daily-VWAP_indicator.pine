//@version=6
indicator("Gotham Daily VWAP", overlay = true, max_bars_back = 5000)

// ═════════════════════════════════════════════════════════════════════════
// Only the blended VWAP from Gotham Signals Indi v2 (port of the MotiveWave
// "VWAP Blend", com.zera) – no bands, no signals.
//
// Starts as the overnight VWAP (from the daily open) and migrates into the RTH
// VWAP after the NY open, paced by a volume clock rather than wall-clock time:
//   RTH weight = RTH volume / (RTH volume + K)
// K automatic = median RTH volume 25 min after the open, last 20 days.
// ═════════════════════════════════════════════════════════════════════════

// ─────────────── Time ───────────────
tzSel      = input.string("America/New_York", "Timezone", options = ["Exchange", "America/New_York", "America/Chicago", "Europe/London", "Europe/Berlin", "Asia/Tokyo", "Asia/Shanghai", "UTC"], group = "Time")
openHHMM   = input.string("1800", "Daily market open (HHMM)", group = "Time", tooltip = "In the timezone selected above. Futures (NQ/ES/GC) open at 1800 New York time.")
blockHours = input.float(2.0, "Blackout after open (hours)", minval = 0.0, maxval = 12.0, step = 0.5, group = "Time", tooltip = "Only used when 'Start VWAP after blackout' is on.")
vwapAfterBlackout = input.bool(false, "Start VWAP after blackout", group = "Time", tooltip = "On = blackout bars are excluded from the VWAP calculation.")

// ─────────────── VWAP blend ───────────────
rthHH = input.int(930,  "NY open (HHMM)",      0, 2359, 5, group = "VWAP blend", tooltip = "When the RTH profile starts building and the blend begins.")
endHH = input.int(1700, "Session end (HHMM)",  0, 2359, 5, group = "VWAP blend", tooltip = "Runs up to the last minute before this: 1700 = through 16:59.")
kAuto = input.bool(true, "K automatic", group = "VWAP blend", tooltip = "Auto = median RTH volume 25 minutes after the open, over the last 20 days.")
kMan  = input.float(150000, "K manual / fallback", minval = 1, step = 1000, group = "VWAP blend", tooltip = "Used when K automatic is off, and for the first days before samples exist.")

vwapColor = input.color(color.gray, "VWAP color", group = "Display")
vwapWidth = input.int(2, "VWAP width", minval = 1, maxval = 5, group = "Display")

tz = tzSel == "Exchange" ? syminfo.timezone : tzSel

openMin    = nz(str.tonumber(str.substring(openHHMM, 0, 2))) * 60 + nz(str.tonumber(str.substring(openHHMM, 2, 4)))
curMin     = hour(time, tz) * 60 + minute(time, tz)
sinceOpen  = (curMin - openMin + 1440) % 1440
inBlackout = sinceOpen < blockHours * 60

hhmm(int v) => int(v / 100) * 60 + v % 100

ovnMin = openMin
rthMin = hhmm(rthHH)
endMin = hhmm(endHH)

if barstate.isfirst and endMin <= rthMin
    runtime.error("Session end (" + str.tostring(endHH) + ") must be AFTER the NY open (" + str.tostring(rthHH) + "), otherwise the VWAP never blends.")

inOvn = ovnMin > endMin ? (curMin >= ovnMin or curMin < endMin) : (curMin >= ovnMin and curMin < endMin)
inRth = curMin >= rthMin and curMin < endMin

// New session = minutes-since-anchor drops (works across the CME break,
// midnight and weekends; a false→true flag would never fire on futures).
sinceOvn = (curMin - ovnMin + 1440) % 1440
sinceRth = (curMin - rthMin + 1440) % 1440

newOvn = na(sinceOvn[1]) or sinceOvn < sinceOvn[1]
newRth = na(sinceRth[1]) or sinceRth < sinceRth[1]

var float ovnPV = 0.0
var float ovnV  = 0.0
var float rthPV = 0.0
var float rthV  = 0.0
var int   anchorMs  = 0
var bool  kCaptured = false
var float kCur      = kMan
var array<float> kHist = array.new<float>()

medianOf(array<float> arr, float fb) =>
    n = array.size(arr)
    float r = fb
    if n > 0
        srt = array.copy(arr)
        array.sort(srt)
        h = int(n / 2)
        r := n % 2 == 1 ? array.get(srt, h) : (array.get(srt, h - 1) + array.get(srt, h)) / 2.0
    r

if newOvn
    ovnPV := 0.0
    ovnV  := 0.0

if newRth
    rthPV := 0.0
    rthV  := 0.0
    anchorMs  := time
    kCaptured := false
    kCur      := kAuto ? medianOf(kHist, kMan) : kMan

// weight is based on the volume accumulated BEFORE this bar
vBefore = rthV

vBar = math.max(nz(volume), 0.0)
pBar = hlc3

takeBar = not (vwapAfterBlackout and inBlackout)

if inOvn and takeBar
    ovnPV += pBar * vBar
    ovnV  += vBar

if inRth and takeBar
    rthPV += pBar * vBar
    rthV  += vBar

// K sample: RTH volume 25 minutes after the open, once per day, last 20 kept
if inRth and not kCaptured and (time - anchorMs) >= 25 * 60000
    array.push(kHist, rthV)
    while array.size(kHist) > 20
        array.shift(kHist)
    kCaptured := true

float vwapV = na

if ovnV > 0
    vo = ovnPV / ovnV
    if not inRth or rthV <= 0
        vwapV := vo
    else
        vr = rthPV / rthV
        kk = kCur > 0 ? kCur : kMan
        l  = math.min(math.max(vBefore / (vBefore + kk), 0.0), 1.0)
        vwapV := l * vr + (1.0 - l) * vo

plot(vwapV, "Gotham Daily VWAP", color = vwapColor, linewidth = vwapWidth)
