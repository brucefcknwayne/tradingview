//@version=6
indicator("IB Expansion · TP & geschützte Level", shorttitle = "IB-Exp", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ─────────────────────────────────────────────────────────────────────────────
//  🦇  IB EXPANSION  ·  by @Brucefcknwayne
//
//  Levels ±0,1 … ±1,5 IB-Range über/unter der Initial Balance (jede volle Stunde +
//  08:30/09:30/10:30, Länge 15/30/45/60 Min). Jedes Level bekommt die Wahrscheinlichkeit,
//  bis Tagesende erreicht zu werden – live aktualisiert:
//    · bei IB-Ende: je Wochentag und ob IB-Hoch oder IB-Tief zuerst gebildet wurde
//    · danach: gemessen aus den Daten (letzte 3 Jahre), wie oft ein Level noch erreicht wird, wenn es
//      d IB-Ranges vom aktuellen Kurs entfernt ist und noch so viel Zeit übrig ist
//      (Bruch einer Seite, Rücklauf, späte Uhrzeit – alles steckt in Abstand + Zeit)
//  Getestet auf dem letzten Jahr (ungesehen): „TP ≥ 70 %“ wurde zu 71–82 % erreicht,
//  „geschützt“ nur zu 6–17 % (data-lab/results/ib_ext_stats.md).
//  TP-Level      = Wahrscheinlichkeit erreicht ≥ Schwelle (Standard 70 %)
//  Geschützt     = Wahrscheinlichkeit NICHT erreicht ≥ Schwelle → Stop dahinter
//  Alles unter der Schwelle wird nicht gezeigt. Jede Linie läuft mit, bis das Level
//  gebrochen ist oder der Tag endet, und bleibt dann stehen.
//  "gültig bis"  = ab dieser Uhrzeit fällt das TP-Level unter die Schwelle, falls bis dahin nichts passiert
//  Tagesende: 17:00 NY für IBs vor 09:30, sonst 16:00.
//
//  DATEN kommen aus vier Libraries (IBX_NQ, IBX_ES, IBX_RTY, IBX_GC), die du einmal selbst
//  veröffentlichen musst (privat reicht). Steht dein TradingView-Name anders als unten,
//  die vier import-Zeilen anpassen. Statistik: Databento CME 1m, letzte 3 Jahre.
// ─────────────────────────────────────────────────────────────────────────────

import Brucefcknwayne/IBX_NQ/1 as dNQ
import Brucefcknwayne/IBX_ES/1 as dES
import Brucefcknwayne/IBX_RTY/1 as dRTY
import Brucefcknwayne/IBX_GC/1 as dGC

const string TZ    = "America/New_York"
const string ALPHA = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
const string G_I   = "Initial Balance"
const string G_S   = "Schwellen"
const string G_A   = "Anzeige"

// ═══════════════════════════════ INPUTS ═══════════════════════════════
string startIn = input.string("09:30", "IB-Start (NY)", options = ["18:00", "19:00", "20:00", "21:00", "22:00", "23:00", "00:00", "01:00", "02:00", "03:00", "04:00", "05:00", "06:00", "07:00", "08:00", "08:30", "09:00", "09:30", "10:00", "10:30", "11:00", "12:00", "13:00", "14:00", "15:00"], group = G_I)
int    lenIn   = input.int(30, "IB-Länge (Min)", options = [15, 30, 45, 60], group = G_I)
bool   useWd   = input.bool(true, "Wochentag berücksichtigen", group = G_I, tooltip = "Bei IB-Ende die Statistik des heutigen Wochentags nutzen (sonst alle Tage).")
int    thrTP   = input.int(70, "TP-Level ab (% erreicht)", minval = 50, maxval = 95, group = G_S)
int    thrSL   = input.int(70, "Geschützt ab (% nicht erreicht)", minval = 50, maxval = 95, group = G_S)
string lblMode = input.string("Grenzen", "Beschriftung", options = ["Grenzen", "Alle Levels"], group = G_A, tooltip = "Grenzen: weitestes TP-Level und erstes geschütztes Level je Seite.")
bool   showIB  = input.bool(true, "IB-Hoch/-Tief immer zeigen", group = G_A, tooltip = "Als dünne Orientierung, auch wenn sie unter der Schwelle liegen.")
bool   showTab = input.bool(true, "Info-Tabelle", group = G_A)
color  cTP     = input.color(#2962ff, "TP", inline = "c", group = G_A)
color  cSL     = input.color(#ff9800, "Geschützt", inline = "c", group = G_A)
color  cIB     = input.color(#e535f5, "IB", inline = "c", group = G_A)
color  cNeu    = input.color(#787b86, "Neutral", inline = "c", group = G_A)

// ═══════════════════════════════ DATEN ═══════════════════════════════
string root = syminfo.root
string mk   = root == "NQ" or root == "MNQ" ? "NQ" : root == "ES" or root == "MES" ? "ES" : root == "RTY" or root == "M2K" ? "RTY" : root == "GC" or root == "MGC" ? "GC" : ""
string wkey = str.replace(startIn, ":", "") + "-" + str.tostring(lenIn)

var string DATA = ""
{{LOADS}}

var array<float> V = array.new<float>()
var int NDAYS = 0
if barstate.isfirst and str.length(DATA) > 0
    int sep = str.pos(DATA, "|")
    NDAYS := int(str.tonumber(str.substring(DATA, 0, sep)))
    string body = str.substring(DATA, sep + 1)
    for i = 0 to str.length(body) - 1
        int ix = str.pos(ALPHA, str.substring(body, i, i + 1))
        array.push(V, ix < 0 ? na : ix / 61.0)

bool hasData = array.size(V) == 1196

f_v(int i) =>
    hasData ? array.get(V, i) : na

// Tabellen-Layout (siehe data-lab/ib_ext_stats.py):
//   T1 0–575    ((Wochentag·3 + zuerst)·2 + Seite)·16 + k          P(erreicht) bei IB-Ende
//   G  576–1195 576 + (Seite·10 + Zeitstufe)·31 + Abstandsstufe   P(noch erreicht | Abstand, Zeit)
f_t1(int w, int f, int side, int k) =>
    float x = f_v(((w * 3 + f) * 2 + side) * 16 + k)
    if na(x)
        x := f_v((f * 2 + side) * 16 + k)
    if na(x)
        x := f_v(((w * 3) * 2 + side) * 16 + k)
    if na(x)
        x := f_v(side * 16 + k)
    x

f_gd(int side, int i, int j0, int j1, float fr) =>
    float a = f_v(576 + (side * 10 + i) * 31 + j0)
    float b = f_v(576 + (side * 10 + i) * 31 + j1)
    na(a) ? b : na(b) ? a : a + (b - a) * fr

// P(Level wird noch erreicht | Abstand d in IB-Ranges, vergangene Zeit q), linear interpoliert; q = 1 → 0
f_g(int side, float q, float d) =>
    float x  = d / 0.1 - 0.5
    int   j0 = math.max(0, math.min(30, int(math.floor(x))))
    int   j1 = math.min(j0 + 1, 30)
    float fr = math.max(0.0, math.min(1.0, x - j0))
    float qq = math.max(0.0, math.min(1.0, q)) * 10
    int   i0 = math.min(int(math.floor(qq)), 9)
    float a0 = f_gd(side, i0, j0, j1, fr)
    float a1 = i0 >= 9 ? 0.0 : f_gd(side, i0 + 1, j0, j1, fr)
    na(a0) ? a1 : na(a1) ? a0 : a0 + (a1 - a0) * (qq - i0)

// ═══════════════════════════════ ZEIT ═══════════════════════════════
f_rel(int t) =>
    (hour(t, TZ) * 60 + minute(t, TZ) - 1080 + 1440) % 1440

int relS   = (int(str.tonumber(str.substring(startIn, 0, 2))) * 60 + int(str.tonumber(str.substring(startIn, 3, 5))) - 1080 + 1440) % 1440
int relE   = relS + lenIn
int relEnd = relS < 930 ? 1380 : 1320
int relNow = f_rel(time)

// ═══════════════════════════════ TAGES-STATUS ═══════════════════════════════
var float ibH   = na
var float ibL   = na
var int   tH    = na
var int   tL    = na
var bool  done  = false
var int   upMax = -1
var int   dnMax = -1
var int   wdDay = 0
var int   ffDay = 0
var int   tIB   = na
var int   tEnd  = na
var array<line>  LU = array.new<line>()
var array<line>  LD = array.new<line>()
var array<label> LB = array.new<label>()

if timeframe.isintraday and timeframe.change("D")
    ibH   := na
    ibL   := na
    tH    := na
    tL    := na
    done  := false
    upMax := -1
    dnMax := -1
    array.clear(LU)
    array.clear(LD)
    for lb in LB
        label.delete(lb)
    array.clear(LB)

if relNow >= relS and relNow < relE
    if na(ibH) or high > ibH
        ibH := high
        tH  := time
    if na(ibL) or low < ibL
        ibL := low
        tL  := time

float R = ibH - ibL

f_price(int side, int k) =>
    side == 0 ? ibH + k * 0.1 * R : ibL - k * 0.1 * R

// IB fertig → 2 × 16 Linien
if not done and not na(ibH) and R > 0 and relNow >= relE and relNow < relEnd and hasData
    done  := true
    tIB   := time
    tEnd  := time + (relEnd - relNow) * 60000
    wdDay := useWd ? math.max(0, math.min(5, dayofweek(time_tradingday) - 1)) : 0
    ffDay := tH < tL ? 1 : tL < tH ? 2 : 0
    for k = 0 to 15
        array.push(LU, line.new(time, f_price(0, k), time, f_price(0, k), xloc = xloc.bar_time, color = color.new(cNeu, 100)))
        array.push(LD, line.new(time, f_price(1, k), time, f_price(1, k), xloc = xloc.bar_time, color = color.new(cNeu, 100)))

// erreichte Levels (Stand vor diesem Bar merken: was jetzt bricht, endet auf diesem Bar)
int upPrev = upMax
int dnPrev = dnMax
if done and relNow < relEnd
    while upMax < 15 and (upMax < 0 ? high > ibH : high >= f_price(0, upMax + 1))
        upMax += 1
    while dnMax < 15 and (dnMax < 0 ? low < ibL : low <= f_price(1, dnMax + 1))
        dnMax += 1

// ═══════════════════════════════ WAHRSCHEINLICHKEIT ═══════════════════════════════
float qNow = done ? (relNow - relE + 1) / float(relEnd - relE) : 0.0

f_dist(int side, int k) =>
    side == 0 ? (f_price(0, k) - close) / R : (close - f_price(1, k)) / R

// bis zum ersten erreichten Level: Übergang von T1 (Wochentag, zuerst gebildet) zu G in den ersten 10 % der Restzeit
f_prob(int side, int k) =>
    float g = f_g(side, qNow, math.max(0.0, f_dist(side, k)))
    float p = g
    if upMax < 0 and dnMax < 0
        float t1 = f_t1(wdDay, ffDay, side, k)
        float w  = math.min(qNow / 0.1, 1.0)
        p := na(t1) ? g : na(g) ? t1 : (1 - w) * t1 + w * g
    p

f_fmt(int k) =>
    str.replace(str.tostring(k / 10.0, "0.0"), ".", ",")

f_pct(float p) =>
    str.tostring(math.round(p * 100)) + " %"

// Uhrzeit, ab der ein TP-Level unter die Schwelle fällt (wenn der Kurs bis dahin hier bleibt)
f_valid(int side, int k) =>
    string out = "Tagesende"
    float d = math.max(0.0, f_dist(side, k))
    float q = qNow
    while q <= 1.0
        if f_g(side, q, d) < thrTP / 100.0
            out := str.format_time(int(tIB + q * (tEnd - tIB)), "HH:mm", TZ)
            break
        q += 0.02
    out

// Linienfarben auf jedem Bar (Historie behält den Endstand), Beschriftung nur auf dem letzten Bar
bool drawLbl = barstate.islast
if done and relNow < relEnd
    if drawLbl
        for lb in LB
            label.delete(lb)
        array.clear(LB)
    int xLbl = time + 3 * timeframe.in_seconds() * 1000
    for side = 0 to 1
        int   reached = side == 0 ? upPrev : dnPrev
        int   nowMax  = side == 0 ? upMax : dnMax
        int   bestTP  = -1
        int   firstSL = -1
        float pTP     = na
        float pSL     = na
        for k = 0 to 15
            line ln = side == 0 ? array.get(LU, k) : array.get(LD, k)
            bool isIB = k == 0
            if k > reached
                // läuft mit, bis gebrochen (dieser Bar ist dann der letzte) oder Tagesende
                line.set_x2(ln, time)
            if k > nowMax
                float p = f_prob(side, k)
                bool tp = not na(p) and p >= thrTP / 100.0
                bool sl = not na(p) and p <= 1 - thrSL / 100.0
                color c = tp ? cTP : sl ? cSL : cIB
                line.set_color(ln, tp or sl ? c : isIB and showIB ? color.new(cIB, 40) : color.new(c, 100))
                line.set_style(ln, sl ? line.style_dashed : line.style_solid)
                line.set_width(ln, isIB and (tp or sl) ? 2 : 1)
                if tp
                    bestTP := k
                    pTP    := p
                if sl and firstSL < 0
                    firstSL := k
                    pSL     := p
                if drawLbl and lblMode == "Alle Levels" and (tp or sl)
                    string nm = (side == 0 ? "+" : "−") + f_fmt(k)
                    array.push(LB, label.new(xLbl, f_price(side, k), nm + " · " + f_pct(p), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(c, 100), textcolor = c, size = size.tiny))
        if drawLbl and lblMode == "Grenzen"
            string sg = side == 0 ? "+" : "−"
            if bestTP >= 0
                string t = "TP " + sg + f_fmt(bestTP) + " IB · " + f_pct(pTP) + " · gültig bis " + f_valid(side, bestTP)
                array.push(LB, label.new(xLbl, f_price(side, bestTP), t, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(cTP, 80), textcolor = cTP, size = size.small))
            if firstSL >= 0
                string t = "Geschützt " + sg + f_fmt(firstSL) + " IB · " + f_pct(1 - pSL) + " hält"
                array.push(LB, label.new(xLbl, f_price(side, firstSL), t, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(cSL, 80), textcolor = cSL, size = size.small))

// ═══════════════════════════════ INFO ═══════════════════════════════
var table tb = table.new(position.top_right, 2, 5, bgcolor = color.new(color.black, 80))
if showTab and barstate.islast
    string wdTxt = array.get(array.from("alle Tage", "Mo", "Di", "Mi", "Do", "Fr"), wdDay)
    table.cell(tb, 0, 0, "IB", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 0, mk == "" ? "nur NQ/ES/RTY/GC" : mk + " · " + startIn + " · " + str.tostring(lenIn) + " Min", text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 1, "Statistik", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 1, hasData ? str.tostring(NDAYS) + " Tage · 3 J · " + wdTxt : "keine Daten für dieses Fenster", text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 2, "Zuerst", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 2, not done ? "IB läuft" : ffDay == 1 ? "IB-Hoch" : ffDay == 2 ? "IB-Tief" : "gleich", text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 3, "Erreicht", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 3, done ? "oben " + (upMax < 0 ? "–" : "+" + f_fmt(upMax)) + " · unten " + (dnMax < 0 ? "–" : "−" + f_fmt(dnMax)) : "–", text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 4, "Restzeit", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 4, done and relNow < relEnd ? str.tostring(math.round((1 - qNow) * 100)) + " % · Ende " + str.format_time(tEnd, "HH:mm", TZ) : "–", text_color = color.white, text_size = size.small)
