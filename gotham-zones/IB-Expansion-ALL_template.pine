//@version=6
indicator("IB Expansion · Targets & Protects", shorttitle = "IB-Exp", overlay = true, max_boxes_count = 500, max_lines_count = 100)
// 🦇 IB EXPANSION · by @Brucefcknwayne – ein Indikator für NQ, ES, RTY, GC (+ MNQ, MES, M2K, MGC), erkennt den Markt selbst.
// Vier IBs ab derselben Startzeit (15/30/45/60 Min), optional eine 2. Startzeit. Levels ±0,1 … ±3,0 IB-Range, gezeigt wird NUR ≥ 70 %:
//   Target    = wird bis Tagesende erreicht · Target IB-Rand = Eröffnung 09:30 außerhalb der IB → IB-Rand wird noch berührt
//   Protected = wird bis Tagesende NICHT erreicht
// Anzeige als Box mit Text („Target 73% · 30m“). Kompakt (Standard): je Seite nur das weiteste Target und das nächste
//   Protected aus allen IBs. Jede Box läuft, bis das Level berührt wird (✓ getroffen / ✗ gebrochen) oder der Tag endet.
// Einstufung bleibt: Ist ein Level einmal ≥ 70 %, bleibt es Target/Protected mit dem % von diesem Moment – so wurde gemessen.
// Alarme: Alarm anlegen → Bedingung „IB-Exp“ → „Jeder alert()-Funktionsaufruf“.
// Statistik: Databento CME 1m, letzte {{YEARS}} Jahre bis {{END}}, als kompakte Formel je Fenster (data-lab/ib_ext_model.py):
//   IB-Größe (klein/normal/groß ggü. 20 Vortagen) + Wochentag + live Abstand Level ↔ Kurs + Restzeit, minus Korrektur aus dem Prüfjahr.
// Gesperrt (im Test unzuverlässig): neue Targets in den letzten 10 % der Zeit, Target IB-Rand später als 10 % der Zeit ab 09:30.
// Tagesende 17:00 für IBs vor 09:30, sonst 16:00. Für 1m–5m-Charts. Test auf dem ungesehenen Jahr: data-lab/results/ib_ext_model.md

const string TZ    = "America/New_York"
const string ALPHA = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
const string KEYS  = "{{KEYS}}"
const int    NI    = 4      // IB-Längen 15 / 30 / 45 / 60
const int    NJ    = 8      // IBs gesamt: 2 Startzeiten x 4 Längen (j = Start x 4 + Länge)
const int    NK    = 31     // Level 0 … 30 (0,0 … 3,0 IB)
const int    NC    = 52     // Zahlen je IB: 6 Formeln x 5, Rücklauf 2 x 5, 2 Größen-Schwellen, Wochentag 2 Seiten x Mo–Fr
const int    KPB   = {{KPB}}      // Startzeiten je Datenblock
const string G_I   = "Initial Balance"
const string G_S   = "Schwellen"
const string G_A   = "Anzeige"

string startIn  = input.string("09:30", "IB-Start (NY)", options = ["18:00", "19:00", "20:00", "21:00", "22:00", "23:00", "00:00", "01:00", "02:00", "03:00", "04:00", "05:00", "06:00", "07:00", "08:00", "08:30", "09:00", "09:30", "10:00", "10:30", "11:00", "12:00", "13:00", "14:00", "15:00"], group = G_I)
string start2In = input.string("aus", "2. IB-Start (NY)", options = ["aus", "18:00", "19:00", "20:00", "21:00", "22:00", "23:00", "00:00", "01:00", "02:00", "03:00", "04:00", "05:00", "06:00", "07:00", "08:00", "08:30", "09:00", "09:30", "10:00", "10:30", "11:00", "12:00", "13:00", "14:00", "15:00"], group = G_I, tooltip = "Optional eine zweite Startzeit gleichzeitig, z. B. 08:30 + 09:30.")
bool   on15     = input.bool(true, "15 Min", inline = "l", group = G_I)
bool   on30     = input.bool(true, "30 Min", inline = "l", group = G_I)
bool   on45     = input.bool(true, "45 Min", inline = "l", group = G_I)
bool   on60     = input.bool(true, "60 Min", inline = "l", group = G_I)
int    thrTP    = input.int(70, "Target ab (% erreicht)", minval = 50, maxval = 95, group = G_S)
int    thrSL    = input.int(70, "Protected ab (% hält)", minval = 50, maxval = 95, group = G_S)
string viewMode = input.string("Kompakt", "Anzeige", options = ["Kompakt", "Je IB", "Alle Levels"], group = G_A, tooltip = "Kompakt: je Seite nur das weiteste Target und das nächste Protected aus allen IBs. Je IB: das für jede IB. Alle Levels: jedes Level ≥ Schwelle.")
string txtSize  = input.string("Normal", "Textgröße", options = ["Klein", "Normal", "Groß"], group = G_A)
bool   delOld   = input.bool(true, "Nur heute zeigen", group = G_A, tooltip = "Boxen der Vortage beim neuen Handelstag löschen.")
bool   showIB   = input.bool(false, "IB-Hoch/-Tief als Linie", group = G_A)
color  cBoxT    = input.color(#787b86, "Box Target", inline = "b", group = G_A)
color  cBoxS    = input.color(#787b86, "Box Protected", inline = "b", group = G_A)
color  cTxt     = input.color(#ffffff, "Text", inline = "b", group = G_A)
color  cIB      = input.color(#e535f5, "IB-Linie", inline = "b", group = G_A)
bool   alHit    = input.bool(true, "Alarm: Target getroffen / Protected gebrochen", group = "Alarme")
bool   alNew    = input.bool(false, "Alarm: neues Level ≥ Schwelle", group = "Alarme")

var array<int> LENS = array.from(15, 30, 45, 60)
bool two = start2In != "aus" and start2In != startIn
f_len(int j) =>
    array.get(LENS, j % NI)
f_on(int j) =>
    int l = j % NI
    (l == 0 ? on15 : l == 1 ? on30 : l == 2 ? on45 : on60) and (j < NI or two)
f_tag(int j) =>
    (two ? (j < NI ? startIn : start2In) + " " : "") + str.tostring(f_len(j)) + "m"

// ═══ DATEN: je Markt 3 Blöcke mit KPB Startzeiten (4 IB-Längen x 52 Zahlen à 2 Zeichen) + Korrektur (3 x 10 Zahlen) ═══
string root = syminfo.root
string mk   = root == "NQ" or root == "MNQ" ? "NQ" : root == "ES" or root == "MES" ? "ES" : root == "RTY" or root == "M2K" ? "RTY" : root == "GC" or root == "MGC" ? "GC" : ""
var string B0  = ""
var string B1  = ""
var string B2  = ""
var string COR = ""
{{LOADS}}
f_blk(int b) =>
    b == 0 ? B0 : b == 1 ? B1 : B2

f_dec(string s, int p, float sc) =>
    int c1 = str.pos(ALPHA, str.substring(s, p, p + 1))
    int c2 = str.pos(ALPHA, str.substring(s, p + 1, p + 2))
    c1 >= 0 and c2 >= 0 ? (c1 * 62 + c2 - 1922) / sc : na

var array<float> CF  = array.new<float>(NJ * NC, na)
var array<bool>  HAS = array.new<bool>(NJ, false)
var array<float> DT  = array.new<float>(10, 0.0)    // Korrektur je Zeitstufe (0 … 90 % der Restzeit): Target, Protect, Rücklauf
var array<float> DP  = array.new<float>(10, 0.0)
var array<float> DR  = array.new<float>(10, 0.0)
if barstate.isfirst
    for s = 0 to 1
        int    ki  = s == 0 or two ? int(str.pos(KEYS, s == 0 ? startIn : start2In) / 6) : -1
        string src = ki >= 0 ? f_blk(int(ki / KPB)) : ""
        int    p0  = (math.max(ki, 0) % KPB) * NI * NC * 2
        if ki >= 0 and str.length(src) >= p0 + NI * NC * 2
            for l = 0 to NI - 1
                int  j  = s * NI + l
                bool ok = true
                for i = 0 to NC - 1
                    float x = f_dec(src, p0 + (l * NC + i) * 2, 100.0)
                    array.set(CF, j * NC + i, x)
                    if na(x) and (i < 30 or i >= 40)
                        ok := false
                array.set(HAS, j, ok)
if barstate.isfirst and str.length(COR) == 60
    for i = 0 to 9
        array.set(DT, i, f_dec(COR, i * 2, 1000.0))
        array.set(DP, i, f_dec(COR, 20 + i * 2, 1000.0))
        array.set(DR, i, f_dec(COR, 40 + i * 2, 1000.0))

f_c(int j, int i) =>
    array.get(CF, j * NC + i)

f_corr(array<float> a, float q) =>
    float qq = math.max(0.0, math.min(1.0, q)) * 10
    int   i0 = math.min(int(math.floor(qq)), 9)
    float x0 = array.get(a, i0)
    x0 + (array.get(a, math.min(i0 + 1, 9)) - x0) * math.min(qq - i0, 1.0)

// Wochentag des Handelstags (Sitzung ab 18:00 zählt zum nächsten Tag): 0 = Mo … 4 = Fr
int wdI = dayofweek(time_tradingday, "UTC") - dayofweek.monday

// logit p = b0 + b1·u + b2·v + b3·u·v + b4·u² + w, u = ln(d + 0,03), v = ln(1 − q + 0,02); d = Abstand in IB-Ranges,
// q = vergangene Restzeit, w = Zuschlag für den Wochentag
f_logit(int j, int o, float d, float q, float w) =>
    float u = math.log(math.max(d, 0.0) + 0.03)
    float v = math.log(1 - math.max(0.0, math.min(0.98, q)) + 0.02)
    1 / (1 + math.exp(-(f_c(j, o) + f_c(j, o + 1) * u + f_c(j, o + 2) * v + f_c(j, o + 3) * u * v + f_c(j, o + 4) * u * u + w)))

// P(Level wird noch erreicht | Größe c, Wochentag, Seite, Zeit q, Abstand d) – roh, vor Korrektur
f_g(int j, int c, int side, float q, float d) =>
    float w = wdI >= 0 and wdI <= 4 ? f_c(j, 42 + side * 5 + wdI) : 0.0
    array.get(HAS, j) ? f_logit(j, (((c == 0 ? 2 : c) - 1) * 2 + side) * 5, d, q, w) : na

// P(Rücklauf zum IB-Rand | Abstand d, Zeit q ab 09:30)
f_rt(int j, int side, float q, float d) =>
    array.get(HAS, j) and not na(f_c(j, 30 + side * 5)) ? f_logit(j, 30 + side * 5, d, q, 0.0) : na

// ═══ ZEIT & IB-GRÖSSE ═══
f_rel(int t) =>
    (hour(t, TZ) * 60 + minute(t, TZ) - 1080 + 1440) % 1440

f_relOf(string st) =>
    (int(str.tonumber(str.substring(st, 0, 2))) * 60 + int(str.tonumber(str.substring(st, 3, 5))) - 1080 + 1440) % 1440

int relS1  = f_relOf(startIn)
int relS2  = two ? f_relOf(start2In) : relS1
int rel930 = 930
int relNow = f_rel(time)
f_relS(int j) =>
    j < NI ? relS1 : relS2
f_relE(int j) =>
    f_relS(j) + f_len(j)
f_relEnd(int j) =>
    f_relS(j) < rel930 ? 1380 : 1320

// Median der IB-Range derselben Uhrzeit an den 20 Tagen davor (aus 15-Min-Kerzen, reicht weiter zurück)
f_ibMedian(int rs, int len) =>
    var array<float> hist = array.new<float>()
    var float h = na
    var float l = na
    if timeframe.change("D")
        h := na
        l := na
    float med = array.size(hist) >= 10 ? array.median(hist) : na
    int rn = f_rel(time)
    if rn >= rs and rn < rs + len
        h := na(h) ? high : math.max(h, high)
        l := na(l) ? low : math.min(l, low)
        if f_rel(time_close) == (rs + len) % 1440 and h > l
            array.push(hist, h - l)
            if array.size(hist) > 20
                array.shift(hist)
    med

float m10 = request.security(syminfo.tickerid, "15", f_ibMedian(relS1, 15))
float m11 = request.security(syminfo.tickerid, "15", f_ibMedian(relS1, 30))
float m12 = request.security(syminfo.tickerid, "15", f_ibMedian(relS1, 45))
float m13 = request.security(syminfo.tickerid, "15", f_ibMedian(relS1, 60))
float m20 = request.security(syminfo.tickerid, "15", f_ibMedian(relS2, 15))
float m21 = request.security(syminfo.tickerid, "15", f_ibMedian(relS2, 30))
float m22 = request.security(syminfo.tickerid, "15", f_ibMedian(relS2, 45))
float m23 = request.security(syminfo.tickerid, "15", f_ibMedian(relS2, 60))
f_med(int j) =>
    j == 0 ? m10 : j == 1 ? m11 : j == 2 ? m12 : j == 3 ? m13 : j == 4 ? m20 : j == 5 ? m21 : j == 6 ? m22 : m23

// ═══ TAGES-STATUS je IB ═══
var array<float> aH     = array.new<float>(NJ, na)
var array<float> aL     = array.new<float>(NJ, na)
var array<bool>  aDone  = array.new<bool>(NJ, false)
var array<int>   aUp    = array.new<int>(NJ, -1)
var array<int>   aDn    = array.new<int>(NJ, -1)
var array<int>   aCls   = array.new<int>(NJ, 0)
var array<int>   aRtS   = array.new<int>(NJ, -1)
var array<bool>  aRtHit = array.new<bool>(NJ, false)
var array<bool>  aRtSet = array.new<bool>(NJ, false)
var array<bool>  aRtAct = array.new<bool>(NJ, false)
var array<float> aRtP   = array.new<float>(NJ, na)
var array<box>   RTB    = array.new<box>(NJ)
var array<line>  IBL    = array.new<line>(NJ * 2)
// je IB, Seite, Level: Art (0 nichts, 1 Target, 2 Protected; bleibt bis Tagesende), getroffen, % beim Erscheinen, Box, sichtbar
var array<int>   ST     = array.new<int>(NJ * 2 * NK, 0)
var array<bool>  SH     = array.new<bool>(NJ * 2 * NK, false)
var array<float> SP     = array.new<float>(NJ * 2 * NK, na)
var array<box>   BX     = array.new<box>(NJ * 2 * NK)
var array<bool>  SV     = array.new<bool>(NJ * 2 * NK, false)

f_si(int j, int side, int k) =>
    (j * 2 + side) * NK + k

if timeframe.isintraday and timeframe.change("D")
    for i = 0 to NJ * 2 * NK - 1
        if delOld
            box.delete(array.get(BX, i))
        array.set(BX, i, na)
    for j = 0 to NJ - 1
        if delOld
            box.delete(array.get(RTB, j))
            line.delete(array.get(IBL, j * 2))
            line.delete(array.get(IBL, j * 2 + 1))
        array.set(RTB, j, na)
        array.set(IBL, j * 2, na)
        array.set(IBL, j * 2 + 1, na)
        array.set(aH, j, na)
        array.set(aL, j, na)
    array.fill(aDone, false)
    array.fill(aUp, -1)
    array.fill(aDn, -1)
    array.fill(aRtS, -1)
    array.fill(aRtHit, false)
    array.fill(aRtSet, false)
    array.fill(aRtAct, false)
    array.fill(aRtP, na)
    array.fill(ST, 0)
    array.fill(SH, false)
    array.fill(SP, na)
    array.fill(SV, false)

f_R(int j) =>
    array.get(aH, j) - array.get(aL, j)

f_price(int j, int side, int k) =>
    side == 0 ? array.get(aH, j) + k * 0.1 * f_R(j) : array.get(aL, j) - k * 0.1 * f_R(j)

for j = 0 to NJ - 1
    // IB aufbauen
    if relNow >= f_relS(j) and relNow < f_relE(j)
        array.set(aH, j, na(array.get(aH, j)) ? high : math.max(array.get(aH, j), high))
        array.set(aL, j, na(array.get(aL, j)) ? low : math.min(array.get(aL, j), low))
    // IB fertig: Größenklasse ggü. den 20 Tagen davor
    float R = f_R(j)
    if f_on(j) and mk != "" and not array.get(aDone, j) and not na(R) and R > 0 and relNow >= f_relE(j) and relNow < f_relEnd(j) and array.get(HAS, j)
        array.set(aDone, j, true)
        float med = f_med(j)
        float rs  = na(med) or med <= 0 ? na : R / med
        array.set(aCls, j, na(rs) ? 0 : rs <= f_c(j, 40) ? 1 : rs >= f_c(j, 41) ? 3 : 2)
        if showIB
            array.set(IBL, j * 2, line.new(time, array.get(aH, j), time, array.get(aH, j), xloc = xloc.bar_time, color = color.new(cIB, 40)))
            array.set(IBL, j * 2 + 1, line.new(time, array.get(aL, j), time, array.get(aL, j), xloc = xloc.bar_time, color = color.new(cIB, 40)))
    if array.get(aDone, j) and relNow < f_relEnd(j) and showIB
        line.set_x2(array.get(IBL, j * 2), time)
        line.set_x2(array.get(IBL, j * 2 + 1), time)

// erreichte Levels (Stand vor diesem Bar merken: was jetzt getroffen wird, endet auf diesem Bar)
array<int> upPrev = array.copy(aUp)
array<int> dnPrev = array.copy(aDn)
for j = 0 to NJ - 1
    if array.get(aDone, j) and relNow < f_relEnd(j)
        int u = array.get(aUp, j)
        while u < NK - 1 and (u < 0 ? high > array.get(aH, j) : high >= f_price(j, 0, u + 1))
            u += 1
        array.set(aUp, j, u)
        int d = array.get(aDn, j)
        while d < NK - 1 and (d < 0 ? low < array.get(aL, j) : low <= f_price(j, 1, d + 1))
            d += 1
        array.set(aDn, j, d)

// ═══ WAHRSCHEINLICHKEIT & HILFEN ═══
f_q(int j) =>
    (relNow - f_relE(j) + 1) / float(f_relEnd(j) - f_relE(j))

f_dist(int j, int side, int k) =>
    side == 0 ? (f_price(j, 0, k) - close) / f_R(j) : (close - f_price(j, 1, k)) / f_R(j)

f_fmt(int k) =>
    str.replace(str.tostring(k / 10.0, "0.0"), ".", ",")

f_pct(float p) =>
    str.tostring(math.round(p * 100)) + "%"

f_size() =>
    txtSize == "Klein" ? size.small : txtSize == "Groß" ? size.large : size.normal

f_box(int j, float y, string t) =>
    float h = math.max(f_R(j) * 0.04, syminfo.mintick * 2)
    box.new(time, y + h, time, y - h, xloc = xloc.bar_time, border_width = 0, bgcolor = color.new(cBoxT, 100), text = t, text_color = color.new(cTxt, 100), text_size = f_size(), text_halign = text.align_center, text_valign = text.align_center)

f_txt(int typ, float p, int j) =>
    (typ == 1 ? "Target " : "Protected ") + f_pct(p) + " · " + f_tag(j)

// ═══ EINSTUFUNG & TREFFER ═══
string msgHit = ""
string msgNew = ""
array<int> aBT = array.new<int>(NJ * 2, -1)    // je IB und Seite: weitestes offenes Target
array<int> aFS = array.new<int>(NJ * 2, -1)    // je IB und Seite: nächstes offenes Protected

for j = 0 to NJ - 1
    if array.get(aDone, j) and relNow < f_relEnd(j)
        float q = f_q(j)
        for side = 0 to 1
            int    reached = side == 0 ? array.get(upPrev, j) : array.get(dnPrev, j)
            int    nowMax  = side == 0 ? array.get(aUp, j) : array.get(aDn, j)
            string sg      = side == 0 ? "+" : "−"
            for k = 0 to NK - 1
                int si  = f_si(j, side, k)
                int typ = array.get(ST, si)
                box bx  = array.get(BX, si)
                // läuft weiter, bis getroffen (dieser Bar ist dann der letzte) oder Tagesende
                if k > reached and not na(bx)
                    box.set_right(bx, time)
                if k > reached and k <= nowMax and typ > 0
                    array.set(SH, si, true)
                    msgHit += f_tag(j) + (typ == 1 ? " Target " : " Protected ") + sg + f_fmt(k) + " IB" + (typ == 1 ? " getroffen ✓" : " gebrochen ✗") + "\n"
                    if not na(bx) and array.get(SV, si)
                        box.set_text(bx, f_txt(typ, array.get(SP, si), j) + (typ == 1 ? " ✓" : " ✗"))
                // noch nicht eingestuft: erreicht es jetzt die Schwelle, bleibt die Einstufung bis Treffer oder Tagesende
                if k > nowMax and typ == 0
                    float p  = f_g(j, array.get(aCls, j), side, q, f_dist(j, side, k))
                    float pT = p - f_corr(DT, q)          // Target: Sicherheit erreicht (korrigiert)
                    float pS = 1 - p - f_corr(DP, q)      // Protected: Sicherheit hält (korrigiert)
                    bool  tp = not na(p) and p >= 0.5 and pT >= thrTP / 100.0 and q < 0.9   // letzte 10 % der Zeit: Targets unzuverlässig
                    bool  sl = not na(p) and p < 0.5 and pS >= thrSL / 100.0
                    if tp or sl
                        typ := tp ? 1 : 2
                        array.set(ST, si, typ)
                        array.set(SP, si, tp ? pT : pS)
                        msgNew += f_tag(j) + (tp ? " Target " : " Protected ") + sg + f_fmt(k) + " IB · " + f_pct(tp ? pT : pS) + "\n"
                if k > nowMax and typ == 1
                    array.set(aBT, j * 2 + side, k)
                if k > nowMax and typ == 2 and array.get(aFS, j * 2 + side) < 0
                    array.set(aFS, j * 2 + side, k)

// Kompakt: je Seite das weiteste Target und das nächste Protected über alle IBs
array<int>   gT  = array.from(-1, -1)
array<int>   gS  = array.from(-1, -1)
array<float> gTp = array.new<float>(2, na)
array<float> gSp = array.new<float>(2, na)
for j = 0 to NJ - 1
    if array.get(aDone, j) and relNow < f_relEnd(j)
        for side = 0 to 1
            int kt = array.get(aBT, j * 2 + side)
            int ks = array.get(aFS, j * 2 + side)
            if kt >= 0
                float pr = f_price(j, side, kt)
                if na(array.get(gTp, side)) or (side == 0 ? pr > array.get(gTp, side) : pr < array.get(gTp, side))
                    array.set(gTp, side, pr)
                    array.set(gT, side, f_si(j, side, kt))
            if ks >= 0
                float pr = f_price(j, side, ks)
                if na(array.get(gSp, side)) or (side == 0 ? pr < array.get(gSp, side) : pr > array.get(gSp, side))
                    array.set(gSp, side, pr)
                    array.set(gS, side, f_si(j, side, ks))

// Boxen: offene Levels nur zeigen, wenn ausgewählt; getroffene behalten ihren letzten Zustand
for j = 0 to NJ - 1
    if array.get(aDone, j) and relNow < f_relEnd(j)
        for side = 0 to 1
            int nowMax = side == 0 ? array.get(aUp, j) : array.get(aDn, j)
            if nowMax < NK - 1
                for k = nowMax + 1 to NK - 1
                    int si  = f_si(j, side, k)
                    int typ = array.get(ST, si)
                    if typ > 0
                        bool vis = viewMode == "Alle Levels" or (viewMode == "Je IB" ? k == array.get(aBT, j * 2 + side) or k == array.get(aFS, j * 2 + side) : si == array.get(gT, side) or si == array.get(gS, side))
                        if vis != array.get(SV, si)
                            array.set(SV, si, vis)
                            box bx = array.get(BX, si)
                            if na(bx) and vis
                                bx := f_box(j, f_price(j, side, k), f_txt(typ, array.get(SP, si), j))
                                array.set(BX, si, bx)
                            if not na(bx)
                                box.set_bgcolor(bx, color.new(typ == 1 ? cBoxT : cBoxS, vis ? 40 : 100))
                                box.set_text_color(bx, color.new(cTxt, vis ? 0 : 100))

// ═══ TARGET IB-RAND: nur IBs fertig bis 09:30, Eröffnung über IB-Hoch / unter IB-Tief → Rücklauf zum IB-Rand ═══
int   rtBest = -1
float rtBp   = na
for j = 0 to NJ - 1
    if array.get(aDone, j) and f_relE(j) <= rel930 and relNow >= rel930 and relNow < f_relEnd(j)
        float H = array.get(aH, j)
        float L = array.get(aL, j)
        if not array.get(aRtSet, j)
            array.set(aRtSet, j, true)
            array.set(aRtS, j, open > H ? 0 : open < L ? 1 : -1)
        int sd = array.get(aRtS, j)
        if sd >= 0 and not array.get(aRtHit, j)
            box bx = array.get(RTB, j)
            if not na(bx)
                box.set_right(bx, time)
            if sd == 0 ? low <= H : high >= L
                array.set(aRtHit, j, true)
                if array.get(aRtAct, j)
                    msgHit += f_tag(j) + " Target IB-Rand getroffen ✓\n"
                    box.set_text(bx, "Target " + f_pct(array.get(aRtP, j)) + " · " + f_tag(j) + " IB-Rand ✓")
            else if not array.get(aRtAct, j)
                // einmal ≥ Schwelle (nur direkt nach der Eröffnung verlässlich) → bleibt bis Treffer oder Tagesende
                float qR = (relNow - rel930 + 1) / float(f_relEnd(j) - rel930)
                float p  = f_rt(j, sd, qR, sd == 0 ? (close - H) / f_R(j) : (L - close) / f_R(j)) - f_corr(DR, qR)
                if not na(p) and p >= thrTP / 100.0 and qR < 0.1
                    array.set(aRtAct, j, true)
                    array.set(aRtP, j, p)
                    array.set(RTB, j, f_box(j, sd == 0 ? H : L, "Target " + f_pct(p) + " · " + f_tag(j) + " IB-Rand"))
                    msgNew += f_tag(j) + " Target IB-Rand · " + f_pct(p) + "\n"
            if array.get(aRtAct, j) and not array.get(aRtHit, j) and (na(rtBp) or array.get(aRtP, j) > rtBp)
                rtBest := j
                rtBp   := array.get(aRtP, j)
// sichtbar: offene Rand-Targets (Kompakt: nur das sicherste); getroffene bleiben sichtbar
for j = 0 to NJ - 1
    box bx = array.get(RTB, j)
    if not na(bx) and not array.get(aRtHit, j)
        bool vis = viewMode != "Kompakt" or j == rtBest
        box.set_bgcolor(bx, color.new(cBoxT, vis ? 40 : 100))
        box.set_text_color(bx, color.new(cTxt, vis ? 0 : 100))

string title = mk + " · Start " + startIn + (two ? " / " + start2In : "")
if alHit and msgHit != ""
    alert("IB-Exp " + title + "\n" + msgHit, alert.freq_once_per_bar)
if alNew and msgNew != ""
    alert("IB-Exp " + title + " · neu\n" + msgNew, alert.freq_once_per_bar)
