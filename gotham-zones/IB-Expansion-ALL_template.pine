//@version=6
indicator("IB Expansion · Tagesplan", shorttitle = "IB-Exp", overlay = true, max_lines_count = 100, max_labels_count = 100)
// 🦇 IB EXPANSION · by @Brucefcknwayne – ein Indikator für NQ, ES, RTY, GC (+ MNQ, MES, M2K, MGC), erkennt den Markt selbst.
// TAGESPLAN: Sobald die IBs fertig sind (15/30/45/60 Min ab der Startzeit, optional 2. Startzeit), wählt der Indikator EINMAL
// höchstens 4 Levels aus allen IBs – danach ändert sich für den Tag nichts mehr:
//   TP oben / TP unten           = das weiteste Level, das bis Tagesende mit ≥ 80 % erreicht wird
//   Protected oben / unten       = das nächste Level, das bis Tagesende mit ≥ 80 % NICHT erreicht wird
//   TP IB-Rand (nur IBs bis 09:30) = Eröffnung 09:30 außerhalb der IB → IB-Rand wird noch berührt (füllt einen freien TP-Platz)
// Jede Linie läuft bis zur Berührung (✓ TP erreicht / ✗ Protected gebrochen) oder bis Tagesende.
// Statistik: Databento CME 1m, letzte {{YEARS}} Jahre bis {{END}}, als kompakte Formel je Fenster (data-lab/ib_ext_model.py):
//   IB-Größe (klein/normal/groß ggü. 20 Vortagen) + Wochentag + Abstand Level ↔ Kurs + Restzeit, minus Korrektur aus dem Prüfjahr.
// Alarme: Alarm anlegen → Bedingung „IB-Exp“ → „Jeder alert()-Funktionsaufruf“.
// Tagesende 17:00 für IBs vor 09:30, sonst 16:00. Für 1m–5m-Charts. Prüfung: data-lab/results/ib_ext_model.md, ib_ext_plan_check.md

const string TZ    = "America/New_York"
const string ALPHA = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
const string KEYS  = "{{KEYS}}"
const int    NI    = 4      // IB-Längen 15 / 30 / 45 / 60
const int    NJ    = 8      // IBs gesamt: 2 Startzeiten x 4 Längen (j = Start x 4 + Länge)
const int    NK    = 31     // Level 0 … 30 (0,0 … 3,0 IB)
const int    NC    = 52     // Zahlen je IB: 6 Formeln x 5, Rücklauf 2 x 5, 2 Größen-Schwellen, Wochentag 2 Seiten x Mo–Fr
const int    KPB   = {{KPB}}      // Startzeiten je Datenblock
const string G_I   = "Initial Balance"
const string G_S   = "Schwellen"
const string G_A   = "Anzeige"

string startIn  = input.string("09:30", "IB-Start (NY)", options = ["18:00", "19:00", "20:00", "21:00", "22:00", "23:00", "00:00", "01:00", "02:00", "03:00", "04:00", "05:00", "06:00", "07:00", "08:00", "08:30", "09:00", "09:30", "10:00", "10:30", "11:00", "12:00", "13:00", "14:00", "15:00"], group = G_I)
string start2In = input.string("aus", "2. IB-Start (NY)", options = ["aus", "18:00", "19:00", "20:00", "21:00", "22:00", "23:00", "00:00", "01:00", "02:00", "03:00", "04:00", "05:00", "06:00", "07:00", "08:00", "08:30", "09:00", "09:30", "10:00", "10:30", "11:00", "12:00", "13:00", "14:00", "15:00"], group = G_I, tooltip = "Optional eine zweite Startzeit, z. B. 08:30 + 09:30. Der Plan kommt, wenn alle IBs fertig sind.")
bool   on15     = input.bool(true, "15 Min", inline = "l", group = G_I)
bool   on30     = input.bool(true, "30 Min", inline = "l", group = G_I)
bool   on45     = input.bool(true, "45 Min", inline = "l", group = G_I)
bool   on60     = input.bool(true, "60 Min", inline = "l", group = G_I, tooltip = "Der Plan steht, sobald die längste eingeschaltete IB fertig ist (09:30 + 60 Min = 10:30).")
int    thrTP    = input.int(80, "TP ab (% erreicht)", minval = 50, maxval = 95, group = G_S, tooltip = "80 %: im Testjahr angezeigt 81 %, erreicht 80 %. Bei 70 % war die Auswahl zu optimistisch (71 % → 67 %).")
int    thrSL    = input.int(80, "Protected ab (% hält)", minval = 50, maxval = 98, group = G_S, tooltip = "Im Testjahr angezeigt 81 %, gehalten 82 % (mit Plan-Korrektur).")
color  cTPc     = input.color(#26a69a, "TP", inline = "c", group = G_A)
color  cSLc     = input.color(#ef5350, "Protected", inline = "c", group = G_A)
string txtSize  = input.string("Normal", "Textgröße", options = ["Klein", "Normal", "Groß"], group = G_A)
bool   delOld   = input.bool(true, "Nur heute zeigen", group = G_A, tooltip = "Linien der Vortage beim neuen Handelstag löschen.")
bool   showIB   = input.bool(false, "IB-Hoch/-Tief als Linie", group = G_A)
color  cIB      = input.color(#9598a1, "IB-Linie", group = G_A)
bool   alHit    = input.bool(true, "Alarm: TP erreicht / Protected gebrochen", group = "Alarme")
bool   alPlan   = input.bool(false, "Alarm: Tagesplan steht", group = "Alarme")

var array<int> LENS = array.from(15, 30, 45, 60)
bool two = start2In != "aus" and start2In != startIn
f_len(int j) =>
    array.get(LENS, j % NI)
f_on(int j) =>
    int l = j % NI
    (l == 0 ? on15 : l == 1 ? on30 : l == 2 ? on45 : on60) and (j < NI or two)
f_ki(int j) =>
    int(str.pos(KEYS, j < NI ? startIn : start2In) / 6)
f_tag(int j) =>
    (two ? (j < NI ? startIn : start2In) + " " : "") + str.tostring(f_len(j)) + "m"

// ═══ DATEN: je Markt 3 Blöcke mit KPB Startzeiten (4 IB-Längen x 52 Zahlen à 2 Zeichen) + Korrektur (3 x 10 Zahlen) ═══
string root = syminfo.root
string mk   = root == "NQ" or root == "MNQ" ? "NQ" : root == "ES" or root == "MES" ? "ES" : root == "RTY" or root == "M2K" ? "RTY" : root == "GC" or root == "MGC" ? "GC" : ""
var string B0  = ""
var string B1  = ""
var string B2  = ""
var string COR = ""
{{LOADS}}
f_blk(int b) =>
    b == 0 ? B0 : b == 1 ? B1 : B2

f_dec(string s, int p, float sc) =>
    int c1 = str.pos(ALPHA, str.substring(s, p, p + 1))
    int c2 = str.pos(ALPHA, str.substring(s, p + 1, p + 2))
    c1 >= 0 and c2 >= 0 ? (c1 * 62 + c2 - 1922) / sc : na

var array<float> CF  = array.new<float>(NJ * NC, na)
var array<bool>  HAS = array.new<bool>(NJ, false)
var array<float> DT  = array.new<float>(10, 0.0)    // Korrektur je Zeitstufe (0 … 90 % der Restzeit): Target, Protect, Rücklauf
var array<float> DP  = array.new<float>(10, 0.0)
var array<float> DR  = array.new<float>(10, 0.0)
var array<float> DPL = array.new<float>(25, 0.0)     // Plan-Korrektur Protected je Startzeit (Auswahl aus 4 IBs ist sonst zu optimistisch)
if barstate.isfirst
    for s = 0 to 1
        int    ki  = s == 0 or two ? int(str.pos(KEYS, s == 0 ? startIn : start2In) / 6) : -1
        string src = ki >= 0 ? f_blk(int(ki / KPB)) : ""
        int    p0  = (math.max(ki, 0) % KPB) * NI * NC * 2
        if ki >= 0 and str.length(src) >= p0 + NI * NC * 2
            for l = 0 to NI - 1
                int  j  = s * NI + l
                bool ok = true
                for i = 0 to NC - 1
                    float x = f_dec(src, p0 + (l * NC + i) * 2, 100.0)
                    array.set(CF, j * NC + i, x)
                    if na(x) and (i < 30 or i >= 40)
                        ok := false
                array.set(HAS, j, ok)
if barstate.isfirst and str.length(COR) == 110
    for i = 0 to 24
        array.set(DPL, i, f_dec(COR, 60 + i * 2, 1000.0))
    for i = 0 to 9
        array.set(DT, i, f_dec(COR, i * 2, 1000.0))
        array.set(DP, i, f_dec(COR, 20 + i * 2, 1000.0))
        array.set(DR, i, f_dec(COR, 40 + i * 2, 1000.0))

f_c(int j, int i) =>
    array.get(CF, j * NC + i)

f_corr(array<float> a, float q) =>
    float qq = math.max(0.0, math.min(1.0, q)) * 10
    int   i0 = math.min(int(math.floor(qq)), 9)
    float x0 = array.get(a, i0)
    x0 + (array.get(a, math.min(i0 + 1, 9)) - x0) * math.min(qq - i0, 1.0)

// Wochentag des Handelstags (Sitzung ab 18:00 zählt zum nächsten Tag): 0 = Mo … 4 = Fr
int wdI = dayofweek(time_tradingday, "UTC") - dayofweek.monday

// logit p = b0 + b1·u + b2·v + b3·u·v + b4·u² + w, u = ln(d + 0,03), v = ln(1 − q + 0,02); d = Abstand in IB-Ranges,
// q = vergangene Restzeit, w = Zuschlag für den Wochentag
f_logit(int j, int o, float d, float q, float w) =>
    float u = math.log(math.max(d, 0.0) + 0.03)
    float v = math.log(1 - math.max(0.0, math.min(0.98, q)) + 0.02)
    1 / (1 + math.exp(-(f_c(j, o) + f_c(j, o + 1) * u + f_c(j, o + 2) * v + f_c(j, o + 3) * u * v + f_c(j, o + 4) * u * u + w)))

// P(Level wird noch erreicht | Größe c, Wochentag, Seite, Zeit q, Abstand d) – roh, vor Korrektur
f_g(int j, int c, int side, float q, float d) =>
    float w = wdI >= 0 and wdI <= 4 ? f_c(j, 42 + side * 5 + wdI) : 0.0
    array.get(HAS, j) ? f_logit(j, (((c == 0 ? 2 : c) - 1) * 2 + side) * 5, d, q, w) : na

// P(Rücklauf zum IB-Rand | Abstand d, Zeit q ab 09:30)
f_rt(int j, int side, float q, float d) =>
    array.get(HAS, j) and not na(f_c(j, 30 + side * 5)) ? f_logit(j, 30 + side * 5, d, q, 0.0) : na

// ═══ ZEIT & IB-GRÖSSE ═══
f_rel(int t) =>
    (hour(t, TZ) * 60 + minute(t, TZ) - 1080 + 1440) % 1440

f_relOf(string st) =>
    (int(str.tonumber(str.substring(st, 0, 2))) * 60 + int(str.tonumber(str.substring(st, 3, 5))) - 1080 + 1440) % 1440

int relS1  = f_relOf(startIn)
int relS2  = two ? f_relOf(start2In) : relS1
int rel930 = 930
int relNow = f_rel(time)
f_relS(int j) =>
    j < NI ? relS1 : relS2
f_relE(int j) =>
    f_relS(j) + f_len(j)
f_relEnd(int j) =>
    f_relS(j) < rel930 ? 1380 : 1320

// Median der IB-Range derselben Uhrzeit an den 20 Tagen davor (aus 15-Min-Kerzen, reicht weiter zurück)
f_ibMedian(int rs, int len) =>
    var array<float> hist = array.new<float>()
    var float h = na
    var float l = na
    if timeframe.change("D")
        h := na
        l := na
    float med = array.size(hist) >= 10 ? array.median(hist) : na
    int rn = f_rel(time)
    if rn >= rs and rn < rs + len
        h := na(h) ? high : math.max(h, high)
        l := na(l) ? low : math.min(l, low)
        if f_rel(time_close) == (rs + len) % 1440 and h > l
            array.push(hist, h - l)
            if array.size(hist) > 20
                array.shift(hist)
    med

float m10 = request.security(syminfo.tickerid, "15", f_ibMedian(relS1, 15))
float m11 = request.security(syminfo.tickerid, "15", f_ibMedian(relS1, 30))
float m12 = request.security(syminfo.tickerid, "15", f_ibMedian(relS1, 45))
float m13 = request.security(syminfo.tickerid, "15", f_ibMedian(relS1, 60))
float m20 = request.security(syminfo.tickerid, "15", f_ibMedian(relS2, 15))
float m21 = request.security(syminfo.tickerid, "15", f_ibMedian(relS2, 30))
float m22 = request.security(syminfo.tickerid, "15", f_ibMedian(relS2, 45))
float m23 = request.security(syminfo.tickerid, "15", f_ibMedian(relS2, 60))
f_med(int j) =>
    j == 0 ? m10 : j == 1 ? m11 : j == 2 ? m12 : j == 3 ? m13 : j == 4 ? m20 : j == 5 ? m21 : j == 6 ? m22 : m23

// ═══ TAGES-STATUS je IB ═══
var array<float> aH     = array.new<float>(NJ, na)
var array<float> aL     = array.new<float>(NJ, na)
var array<bool>  aDone  = array.new<bool>(NJ, false)
var array<int>   aUp    = array.new<int>(NJ, -1)
var array<int>   aDn    = array.new<int>(NJ, -1)
var array<int>   aCls   = array.new<int>(NJ, 0)
var array<int>   aRtS   = array.new<int>(NJ, -1)     // Eröffnung 09:30: 0 über IB-Hoch, 1 unter IB-Tief, -1 in der IB
var array<bool>  aRtSet = array.new<bool>(NJ, false)
var array<bool>  aRtHit = array.new<bool>(NJ, false)
var array<line>  IBL    = array.new<line>(NJ * 2)
// Tagesplan (max. 4): Linie, Text, Preis, Richtung (1 über / −1 unter dem Kurs), Art (1 TP, 2 Protected), Tagesende, erledigt
var array<line>   PL = array.new<line>()
var array<label>  PB = array.new<label>()
var array<float>  PY = array.new<float>()
var array<int>    PD = array.new<int>()
var array<int>    PT = array.new<int>()
var array<int>    PE = array.new<int>()
var array<bool>   PH = array.new<bool>()
var array<string> PX = array.new<string>()
var bool planSet = false

if timeframe.isintraday and timeframe.change("D")
    if delOld
        for ln in PL
            line.delete(ln)
        for lb in PB
            label.delete(lb)
        for ln in IBL
            line.delete(ln)
    array.clear(PL)
    array.clear(PB)
    array.clear(PY)
    array.clear(PD)
    array.clear(PT)
    array.clear(PE)
    array.clear(PH)
    array.clear(PX)
    planSet := false
    for j = 0 to NJ - 1
        array.set(aH, j, na)
        array.set(aL, j, na)
        array.set(IBL, j * 2, na)
        array.set(IBL, j * 2 + 1, na)
    array.fill(aDone, false)
    array.fill(aUp, -1)
    array.fill(aDn, -1)
    array.fill(aRtS, -1)
    array.fill(aRtSet, false)
    array.fill(aRtHit, false)

f_R(int j) =>
    array.get(aH, j) - array.get(aL, j)

f_price(int j, int side, int k) =>
    side == 0 ? array.get(aH, j) + k * 0.1 * f_R(j) : array.get(aL, j) - k * 0.1 * f_R(j)

for j = 0 to NJ - 1
    // IB aufbauen
    if relNow >= f_relS(j) and relNow < f_relE(j)
        array.set(aH, j, na(array.get(aH, j)) ? high : math.max(array.get(aH, j), high))
        array.set(aL, j, na(array.get(aL, j)) ? low : math.min(array.get(aL, j), low))
    // IB fertig: Größenklasse ggü. den 20 Tagen davor
    float R = f_R(j)
    if f_on(j) and mk != "" and not array.get(aDone, j) and not na(R) and R > 0 and relNow >= f_relE(j) and relNow < f_relEnd(j) and array.get(HAS, j)
        array.set(aDone, j, true)
        float med = f_med(j)
        float rs  = na(med) or med <= 0 ? na : R / med
        array.set(aCls, j, na(rs) ? 0 : rs <= f_c(j, 40) ? 1 : rs >= f_c(j, 41) ? 3 : 2)
        if showIB
            array.set(IBL, j * 2, line.new(time, array.get(aH, j), time, array.get(aH, j), xloc = xloc.bar_time, color = color.new(cIB, 50)))
            array.set(IBL, j * 2 + 1, line.new(time, array.get(aL, j), time, array.get(aL, j), xloc = xloc.bar_time, color = color.new(cIB, 50)))
    if array.get(aDone, j) and relNow < f_relEnd(j) and showIB
        line.set_x2(array.get(IBL, j * 2), time)
        line.set_x2(array.get(IBL, j * 2 + 1), time)
    // erreichte Levels (bis jetzt inkl. dieses Bars)
    if array.get(aDone, j) and relNow < f_relEnd(j)
        int u = array.get(aUp, j)
        while u < NK - 1 and (u < 0 ? high > array.get(aH, j) : high >= f_price(j, 0, u + 1))
            u += 1
        array.set(aUp, j, u)
        int d = array.get(aDn, j)
        while d < NK - 1 and (d < 0 ? low < array.get(aL, j) : low <= f_price(j, 1, d + 1))
            d += 1
        array.set(aDn, j, d)
    // IB-Rand: Lage der 09:30-Eröffnung und ob der Rand seitdem berührt wurde
    if array.get(aDone, j) and f_relE(j) <= rel930 and relNow >= rel930 and relNow < f_relEnd(j)
        if not array.get(aRtSet, j)
            array.set(aRtSet, j, true)
            array.set(aRtS, j, open > array.get(aH, j) ? 0 : open < array.get(aL, j) ? 1 : -1)
        int sd = array.get(aRtS, j)
        if sd == 0 ? low <= array.get(aH, j) : sd == 1 ? high >= array.get(aL, j) : false
            array.set(aRtHit, j, true)

f_q(int j) =>
    (relNow - f_relE(j) + 1) / float(f_relEnd(j) - f_relE(j))

f_pct(float p) =>
    str.tostring(math.round(p * 100)) + "%"

f_size() =>
    txtSize == "Klein" ? size.small : txtSize == "Groß" ? size.large : size.normal

// ═══ TAGESPLAN: einmal, sobald alle eingeschalteten IBs fertig sind ═══
bool ready   = not planSet and mk != "" and timeframe.isintraday
bool anyDone = false
for j = 0 to NJ - 1
    if f_on(j) and array.get(HAS, j) and relNow < f_relE(j)
        ready := false
    if array.get(aDone, j) and relNow < f_relEnd(j)
        anyDone := true

string msg = ""
if ready and anyDone
    planSet := true
    // Plätze: 0 TP oben, 1 TP unten, 2 Protected oben, 3 Protected unten
    array<float>  cY = array.new<float>(4, na)
    array<float>  cP = array.new<float>(4, na)
    array<int>    cE = array.new<int>(4, na)
    array<string> cT = array.new<string>(4, "")
    // 1) Protected: je Seite das nächste Level, das mit ≥ Schwelle hält (über alle IBs)
    // 2) TP: je Seite das weiteste Level mit ≥ Schwelle, das noch VOR dem Protected dieser Seite liegt
    for pass = 0 to 1
        for j = 0 to NJ - 1
            if array.get(aDone, j) and relNow < f_relEnd(j)
                float q = f_q(j)
                for side = 0 to 1
                    int nowMax = side == 0 ? array.get(aUp, j) : array.get(aDn, j)
                    if nowMax < NK - 1
                        for k = nowMax + 1 to NK - 1
                            float lv = f_price(j, side, k)
                            float p  = f_g(j, array.get(aCls, j), side, q, side == 0 ? (lv - close) / f_R(j) : (close - lv) / f_R(j))
                            float pr = array.get(cY, 2 + side)
                            if pass == 0
                                float pS = 1 - p - f_corr(DP, q) - array.get(DPL, f_ki(j))      // Protected: Sicherheit hält (korrigiert)
                                if not na(p) and p < 0.5 and pS >= thrSL / 100.0 and (na(pr) or (side == 0 ? lv < pr : lv > pr))
                                    array.set(cY, 2 + side, lv)
                                    array.set(cP, 2 + side, pS)
                                    array.set(cE, 2 + side, f_relEnd(j))
                                    array.set(cT, 2 + side, f_tag(j))
                            else
                                float pT = p - f_corr(DT, q)          // TP: Sicherheit erreicht (korrigiert); letzte 10 % der Zeit gesperrt
                                float ct = array.get(cY, side)
                                bool  ok = not na(p) and p >= 0.5 and pT >= thrTP / 100.0 and q < 0.9
                                if ok and (na(pr) or (side == 0 ? lv < pr : lv > pr)) and (na(ct) or (side == 0 ? lv > ct : lv < ct))
                                    array.set(cY, side, lv)
                                    array.set(cP, side, pT)
                                    array.set(cE, side, f_relEnd(j))
                                    array.set(cT, side, f_tag(j))
    // IB-Rand: Eröffnung außerhalb der IB, Rand noch nicht berührt → füllt einen freien TP-Platz (vor dem Protected)
    for j = 0 to NJ - 1
        int sd = array.get(aRtS, j)
        if array.get(aDone, j) and f_relE(j) <= rel930 and relNow >= rel930 and relNow < f_relEnd(j) and sd >= 0 and not array.get(aRtHit, j)
            float H    = array.get(aH, j)
            float L    = array.get(aL, j)
            float qR   = (relNow - rel930 + 1) / float(f_relEnd(j) - rel930)
            float p    = f_rt(j, sd, qR, sd == 0 ? (close - H) / f_R(j) : (L - close) / f_R(j)) - f_corr(DR, qR)
            int   slot = sd == 0 ? 1 : 0
            float lv   = sd == 0 ? H : L
            float pr   = array.get(cY, 2 + slot)
            if not na(p) and p >= thrTP / 100.0 and qR < 0.1 and na(array.get(cY, slot)) and (na(pr) or (slot == 0 ? lv < pr : lv > pr))
                array.set(cY, slot, lv)
                array.set(cP, slot, p)
                array.set(cE, slot, f_relEnd(j))
                array.set(cT, slot, f_tag(j) + " IB-Rand")
    for i = 0 to 3
        float y = array.get(cY, i)
        if not na(y)
            color  c = i < 2 ? cTPc : cSLc
            string t = (i < 2 ? "TP " : "Protected ") + f_pct(array.get(cP, i)) + " · " + array.get(cT, i)
            array.push(PL, line.new(time, y, time, y, xloc = xloc.bar_time, color = c, width = 2))
            array.push(PB, label.new(time, y, t, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(c, 100), textcolor = c, size = f_size()))
            array.push(PY, y)
            array.push(PD, y > close ? 1 : -1)
            array.push(PT, i < 2 ? 1 : 2)
            array.push(PE, array.get(cE, i))
            array.push(PH, false)
            array.push(PX, t)
            msg += t + " @ " + str.tostring(y, format.mintick) + "\n"
    if alPlan and msg != ""
        alert("IB-Exp " + mk + " · Tagesplan\n" + msg, alert.freq_once_per_bar)

// Linien laufen bis zur Berührung oder Tagesende
string msgHit = ""
for i = 0 to math.max(array.size(PL) - 1, 0)
    if array.size(PL) > 0 and not array.get(PH, i) and relNow < array.get(PE, i)
        line.set_x2(array.get(PL, i), time)
        label.set_x(array.get(PB, i), time)
        if array.get(PD, i) == 1 ? high >= array.get(PY, i) : low <= array.get(PY, i)
            array.set(PH, i, true)
            string t = array.get(PX, i) + (array.get(PT, i) == 1 ? " ✓" : " ✗")
            label.set_text(array.get(PB, i), t)
            msgHit += t + "\n"
if alHit and msgHit != ""
    alert("IB-Exp " + mk + "\n" + msgHit, alert.freq_once_per_bar)
