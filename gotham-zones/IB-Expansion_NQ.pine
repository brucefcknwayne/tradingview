//@version=6
indicator("IB Expansion NQ · Targets & Protects", shorttitle = "IB-Exp NQ", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ─────────────────────────────────────────────────────────────────────────────
//  🦇  IB EXPANSION NQ  ·  by @Brucefcknwayne
//
//  Levels ±0,1 … ±3,0 IB-Range über/unter der Initial Balance (jede volle Stunde +
//  08:30/09:30/10:30, Länge 15/30/45/60 Min). Gezeigt wird NUR, was mindestens 70 % hat:
//    Target  (blau)            = wird bis Tagesende zu ≥ 70 % erreicht
//    Protect (orange, gestr.)  = wird zu ≥ 70 % NICHT erreicht → Stop dahinter
//    Rücklauf (grün)           = nur IBs bis 09:30: Eröffnung 09:30 außerhalb der IB →
//                                IB-Rand wird zu ≥ 70 % noch einmal berührt
//  Wahrscheinlichkeiten aus den Daten (Databento CME 1m, letzte 3 Jahre bis 2026-10-16):
//    · IB-Größe: klein / normal / groß im Vergleich zu den 20 Tagen davor (gleiche Uhrzeit)
//    · bei IB-Ende: zusätzlich ob IB-Hoch oder IB-Tief zuerst gebildet wurde
//    · danach live: Abstand des Levels zum aktuellen Kurs + verbleibende Zeit
//  Jede Linie läuft mit, bis das Level erreicht ist oder der Tag endet.
//  Tagesende: 17:00 NY für IBs vor 09:30, sonst 16:00. Für 1m–5m-Charts.
//  Korrektur: Was die Statistik im letzten Jahr zu optimistisch war, wird je Uhrzeit-Stufe abgezogen.
//  Getestet auf dem letzten Jahr (ungesehen): data-lab/results/ib_ext_stats.md
// ─────────────────────────────────────────────────────────────────────────────

const string TZ    = "America/New_York"
const string ALPHA = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
const int    NK    = 31     // Level 0 … 30 (0,0 … 3,0 IB)
const int    O_G   = 744    // Start Tabelle G
const int    O_RT  = 2244   // Start Tabelle Rücklauf
const int    N_ALL = 2544
const string G_I   = "Initial Balance"
const string G_S   = "Schwellen"
const string G_A   = "Anzeige"

// ═══════════════════════════════ INPUTS ═══════════════════════════════
string startIn = input.string("09:30", "IB-Start (NY)", options = ["18:00", "19:00", "20:00", "21:00", "22:00", "23:00", "00:00", "01:00", "02:00", "03:00", "04:00", "05:00", "06:00", "07:00", "08:00", "08:30", "09:00", "09:30", "10:00", "10:30", "11:00", "12:00", "13:00", "14:00", "15:00"], group = G_I)
int    lenIn   = input.int(30, "IB-Länge (Min)", options = [15, 30, 45, 60], group = G_I)
int    thrTP   = input.int(70, "Target ab (% erreicht)", minval = 50, maxval = 95, group = G_S)
int    thrSL   = input.int(70, "Protect ab (% hält)", minval = 50, maxval = 95, group = G_S)
int    thrRT   = input.int(70, "Rücklauf ab (%)", minval = 50, maxval = 95, group = G_S)
string lblMode = input.string("Grenzen", "Beschriftung", options = ["Grenzen", "Alle Levels"], group = G_A, tooltip = "Grenzen: weitestes Target und erstes Protect je Seite.")
bool   showIB  = input.bool(true, "IB-Hoch/-Tief immer zeigen", group = G_A, tooltip = "Als dünne Orientierung, auch unter der Schwelle.")
bool   showTab = input.bool(true, "Info-Tabelle", group = G_A)
color  cTP     = input.color(#2962ff, "Target", inline = "c", group = G_A)
color  cSL     = input.color(#ff9800, "Protect", inline = "c", group = G_A)
color  cRT     = input.color(#00c853, "Rücklauf", inline = "c", group = G_A)
color  cIB     = input.color(#e535f5, "IB", inline = "c", group = G_A)

// ═══════════════════════════════ DATEN ═══════════════════════════════
string root = syminfo.root
string mk   = root == "NQ" or root == "MNQ" ? "NQ" : root == "ES" or root == "MES" ? "ES" : root == "RTY" or root == "M2K" ? "RTY" : root == "GC" or root == "MGC" ? "GC" : ""
string wkey = str.replace(startIn, ":", "") + "-" + str.tostring(lenIn)

var string DATA = ""
if barstate.isfirst and mk == "NQ" and wkey == "1800-15"
