//@version=6
indicator("IB Expansion RTY · TP & geschützte Level", shorttitle = "IB-Exp RTY", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ─────────────────────────────────────────────────────────────────────────────
//  🦇  IB EXPANSION  ·  by @Brucefcknwayne
//
//  Levels ±0,1 … ±1,5 IB-Range über/unter der Initial Balance (jede volle Stunde +
//  08:30/09:30/10:30, Länge 15/30/45/60 Min). Jedes Level bekommt die Wahrscheinlichkeit,
//  bis Tagesende erreicht zu werden – live aktualisiert:
//    · bei IB-Ende: je Wochentag und ob IB-Hoch oder IB-Tief zuerst gebildet wurde
//    · danach: gemessen aus den Daten (letzte 3 Jahre), wie oft ein Level noch erreicht wird, wenn es
//      d IB-Ranges vom aktuellen Kurs entfernt ist und noch so viel Zeit übrig ist
//      (Bruch einer Seite, Rücklauf, späte Uhrzeit – alles steckt in Abstand + Zeit)
//  Getestet auf dem letzten Jahr (ungesehen): „TP ≥ 70 %“ wurde zu 71–82 % erreicht,
//  „geschützt“ nur zu 6–17 % (data-lab/results/ib_ext_stats.md).
//  TP-Level      = Wahrscheinlichkeit erreicht ≥ Schwelle (Standard 70 %)
//  Geschützt     = Wahrscheinlichkeit NICHT erreicht ≥ Schwelle → Stop dahinter
//  Alles unter der Schwelle wird nicht gezeigt. Jede Linie läuft mit, bis das Level
//  gebrochen ist oder der Tag endet, und bleibt dann stehen.
//  "gültig bis"  = ab dieser Uhrzeit fällt das TP-Level unter die Schwelle, falls bis dahin nichts passiert
//  Tagesende: 17:00 NY für IBs vor 09:30, sonst 16:00.
//
//  Eigenständige Version nur für RTY (Daten im Skript, nichts zu veröffentlichen).
//  Statistik: Databento CME 1m, letzte 3 Jahre bis 2026-10-16.
// ─────────────────────────────────────────────────────────────────────────────


const string TZ    = "America/New_York"
const string ALPHA = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
const string G_I   = "Initial Balance"
const string G_S   = "Schwellen"
const string G_A   = "Anzeige"

// ═══════════════════════════════ INPUTS ═══════════════════════════════
string startIn = input.string("09:30", "IB-Start (NY)", options = ["18:00", "19:00", "20:00", "21:00", "22:00", "23:00", "00:00", "01:00", "02:00", "03:00", "04:00", "05:00", "06:00", "07:00", "08:00", "08:30", "09:00", "09:30", "10:00", "10:30", "11:00", "12:00", "13:00", "14:00", "15:00"], group = G_I)
int    lenIn   = input.int(30, "IB-Länge (Min)", options = [15, 30, 45, 60], group = G_I)
bool   useWd   = input.bool(true, "Wochentag berücksichtigen", group = G_I, tooltip = "Bei IB-Ende die Statistik des heutigen Wochentags nutzen (sonst alle Tage).")
int    thrTP   = input.int(70, "TP-Level ab (% erreicht)", minval = 50, maxval = 95, group = G_S)
int    thrSL   = input.int(70, "Geschützt ab (% nicht erreicht)", minval = 50, maxval = 95, group = G_S)
string lblMode = input.string("Grenzen", "Beschriftung", options = ["Grenzen", "Alle Levels"], group = G_A, tooltip = "Grenzen: weitestes TP-Level und erstes geschütztes Level je Seite.")
bool   showIB  = input.bool(true, "IB-Hoch/-Tief immer zeigen", group = G_A, tooltip = "Als dünne Orientierung, auch wenn sie unter der Schwelle liegen.")
bool   showTab = input.bool(true, "Info-Tabelle", group = G_A)
color  cTP     = input.color(#2962ff, "TP", inline = "c", group = G_A)
color  cSL     = input.color(#ff9800, "Geschützt", inline = "c", group = G_A)
color  cIB     = input.color(#e535f5, "IB", inline = "c", group = G_A)
color  cNeu    = input.color(#787b86, "Neutral", inline = "c", group = G_A)

// ═══════════════════════════════ DATEN ═══════════════════════════════
string root = syminfo.root
string mk   = root == "NQ" or root == "MNQ" ? "NQ" : root == "ES" or root == "MES" ? "ES" : root == "RTY" or root == "M2K" ? "RTY" : root == "GC" or root == "MGC" ? "GC" : ""
string wkey = str.replace(startIn, ":", "") + "-" + str.tostring(lenIn)

var string DATA = ""
