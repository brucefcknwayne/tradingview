COR := barstate.isfirst and mk == "GC" ? "W9WFW9VyVwVoWIXZZ2Z2VQVLVJVKVMVOVKVDV8V1V6VZXVWuVuYSWKZ2Z2Z2" : COR
f_blk(int b) =>
    b == 0 ? B0 : b == 1 ? B1 : B2

f_dec(string s, int p, float sc) =>
    int c1 = str.pos(ALPHA, str.substring(s, p, p + 1))
    int c2 = str.pos(ALPHA, str.substring(s, p + 1, p + 2))
    c1 >= 0 and c2 >= 0 ? (c1 * 62 + c2 - 1922) / sc : na

var array<float> CF  = array.new<float>(NJ * NC, na)
var array<bool>  HAS = array.new<bool>(NJ, false)
var array<float> DT  = array.new<float>(10, 0.0)    // Korrektur je Zeitstufe (0 … 90 % der Restzeit): Target, Protect, Rücklauf
var array<float> DP  = array.new<float>(10, 0.0)
var array<float> DR  = array.new<float>(10, 0.0)
if barstate.isfirst
    for s = 0 to 1
        int    ki  = s == 0 or two ? int(str.pos(KEYS, s == 0 ? startIn : start2In) / 6) : -1
        string src = ki >= 0 ? f_blk(int(ki / KPB)) : ""
        int    p0  = (math.max(ki, 0) % KPB) * NI * NC * 2
        if ki >= 0 and str.length(src) >= p0 + NI * NC * 2
            for l = 0 to NI - 1
                int  j  = s * NI + l
                bool ok = true
                for i = 0 to NC - 1
                    float x = f_dec(src, p0 + (l * NC + i) * 2, 100.0)
                    array.set(CF, j * NC + i, x)
                    if na(x) and (i < 30 or i >= 40)
                        ok := false
                array.set(HAS, j, ok)
if barstate.isfirst and str.length(COR) == 60
    for i = 0 to 9
        array.set(DT, i, f_dec(COR, i * 2, 1000.0))
        array.set(DP, i, f_dec(COR, 20 + i * 2, 1000.0))
        array.set(DR, i, f_dec(COR, 40 + i * 2, 1000.0))

f_c(int j, int i) =>
    array.get(CF, j * NC + i)

f_corr(array<float> a, float q) =>
    float qq = math.max(0.0, math.min(1.0, q)) * 10
    int   i0 = math.min(int(math.floor(qq)), 9)
    float x0 = array.get(a, i0)
    x0 + (array.get(a, math.min(i0 + 1, 9)) - x0) * math.min(qq - i0, 1.0)

// Wochentag des Handelstags (Sitzung ab 18:00 zählt zum nächsten Tag): 0 = Mo … 4 = Fr
int wdI = dayofweek(time_tradingday, "UTC") - dayofweek.monday

// logit p = b0 + b1·u + b2·v + b3·u·v + b4·u² + w, u = ln(d + 0,03), v = ln(1 − q + 0,02); d = Abstand in IB-Ranges,
// q = vergangene Restzeit, w = Zuschlag für den Wochentag
f_logit(int j, int o, float d, float q, float w) =>
    float u = math.log(math.max(d, 0.0) + 0.03)
    float v = math.log(1 - math.max(0.0, math.min(0.98, q)) + 0.02)
    1 / (1 + math.exp(-(f_c(j, o) + f_c(j, o + 1) * u + f_c(j, o + 2) * v + f_c(j, o + 3) * u * v + f_c(j, o + 4) * u * u + w)))

// P(Level wird noch erreicht | Größe c, Wochentag, Seite, Zeit q, Abstand d) – roh, vor Korrektur
f_g(int j, int c, int side, float q, float d) =>
    float w = wdI >= 0 and wdI <= 4 ? f_c(j, 42 + side * 5 + wdI) : 0.0
    array.get(HAS, j) ? f_logit(j, (((c == 0 ? 2 : c) - 1) * 2 + side) * 5, d, q, w) : na

// P(Rücklauf zum IB-Rand | Abstand d, Zeit q ab 09:30)
f_rt(int j, int side, float q, float d) =>
    array.get(HAS, j) and not na(f_c(j, 30 + side * 5)) ? f_logit(j, 30 + side * 5, d, q, 0.0) : na

// ═══ ZEIT & IB-GRÖSSE ═══
f_rel(int t) =>
    (hour(t, TZ) * 60 + minute(t, TZ) - 1080 + 1440) % 1440

f_relOf(string st) =>
    (int(str.tonumber(str.substring(st, 0, 2))) * 60 + int(str.tonumber(str.substring(st, 3, 5))) - 1080 + 1440) % 1440

int relS1  = f_relOf(startIn)
int relS2  = two ? f_relOf(start2In) : relS1
int rel930 = 930
int relNow = f_rel(time)
f_relS(int j) =>
    j < NI ? relS1 : relS2
f_relE(int j) =>
    f_relS(j) + f_len(j)
f_relEnd(int j) =>
    f_relS(j) < rel930 ? 1380 : 1320

// Median der IB-Range derselben Uhrzeit an den 20 Tagen davor (aus 15-Min-Kerzen, reicht weiter zurück)
f_ibMedian(int rs, int len) =>
    var array<float> hist = array.new<float>()
    var float h = na
    var float l = na
    if timeframe.change("D")
        h := na
        l := na
    float med = array.size(hist) >= 10 ? array.median(hist) : na
    int rn = f_rel(time)
    if rn >= rs and rn < rs + len
        h := na(h) ? high : math.max(h, high)
        l := na(l) ? low : math.min(l, low)
        if f_rel(time_close) == (rs + len) % 1440 and h > l
            array.push(hist, h - l)
            if array.size(hist) > 20
                array.shift(hist)
    med

float m10 = request.security(syminfo.tickerid, "15", f_ibMedian(relS1, 15))
float m11 = request.security(syminfo.tickerid, "15", f_ibMedian(relS1, 30))
float m12 = request.security(syminfo.tickerid, "15", f_ibMedian(relS1, 45))
float m13 = request.security(syminfo.tickerid, "15", f_ibMedian(relS1, 60))
float m20 = request.security(syminfo.tickerid, "15", f_ibMedian(relS2, 15))
float m21 = request.security(syminfo.tickerid, "15", f_ibMedian(relS2, 30))
float m22 = request.security(syminfo.tickerid, "15", f_ibMedian(relS2, 45))
float m23 = request.security(syminfo.tickerid, "15", f_ibMedian(relS2, 60))
f_med(int j) =>
    j == 0 ? m10 : j == 1 ? m11 : j == 2 ? m12 : j == 3 ? m13 : j == 4 ? m20 : j == 5 ? m21 : j == 6 ? m22 : m23

// ═══ TAGES-STATUS je IB ═══
var array<float> aH     = array.new<float>(NJ, na)
var array<float> aL     = array.new<float>(NJ, na)
var array<int>   aTH    = array.new<int>(NJ, na)
var array<int>   aTL    = array.new<int>(NJ, na)
var array<bool>  aDone  = array.new<bool>(NJ, false)
var array<int>   aUp    = array.new<int>(NJ, -1)
var array<int>   aDn    = array.new<int>(NJ, -1)
var array<int>   aFF    = array.new<int>(NJ, 0)
var array<int>   aCls   = array.new<int>(NJ, 0)
var array<float> aRsz   = array.new<float>(NJ, na)
var array<int>   aTIB   = array.new<int>(NJ, na)
var array<int>   aTEnd  = array.new<int>(NJ, na)
var array<int>   aRtS   = array.new<int>(NJ, -1)
var array<bool>  aRtHit = array.new<bool>(NJ, false)
var array<bool>  aRtSet = array.new<bool>(NJ, false)
var array<line>  aRtLn  = array.new<line>(NJ)
var array<bool>  aRtAct = array.new<bool>(NJ, false)
var array<float> aRtP   = array.new<float>(NJ, na)
var array<line>  LU     = array.new<line>(NJ * NK)
var array<line>  LD     = array.new<line>(NJ * NK)
var array<label> LB     = array.new<label>()
// Level-Status je IB, Seite, Level: Art (0 nichts, 1 Target, 2 Protect; bleibt bis Tagesende), getroffen, % beim Erscheinen, Linie sichtbar
var array<int>   ST     = array.new<int>(NJ * 2 * NK, 0)
var array<bool>  SH     = array.new<bool>(NJ * 2 * NK, false)
var array<float> SP     = array.new<float>(NJ * 2 * NK, na)
var array<bool>  SV     = array.new<bool>(NJ * 2 * NK, false)

f_si(int j, int side, int k) =>
    (j * 2 + side) * NK + k

f_clearLB() =>
    for lb in LB
        label.delete(lb)
    array.clear(LB)

if timeframe.isintraday and timeframe.change("D")
    for j = 0 to NJ - 1
        array.set(aH, j, na)
        array.set(aL, j, na)
        array.set(aTH, j, na)
        array.set(aTL, j, na)
        if delOld
            line.delete(array.get(aRtLn, j))
        array.set(aRtLn, j, na)
        for k = 0 to NK - 1
            if delOld
                line.delete(array.get(LU, j * NK + k))
                line.delete(array.get(LD, j * NK + k))
            array.set(LU, j * NK + k, na)
            array.set(LD, j * NK + k, na)
    array.fill(aDone, false)
    array.fill(aUp, -1)
    array.fill(aDn, -1)
    array.fill(aRtS, -1)
    array.fill(aRtHit, false)
    array.fill(aRtSet, false)
    array.fill(aRtAct, false)
    array.fill(aRtP, na)
    array.fill(ST, 0)
    array.fill(SH, false)
    array.fill(SP, na)
    array.fill(SV, false)
    f_clearLB()

f_R(int j) =>
    array.get(aH, j) - array.get(aL, j)

f_price(int j, int side, int k) =>
    side == 0 ? array.get(aH, j) + k * 0.1 * f_R(j) : array.get(aL, j) - k * 0.1 * f_R(j)

for j = 0 to NJ - 1
    // IB aufbauen (erstes Auftreten von Hoch/Tief zählt)
    if relNow >= f_relS(j) and relNow < f_relE(j)
        if na(array.get(aH, j)) or high > array.get(aH, j)
            array.set(aH, j, high)
            array.set(aTH, j, time)
        if na(array.get(aL, j)) or low < array.get(aL, j)
            array.set(aL, j, low)
            array.set(aTL, j, time)
    // IB fertig
    float R = f_R(j)
    if f_on(j) and mk != "" and not array.get(aDone, j) and not na(R) and R > 0 and relNow >= f_relE(j) and relNow < f_relEnd(j) and array.get(HAS, j)
        array.set(aDone, j, true)
        array.set(aTIB, j, time)
        array.set(aTEnd, j, time + (f_relEnd(j) - relNow) * 60000)
        array.set(aFF, j, array.get(aTH, j) < array.get(aTL, j) ? 1 : array.get(aTL, j) < array.get(aTH, j) ? 2 : 0)
        float med = f_med(j)
        float rs  = na(med) or med <= 0 ? na : R / med
        array.set(aRsz, j, rs)
        array.set(aCls, j, na(rs) ? 0 : rs <= f_c(j, 40) ? 1 : rs >= f_c(j, 41) ? 3 : 2)
        if showIB
            array.set(LU, j * NK, line.new(time, array.get(aH, j), time, array.get(aH, j), xloc = xloc.bar_time, color = color.new(f_cI(j), 40)))
            array.set(LD, j * NK, line.new(time, array.get(aL, j), time, array.get(aL, j), xloc = xloc.bar_time, color = color.new(f_cI(j), 40)))

// erreichte Levels (Stand vor diesem Bar merken: was jetzt getroffen wird, endet auf diesem Bar)
array<int> upPrev = array.copy(aUp)
array<int> dnPrev = array.copy(aDn)
for j = 0 to NJ - 1
    if array.get(aDone, j) and relNow < f_relEnd(j)
        int u = array.get(aUp, j)
        while u < NK - 1 and (u < 0 ? high > array.get(aH, j) : high >= f_price(j, 0, u + 1))
            u += 1
        array.set(aUp, j, u)
        int d = array.get(aDn, j)
        while d < NK - 1 and (d < 0 ? low < array.get(aL, j) : low <= f_price(j, 1, d + 1))
            d += 1
        array.set(aDn, j, d)

// ═══ WAHRSCHEINLICHKEIT & HILFEN ═══
f_q(int j) =>
    (relNow - f_relE(j) + 1) / float(f_relEnd(j) - f_relE(j))

f_dist(int j, int side, int k) =>
    side == 0 ? (f_price(j, 0, k) - close) / f_R(j) : (close - f_price(j, 1, k)) / f_R(j)

f_fmt(int k) =>
    str.replace(str.tostring(k / 10.0, "0.0"), ".", ",")

f_pct(float p) =>
    str.tostring(math.round(p * 100)) + " %"

f_lbl(int x, float y, string t, color c, bool big) =>
    array.push(LB, label.new(x, y, t, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(c, big ? 80 : 100), textcolor = c, size = big ? size.small : size.tiny))

// Uhrzeit, ab der ein Target unter die Schwelle fällt (wenn der Kurs bis dahin hier bleibt)
f_valid(int j, int side, int k) =>
    string out = "Tagesende"
    float  d   = f_dist(j, side, k)
    float  q   = f_q(j)
    while q <= 1.0
        if f_g(j, array.get(aCls, j), side, q, d) - f_corr(DT, q) < thrTP / 100.0
            out := str.format_time(int(array.get(aTIB, j) + q * (array.get(aTEnd, j) - array.get(aTIB, j))), "HH:mm", TZ)
            break
        q += 0.02
    out

// ═══ LINIEN & BESCHRIFTUNG ═══
bool   drawLbl = barstate.islast
int    xLbl    = time + 3 * timeframe.in_seconds() * 1000
string msgHit  = ""
string msgNew  = ""
if drawLbl
    f_clearLB()

for j = 0 to NJ - 1
    if array.get(aDone, j) and relNow < f_relEnd(j)
        string tag = f_tag(j) + " "
        float  q   = f_q(j)
        for side = 0 to 1
            int    reached = side == 0 ? array.get(upPrev, j) : array.get(dnPrev, j)
            int    nowMax  = side == 0 ? array.get(aUp, j) : array.get(aDn, j)
            string sg      = side == 0 ? "+" : "−"
            int    bestTP  = -1
            int    firstSL = -1
            for k = 0 to NK - 1
                int  ix  = j * NK + k
                int  si  = f_si(j, side, k)
                int  typ = array.get(ST, si)
                line ln  = side == 0 ? array.get(LU, ix) : array.get(LD, ix)
                // läuft weiter, bis getroffen (dieser Bar ist dann der letzte) oder Tagesende
                if k > reached and not na(ln)
                    line.set_x2(ln, time)
                if k > reached and k <= nowMax and typ > 0
                    array.set(SH, si, true)
                    msgHit += tag + (typ == 1 ? "Target " : "Protect ") + sg + f_fmt(k) + " IB" + (typ == 1 ? " getroffen ✓" : " gebrochen ✗") + "\n"
                // noch nicht eingestuft: erreicht es jetzt die Schwelle, bleibt die Einstufung bis Treffer oder Tagesende
                if k > nowMax and typ == 0
                    float p  = f_g(j, array.get(aCls, j), side, q, f_dist(j, side, k))
                    float pT = p - f_corr(DT, q)          // Target: Sicherheit erreicht (korrigiert)
                    float pS = 1 - p - f_corr(DP, q)      // Protect: Sicherheit hält (korrigiert)
                    bool  tp = not na(p) and p >= 0.5 and pT >= thrTP / 100.0 and q < 0.9   // letzte 10 % der Zeit: Targets unzuverlässig
                    bool  sl = not na(p) and p < 0.5 and pS >= thrSL / 100.0
                    if tp or sl
                        typ := tp ? 1 : 2
                        array.set(ST, si, typ)
                        array.set(SP, si, tp ? pT : pS)
                        msgNew += tag + (tp ? "Target " : "Protect ") + sg + f_fmt(k) + " IB · " + f_pct(tp ? pT : pS) + "\n"
                if k > nowMax and typ == 1
                    bestTP := k
                if k > nowMax and typ == 2 and firstSL < 0
                    firstSL := k
                if drawLbl and lblMode == "Alle Levels" and k > nowMax and typ > 0
                    f_lbl(xLbl, f_price(j, side, k), tag + sg + f_fmt(k) + " · " + f_pct(array.get(SP, si)), typ == 1 ? f_cT(j) : f_cS(j), false)
            // Linien: offene Levels nur zeigen, wenn Grenze (oder „Alle Levels“); getroffene behalten ihren letzten Zustand
            if nowMax < NK - 1
                for k = nowMax + 1 to NK - 1
                    int  si  = f_si(j, side, k)
                    int  typ = array.get(ST, si)
                    bool vis = typ > 0 and (lblMode == "Alle Levels" or k == bestTP or k == firstSL)
                    if typ > 0 and vis != array.get(SV, si)
                        array.set(SV, si, vis)
                        int  ix = j * NK + k
                        line ln = side == 0 ? array.get(LU, ix) : array.get(LD, ix)
                        if na(ln) and vis
                            ln := line.new(time, f_price(j, side, k), time, f_price(j, side, k), xloc = xloc.bar_time)
                            array.set(side == 0 ? LU : LD, ix, ln)
                        if not na(ln)
                            line.set_color(ln, vis ? (typ == 1 ? f_cT(j) : f_cS(j)) : k == 0 and showIB ? color.new(f_cI(j), 40) : color.new(f_cI(j), 100))
                            line.set_style(ln, vis and typ == 2 ? line.style_dashed : line.style_solid)
                            line.set_width(ln, vis and k == 0 ? 2 : 1)
            if drawLbl and lblMode == "Grenzen" and bestTP >= 0
                f_lbl(xLbl, f_price(j, side, bestTP), tag + "Target " + sg + f_fmt(bestTP) + " IB · " + f_pct(array.get(SP, f_si(j, side, bestTP))) + " · gültig bis " + f_valid(j, side, bestTP), f_cT(j), true)
            if drawLbl and lblMode == "Grenzen" and firstSL >= 0
                f_lbl(xLbl, f_price(j, side, firstSL), tag + "Protect " + sg + f_fmt(firstSL) + " IB · " + f_pct(array.get(SP, f_si(j, side, firstSL))) + " hält", f_cS(j), true)

// ═══ TARGET ZURÜCK ZUR IB: nur IBs fertig bis 09:30, Eröffnung über IB-Hoch / unter IB-Tief ═══
for j = 0 to NJ - 1
    if array.get(aDone, j) and f_relE(j) <= rel930 and relNow >= rel930 and relNow < f_relEnd(j)
        float H = array.get(aH, j)
        float L = array.get(aL, j)
        if not array.get(aRtSet, j)
            array.set(aRtSet, j, true)
            int s0 = open > H ? 0 : open < L ? 1 : -1
            array.set(aRtS, j, s0)
            if s0 >= 0
                array.set(aRtLn, j, line.new(time, s0 == 0 ? H : L, time, s0 == 0 ? H : L, xloc = xloc.bar_time, color = color.new(f_cT(j), 100), width = 2))
        int    sd = array.get(aRtS, j)
        string nm = f_tag(j) + " Target " + (sd == 0 ? "IB-Hoch" : "IB-Tief") + " (zurück)"
        if sd >= 0 and not array.get(aRtHit, j)
            line ln = array.get(aRtLn, j)
            line.set_x2(ln, time)
            if sd == 0 ? low <= H : high >= L
                array.set(aRtHit, j, true)
                if array.get(aRtAct, j)
                    msgHit += nm + " getroffen ✓\n"
            else if not array.get(aRtAct, j)
                // einmal ≥ Schwelle (nur direkt nach der Eröffnung verlässlich) → bleibt bis Treffer oder Tagesende
                float qR = (relNow - rel930 + 1) / float(f_relEnd(j) - rel930)
                float p  = f_rt(j, sd, qR, sd == 0 ? (close - H) / f_R(j) : (L - close) / f_R(j)) - f_corr(DR, qR)
                if not na(p) and p >= thrTP / 100.0 and qR < 0.1
                    array.set(aRtAct, j, true)
                    array.set(aRtP, j, p)
                    line.set_color(ln, f_cT(j))
                    msgNew += nm + " · " + f_pct(p) + "\n"
            if drawLbl and array.get(aRtAct, j) and not array.get(aRtHit, j)
                f_lbl(xLbl, sd == 0 ? H : L, nm + " · " + f_pct(array.get(aRtP, j)), f_cT(j), true)

string title = mk + " · Start " + startIn + (two ? " / " + start2In : "")
if alHit and msgHit != ""
    alert("IB-Exp " + title + "\n" + msgHit, alert.freq_once_per_bar)
if alNew and msgNew != ""
    alert("IB-Exp " + title + " · neu\n" + msgNew, alert.freq_once_per_bar)

// ═══ INFO-TABELLE ═══
var table tb = table.new(position.top_right, 5, NJ + 2, bgcolor = color.new(color.black, 80))
if showTab and barstate.islast
    for [c, s] in array.from(mk == "" ? "nur NQ/ES/RTY/GC" : title, "Größe", "Zuerst", "Erreicht", "Statistik")
        table.cell(tb, c, 0, s, text_color = c == 0 ? color.white : color.gray, text_size = size.small)
    int nr = two ? NJ : NI
    for j = 0 to nr - 1
        bool   dn = array.get(aDone, j)
        int    c  = array.get(aCls, j)
        float  rs = array.get(aRsz, j)
        int    ff = array.get(aFF, j)
        string sz = not dn ? "–" : (c == 1 ? "klein" : c == 2 ? "normal" : c == 3 ? "groß" : "?") + (na(rs) ? "" : " " + str.replace(str.tostring(rs, "0.0"), ".", ",") + "×")
        string fs = not dn ? (not f_on(j) ? "aus" : not array.get(HAS, j) ? "keine Daten" : "läuft") : ff == 1 ? "Hoch" : ff == 2 ? "Tief" : "gleich"
        string er = not dn ? "–" : (array.get(aUp, j) < 0 ? "–" : "+" + f_fmt(array.get(aUp, j))) + " / " + (array.get(aDn, j) < 0 ? "–" : "−" + f_fmt(array.get(aDn, j)))
        for [i, s] in array.from(f_tag(j), sz, fs, er, array.get(HAS, j) ? "3 J" : "–")
            table.cell(tb, i, j + 1, s, text_color = i == 0 ? f_cT(j) : color.white, text_size = size.small)
    string wdT = wdI >= 0 and wdI <= 4 ? array.get(WDN, wdI) : "–"
    string enT = (f_relEnd(0) == 1380 ? "17:00" : "16:00") + (two ? " / " + (f_relEnd(NI) == 1380 ? "17:00" : "16:00") : "")
    table.cell(tb, 0, nr + 1, "Statistik 3 J · Wochentag " + wdT + " · Ende " + enT, text_color = color.gray, text_size = size.small)

// ═══ LEVEL-TABELLE: Target grau = offen, grün = getroffen · Protect grau = hält, rot = gebrochen ═══
f_pos(string p) =>
    p == "Unten links" ? position.bottom_left : p == "Oben links" ? position.top_left : p == "Mitte rechts" ? position.middle_right : position.bottom_right

var table lt = table.new(f_pos(lvlPos), 5, 42, bgcolor = color.new(color.black, 80), border_width = 1, border_color = color.new(color.black, 100))

f_lrow(int r, int j, string lvl, float price, float p, int typ, bool hit, bool ended) =>
    table.cell(lt, 0, r, f_tag(j), text_color = color.white, text_size = size.small)
    table.cell(lt, 1, r, typ == 1 ? "Target" : "Protect", text_color = typ == 1 ? f_cT(j) : f_cS(j), text_size = size.small)
    table.cell(lt, 2, r, lvl + "  " + str.tostring(price, format.mintick), text_color = color.white, text_size = size.small)
    table.cell(lt, 3, r, na(p) ? "" : f_pct(p), text_color = color.white, text_size = size.small)
    table.cell(lt, 4, r, hit ? (typ == 1 ? "getroffen ✓" : "gebrochen ✗") : ended ? (typ == 1 ? "nicht erreicht" : "gehalten ✓") : (typ == 1 ? "offen" : "hält"), text_color = color.white, bgcolor = color.new(hit ? (typ == 1 ? cHit : cBrk) : cOpen, 25), text_size = size.small)

if showLvl and barstate.islast
    table.clear(lt, 0, 0, 4, 41)
    for [c, s] in array.from("IB", "Art", "Level · Preis", "% beim Erscheinen", "Status")
        table.cell(lt, c, 0, s, text_color = color.gray, text_size = size.small)
    int r = 1
    for j = 0 to NJ - 1
        if array.get(aDone, j)
            bool   ended = timenow >= array.get(aTEnd, j)
            for side = 0 to 1
                // Kompakt: weitestes Target und erstes Protect; Alle: jedes eingestufte Level
                int kT = -1
                int kS = -1
                for k = 0 to NK - 1
                    int si = f_si(j, side, k)
                    kT := array.get(ST, si) == 1 ? k : kT
                    kS := array.get(ST, si) == 2 and kS < 0 ? k : kS
                for k = 0 to NK - 1
                    int si = f_si(j, side, k)
                    if array.get(ST, si) > 0 and r < 42 and (lvlMode == "Alle" or k == kT or k == kS)
                        f_lrow(r, j, (side == 0 ? "+" : "−") + f_fmt(k), f_price(j, side, k), array.get(SP, si), array.get(ST, si), array.get(SH, si), ended)
                        r += 1
            if array.get(aRtAct, j) and r < 42
                int sd = array.get(aRtS, j)
                f_lrow(r, j, sd == 0 ? "IB-Hoch (zurück)" : "IB-Tief (zurück)", sd == 0 ? array.get(aH, j) : array.get(aL, j), array.get(aRtP, j), 1, array.get(aRtHit, j), ended)
                r += 1
