B1 := barstate.isfirst and mk == "ES" ? "~~~~~~~~~~~~~~~~~~~~WJWxUkVAVOUwUhUXUcVlVSUfWHSEXjVhUSWCSoX6VkUMVaSEXdVlUFW1SRXdWCUHV2RoYBVKUZUwS7XjW6UK~~~~~~~~~~~~~~~~~~~~WKWwUmV5VNV5UeUQUVVoVKUoVYS1XgVXUMViSRXIVZULUjRgXqVUUFV0S1XmVjUXU5RAYHVBUUUeRcY7WGUH~~~~~~~~~~~~~~~~~~~~WKWwUoUxVOV2UnUVUaVnVDUkWXSfWlVVUXWZSwWJW0UVVuS8XQVZUOVoT0WSWrUTV7S2XJVRUXVISHXAWTUD~~~~~~~~~~~~~~~~~~~~WIWyUzV3VBV5UhUyUSVaVFUgVjSIWxVNUhVsSlWQW6USUkRiX5VPUOV9SKWxW8UOUKRcXdVcUNUOS3XGWRUE~~~~~~~~~~~~~~~~~~~~WIX1V1V2VIUtUkUyUUVhV9UcV1S5WqVIUfVVSQWcVwUPUGRMXLVTULUWSLWqWFUWTXRIXQVXUJToR7XQW1Tz~~~~~~~~~~~~~~~~~~~~WHWzV7UtVNUsUjUtUTVlVBUaUdRpWnVCUbV3SBWjVrURTuQuXkW3TzUERvWyWEUCSzRDXPVgUMTORFXKVsUD~~~~~~~~~~~~~~~~~~~~WIWyV6UvVPUqUhUtUUVnV2UgXIStWmVrUJWjT8VwWaUSWGSJWoVgUwW2SrW5WFUhVISIX1VbUXVlSXWtWCUK~~~~~~~~~~~~~~~~~~~~WIX0UnVFV9UvUsUlUlVXV7UpWKSSWxVbUUVySgWRVoUmVDS3WsVXUaVcSaWcWmUHUTRuXHVsUSUmSEWyWGUI~~~~~~~~~~~~~~~~~~~~WIX2UtV8VIUvUiUhUeVgVEUhVWS0WsVYUSVeSQWYVpUSUuRsXGVkUMUcSTWZWDUeTjRcXDVqUOUFRjXHWGUH~~~~~~~~~~~~~~~~~~~~WIWzUxV6VMUrUgUkUfViV7UgVBRxWtVUUQV4SVWWW1USUGRlXAVqUGURS8WoVoUbT5RJX9VaUUTpReXOWHUE~~~~~~~~~~~~~~~~~~~~WIWyUzUzVQUoUkUlUgViV7Ud" : B1
