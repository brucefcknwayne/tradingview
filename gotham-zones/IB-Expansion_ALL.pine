//@version=6
indicator("IB Expansion · Targets & Protects", shorttitle = "IB-Exp", overlay = true, max_lines_count = 500, max_labels_count = 500)
// 🦇 IB EXPANSION · by @Brucefcknwayne – ein Indikator für NQ, ES, RTY, GC (+ MNQ, MES, M2K, MGC), erkennt den Markt selbst.
// Vier IBs ab derselben Startzeit (15/30/45/60 Min), optional eine 2. Startzeit (eigene Farben). Levels ±0,1 … ±3,0 IB-Range, gezeigt wird NUR, was ≥ 70 % hat:
//   Target (blau) = wird bis Tagesende erreicht · Target zurück (blau) = Eröffnung 09:30 außerhalb der IB → IB-Rand wird noch berührt
//   Protect (orange, gestrichelt) = wird NICHT erreicht. Jede Linie läuft, bis sie getroffen ist oder der Tag endet.
//   Standard „Grenzen“: je IB und Seite nur das weiteste offene Target und das erste Protect als Linie (übersichtlich).
// Einstufung bleibt: Ist ein Level einmal ≥ 70 %, bleibt es Target/Protect (mit % von diesem Moment), bis es berührt wird
//   oder der Tag endet – genau so wurde die Statistik gemessen. Level-Tabelle: Target grau = offen / grün = getroffen,
//   Protect grau = hält / rot = gebrochen; nach Tagesende „nicht erreicht“ bzw. „gehalten“.
// Alarme: Alarm anlegen → Bedingung „IB-Exp“ → „Jeder alert()-Funktionsaufruf“.
// Statistik: Databento CME 1m, letzte 3 Jahre bis 2026-10-16, als kompakte Formel je Fenster (data-lab/ib_ext_model.py):
//   IB-Größe (klein/normal/groß ggü. 20 Vortagen) + Wochentag + live Abstand Level ↔ Kurs + Restzeit, minus Korrektur aus dem Prüfjahr.
// Gesperrt (im Test unzuverlässig): neue Targets in den letzten 10 % der Zeit, Target zurück später als 10 % der Zeit ab 09:30.
// Tagesende 17:00 für IBs vor 09:30, sonst 16:00. Für 1m–5m-Charts. Test auf dem ungesehenen Jahr: data-lab/results/ib_ext_model.md

const string TZ    = "America/New_York"
const string ALPHA = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
const string KEYS  = "18:00 19:00 20:00 21:00 22:00 23:00 00:00 01:00 02:00 03:00 04:00 05:00 06:00 07:00 08:00 09:00 10:00 11:00 12:00 13:00 14:00 15:00 08:30 09:30 10:30"
const int    NI    = 4      // IB-Längen 15 / 30 / 45 / 60
const int    NJ    = 8      // IBs gesamt: 2 Startzeiten x 4 Längen (j = Start x 4 + Länge)
const int    NK    = 31     // Level 0 … 30 (0,0 … 3,0 IB)
const int    NC    = 52     // Zahlen je IB: 6 Formeln x 5, Rücklauf 2 x 5, 2 Größen-Schwellen, Wochentag 2 Seiten x Mo–Fr
const int    KPB   = 9      // Startzeiten je Datenblock
const string G_I   = "Initial Balance"
const string G_S   = "Schwellen"
const string G_A   = "Anzeige"

string startIn = input.string("09:30", "IB-Start (NY)", options = ["18:00", "19:00", "20:00", "21:00", "22:00", "23:00", "00:00", "01:00", "02:00", "03:00", "04:00", "05:00", "06:00", "07:00", "08:00", "08:30", "09:00", "09:30", "10:00", "10:30", "11:00", "12:00", "13:00", "14:00", "15:00"], group = G_I)
string start2In = input.string("aus", "2. IB-Start (NY)", options = ["aus", "18:00", "19:00", "20:00", "21:00", "22:00", "23:00", "00:00", "01:00", "02:00", "03:00", "04:00", "05:00", "06:00", "07:00", "08:00", "08:30", "09:00", "09:30", "10:00", "10:30", "11:00", "12:00", "13:00", "14:00", "15:00"], group = G_I, tooltip = "Optional eine zweite Startzeit gleichzeitig, z. B. 08:30 + 09:30 – mit eigenen Farben.")
bool   on15    = input.bool(true, "15 Min", inline = "l", group = G_I)
bool   on30    = input.bool(true, "30 Min", inline = "l", group = G_I)
bool   on45    = input.bool(true, "45 Min", inline = "l", group = G_I)
bool   on60    = input.bool(true, "60 Min", inline = "l", group = G_I)
int    thrTP   = input.int(70, "Target ab (% erreicht)", minval = 50, maxval = 95, group = G_S)
int    thrSL   = input.int(70, "Protect ab (% hält)", minval = 50, maxval = 95, group = G_S)
string lblMode = input.string("Grenzen", "Linien & Beschriftung", options = ["Grenzen", "Alle Levels"], group = G_A, tooltip = "Grenzen (übersichtlich): je IB und Seite nur das weiteste offene Target und das erste Protect. Alle Levels: jedes Level ≥ Schwelle.")
bool   delOld  = input.bool(true, "Nur Linien von heute", group = G_A, tooltip = "Linien der Vortage beim neuen Handelstag löschen.")
bool   showIB  = input.bool(true, "IB-Hoch/-Tief immer zeigen", group = G_A, tooltip = "Als dünne Orientierung, auch unter der Schwelle.")
bool   showTab = input.bool(true, "Info-Tabelle", group = G_A)
bool   showLvl = input.bool(true, "Level-Tabelle", group = G_A)
string lvlMode = input.string("Kompakt", "Level-Tabelle zeigt", options = ["Kompakt", "Alle"], group = G_A, tooltip = "Kompakt: je IB und Seite das weiteste Target und das erste Protect. Alle: jedes aktive Level.")
string lvlPos  = input.string("Unten rechts", "Position Level-Tabelle", options = ["Unten rechts", "Unten links", "Oben links", "Mitte rechts"], group = G_A)
bool   alHit   = input.bool(true, "Alarm: Target getroffen / Protect gebrochen", group = "Alarme")
bool   alNew   = input.bool(false, "Alarm: neues Level ≥ Schwelle", group = "Alarme")
color  cHit    = input.color(#00c853, "Target getroffen", inline = "s", group = G_A)
color  cBrk    = input.color(#ff1744, "Protect gebrochen", inline = "s", group = G_A)
color  cOpen   = input.color(#787b86, "Offen", inline = "s", group = G_A)
color  cTP     = input.color(#2962ff, "Target", inline = "c", group = G_A)
color  cSL     = input.color(#ff9800, "Protect", inline = "c", group = G_A)
color  cIB     = input.color(#e535f5, "IB", inline = "c", group = G_A)
color  cTP2    = input.color(#00bcd4, "Target 2. Start", inline = "c2", group = G_A)
color  cSL2    = input.color(#ffd600, "Protect 2. Start", inline = "c2", group = G_A)
color  cIB2    = input.color(#9575cd, "IB 2. Start", inline = "c2", group = G_A)

var array<int>    LENS = array.from(15, 30, 45, 60)
var array<string> WDN  = array.from("Mo", "Di", "Mi", "Do", "Fr")
bool two = start2In != "aus" and start2In != startIn
f_len(int j) =>
    array.get(LENS, j % NI)
f_on(int j) =>
    int l = j % NI
    (l == 0 ? on15 : l == 1 ? on30 : l == 2 ? on45 : on60) and (j < NI or two)
f_start(int j) =>
    j < NI ? startIn : start2In
f_tag(int j) =>
    (two ? f_start(j) + " " : "") + str.tostring(f_len(j)) + "m"
f_cT(int j) =>
    j < NI ? cTP : cTP2
f_cS(int j) =>
    j < NI ? cSL : cSL2
f_cI(int j) =>
    j < NI ? cIB : cIB2

// ═══ DATEN: je Markt 3 Blöcke mit KPB Startzeiten (4 IB-Längen x 52 Zahlen à 2 Zeichen) + Korrektur (3 x 10 Zahlen) ═══
string root = syminfo.root
string mk   = root == "NQ" or root == "MNQ" ? "NQ" : root == "ES" or root == "MES" ? "ES" : root == "RTY" or root == "M2K" ? "RTY" : root == "GC" or root == "MGC" ? "GC" : ""
var string B0  = ""
var string B1  = ""
var string B2  = ""
var string COR = ""
B0 := barstate.isfirst and mk == "NQ" ? "" : B0
B1 := barstate.isfirst and mk == "NQ" ? "~~~~~~~~~~~~~~~~~~~~WMWvUpVFVZUmUWUTUcVlVaUbVgRyXiVPUbVxSgXFVxULV1RqXxVNUNVDS7Y4WMUIUIRBYYVNUJUeRyY8WQUH~~~~~~~~~~~~~~~~~~~~WLWwUjUvVjUtUdUPUbVgVMUqUrRoXbVQUOVFSJXbVmUNTnRLXdUvURUkReYCWMUCTYQgYeVSUHTgR4YEW1UH~~~~~~~~~~~~~~~~~~~~WNWwUjUtVnUqUfURUdVgVJUoW8SdWoVeUQWIShWRW2UcVURyXvWHUNVeShWwWbUWV2RlY4VsUDUkSGXdWhUR~~~~~~~~~~~~~~~~~~~~WJWwV5V3VLUsUdUqUXVgVBUhVBSAX4VZUgVTSSWgW1UZUcRRXhViUIUoSBXDWFUITrRGY5VsUCU7RnY6WuUC~~~~~~~~~~~~~~~~~~~~WLWyV3V2VSUmUdUkUaVgVEUhUgSBWsVhUcV9SCWqVqUhTpQXYKW2TqU8RiXLWqU5SyQiXzVlU6TSRTYIWSUG~~~~~~~~~~~~~~~~~~~~WKWzV4UyVUUkUfUjUZVjVEUfUGRdX1VYUWUgRxWlVoUXTEQQY9W4ToToRLXgWiU2SQQiYGVwUGT2RIY8WTUF~~~~~~~~~~~~~~~~~~~~WLX1V5UyVVUlUcUkUaViV7UjWoSiWaW1UMWOT7WKWGUTW0ScWqVgUeW9SmWJWJUOV5RvXKVNUkVTSMWzWNUJ~~~~~~~~~~~~~~~~~~~~WJX1UqV7VRUjUqUbUvVUVHUhVtSJWhVkUIVvScWUVyUgV8S0XJVcUfVESPWmWiUFTxRdXHVQUaUdRvXIWIUB~~~~~~~~~~~~~~~~~~~~WJX0UxV3VZUeUiUcUnVaVHUgVBRqWrVjUEVGSYWfVyURUfRhXQVlUMUgSBWuWAUNTJRJXMVeULTsRQXQW7UE~~~~~~~~~~~~~~~~~~~~WKX0V2V6VTUeUeUeUlVdVBUhUjRtWtViUIUrSVWiW1UVTwRGXNVpUEULRrXGWGUHSmR5XXViUKTLRJXPVzUH~~~~~~~~~~~~~~~~~~~~WKWzV5UyVWUeUgUbUmVcVDUh" : B1
