// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// FVG-/IFVG-Logik und Zeichnung: © TFlab ("FVG & IFVG ICT [TradingFinder]")
//@version=5
strategy("FVG & IFVG Strategie [TFlab-Basis]", shorttitle = "FVG-IFVG", overlay = true, pyramiding = 2,
     default_qty_type = strategy.fixed, default_qty_value = 1, slippage = 1,
     commission_type = strategy.commission.cash_per_contract, commission_value = 2.5,
     use_bar_magnifier = true, process_orders_on_close = true, max_bars_back = 5000,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ─────────────────────────────────────────────────────────────────────────────
//  Strategie auf Basis des Indikators "FVG & IFVG ICT [TradingFinder]".
//  Version 5, weil die TFlab-Libraries v5 sind. FVG-Erkennung inkl. Filter kommt
//  1:1 aus TFlab/FVGDetectorLibrary, die Zonen zeichnet TFlab/OrderBlockDrawing –
//  genau wie im Original-Indikator.
//
//  EINSTIEG (sofort beim Schluss der Signal-Kerze):
//   • Bullisches FVG geprintet                                    → LONG
//   • Bärisches FVG geprintet                                     → SHORT
//   • Bärisches FVG, Kerze schließt über dem Distal = bull. IFVG  → LONG
//   • Bullisches FVG, Kerze schließt unter dem Distal = bär. IFVG → SHORT
//     (ein FVG, das vorher schon mitigiert wurde, ist weg und kann nicht mehr
//      invertieren – wie im Indikator)
//
//  SL  = letztes Swing-Tief (Long) / Swing-Hoch (Short) + Puffer
//  TP  = SL-Abstand × R:R (ab 0.1 frei einstellbar)
//  SL größer als "Max. SL" (z. B. 50 Pkt. NQ) → kein Trade.
//
//  NEUES SIGNAL IM TRADE: jedes FVG/IFVG wird sofort geentert. Der laufende
//  Trade wird geschlossen (egal ob Plus oder Minus, egal welche Richtung) und
//  das neue Signal mit eigenem SL/TP eröffnet. Ist das neue Signal ungültig
//  (SL > Max. SL), läuft der alte Trade weiter.
//  (pyramiding = 2 nur, damit "gleiche Richtung neu entern" technisch geht –
//   es ist nie mehr als ein Trade offen.)
// ─────────────────────────────────────────────────────────────────────────────

import TFlab/OrderBlockDrawing_TradingFinder/3 as Drawing
import TFlab/FVGDetectorLibrary/3 as FVG
import TFlab/Dark_Light_Theme_TradingFinder_Switching_Colors_Library/1 as SC

// ───────────────────────────── Inputs wie im Indikator ─────────────────────────────
ShowAllFVG  = input.bool(true, 'Show All FVG', group = 'Global Setting')
ShowAllIFVG = input.bool(true, 'Show All Inversion FVG', group = 'Global Setting')
FVGVaP      = input.int(500, 'FVG & IFVG Validity Period (Bar)', maxval = 4998, minval = 10, group = 'Global Setting',
 tooltip = 'You can set the validity period of each FVG & IFVG based on the number of candles that have passed since the origin of the Order Block.')
SCMode      = input.string('Light', 'Switching Colors Theme Mode', options = ['Off', 'Light', 'Dark'])

PShowDeFVG  = input.bool(true, ' Show Bullish FVG', group = 'FVG', inline = 'DFVG')
PShowSuFVG  = input.bool(true, ' Show Bearish FVG', group = 'FVG', inline = 'SFVG')
OCShowDeFVG = input.color(#4caf4f65, '', group = 'FVG', inline = 'DFVG')
OCShowSuFVG = input.color(#ff525291, '', group = 'FVG', inline = 'SFVG')
MLFVG       = input.string('50 % OB', 'Mitigation Level FVG', ['Proximal', '50 % OB', 'Distal'], group = 'FVG',
 tooltip = 'Using this entry, you can determine which level the price reacts to in a FVG.')

PShowDeIFVG  = input.bool(true, ' Show Bearish Inversion FVG', group = 'Inversion FVG', inline = 'IDFVG')
PShowSuIFVG  = input.bool(true, ' Show Bullish Inversion FVG', group = 'Inversion FVG', inline = 'ISFVG')
OCShowDeIFVG = input.color(#ff52522f, '', group = 'Inversion FVG', inline = 'IDFVG')
OCShowSuIFVG = input.color(#4caf4f27, '', group = 'Inversion FVG', inline = 'ISFVG')
MLIFVG       = input.string('50 % OB', 'Mitigation Level IFVG', ['Proximal', '50 % OB', 'Distal'], group = 'Inversion FVG',
 tooltip = 'Using this entry, you can determine which level the price reacts to in a Inversion FVG.')

PFVGFilter     = input.bool(true, 'FVG Filter ............', group = 'FVG', inline = 'FVG Filter')
PFVGFilterType = input.string('Very Defensive', '', ['Very Aggressive', 'Aggressive', 'Defensive', 'Very Defensive'], group = 'FVG', inline = 'FVG Filter',
 tooltip = 'If it is "On", this filter will filter "FVGs" based on the width of the Zone.' +
 'From "Very Aggressive" to "Very Defensive" the width of the "FVG" decreases.')

// ───────────────────────────── Inputs Strategie ─────────────────────────────
G_E = "Strategie: Signale"
G_R = "Strategie: Risiko"
G_Z = "Strategie: Handelszeit"
G_A = "Strategie: Anzeige"

useFVG  = input.bool(true, "Entry bei neuem FVG", group = G_E)
useIFVG = input.bool(true, "Entry bei neuem IFVG", group = G_E)
allowL  = input.bool(true, "Longs", inline = "d", group = G_E)
allowS  = input.bool(true, "Shorts", inline = "d", group = G_E)

rr      = input.float(1.0, "R:R (TP = SL-Abstand × R)", minval = 0.1, step = 0.1, group = G_R)
maxSL   = input.float(50, "Max. SL (Punkte) – größer = kein Trade", minval = 0.25, step = 0.25, group = G_R)
minSL   = input.float(0, "Min. SL (Punkte)", minval = 0, step = 0.25, group = G_R, tooltip = "Schützt vor Mini-Stops, bei denen Gebühren/Slippage den Gewinn auffressen. 0 = aus.")
swL     = input.int(3, "Swing: Kerzen links", minval = 1, maxval = 20, inline = "sw", group = G_R)
swR     = input.int(2, "rechts", minval = 1, maxval = 10, inline = "sw", group = G_R, tooltip = "Ein Swing-Tief ist bestätigt, wenn links/rechts davon so viele Kerzen höhere Tiefs haben.")
bufTk   = input.int(0, "SL-Puffer (Ticks)", minval = 0, group = G_R)
fbLen   = input.int(30, "Ersatz-SL: Extrem der letzten N Kerzen", minval = 3, group = G_R, tooltip = "Nur wenn kein bestätigter Swing unter/über dem Einstieg liegt.")


useSess = input.bool(false, "Nur in der Handelszeit einsteigen", group = G_Z)
sess    = input.session("0930-1600", "Handelszeit (New York)", group = G_Z)

showTrd = input.bool(true, "Trade-Boxen (SL/TP)", inline = "t", group = G_A)
cTP     = input.color(color.new(#9e9e9e, 70), "", inline = "t", group = G_A)
cSL     = input.color(color.new(#673ab7, 70), "", inline = "t", group = G_A)
showTbl = input.bool(true, "Statistik-Tabelle", group = G_A)

// ───────────────────────────── FVG (TFlab, unverändert) ─────────────────────────────
[CShowDeFVG]  = SC.SwitchingColorMode(OCShowDeFVG, SCMode)
[CShowSuFVG]  = SC.SwitchingColorMode(OCShowSuFVG, SCMode)
[CShowDeIFVG] = SC.SwitchingColorMode(OCShowDeIFVG, SCMode)
[CShowSuIFVG] = SC.SwitchingColorMode(OCShowSuIFVG, SCMode)

[DConditionFVG, DDFVG, DPFVG, BarDFVG, SConditionFVG, SDFVG, SPFVG, BarSFVG] = FVG.FVGDetector(PFVGFilter ? 'On' : 'Off', PFVGFilterType, false, false)

[Alert_DFVG, Alert_DIFVG] = Drawing.OBDrawing('Demand', DConditionFVG, DDFVG, DPFVG, BarDFVG, true, FVGVaP, MLFVG, MLIFVG, ShowAllFVG, ShowAllIFVG, PShowDeFVG, PShowDeIFVG, CShowDeFVG, CShowDeIFVG)
[Alert_SFVG, Alert_SIFVG] = Drawing.OBDrawing('Supply', SConditionFVG, SDFVG, SPFVG, BarSFVG, true, FVGVaP, MLFVG, MLIFVG, ShowAllFVG, ShowAllIFVG, PShowSuFVG, PShowSuIFVG, CShowSuFVG, CShowSuIFVG)

// ───────────────────────────── IFVG-Entstehung ─────────────────────────────
// Die Drawing-Library meldet nur die Mitigation, nicht das Entstehen eines IFVG.
// Daher werden die FVGs aus der Library hier mitgeführt:
//   Demand-FVG: Schluss unter Distal → bärisches IFVG;  Tief erreicht Mitigation-Level → FVG erledigt
//   Supply-FVG: Schluss über Distal  → bullisches IFVG; Hoch erreicht Mitigation-Level → FVG erledigt
//   Älter als die Validity Period → erledigt
var fDist = array.new_float()
var fProx = array.new_float()
var fDir  = array.new_int()
var fBar  = array.new_int()

bool bullIFVG = false   // aus Supply-FVG → Long
bool bearIFVG = false   // aus Demand-FVG → Short

int nF = array.size(fDist)
if nF > 0
    for i = nF - 1 to 0
        int   d    = array.get(fDir, i)
        float dist = array.get(fDist, i)
        float prox = array.get(fProx, i)
        float lvl  = MLFVG == 'Proximal' ? prox : MLFVG == 'Distal' ? dist : (prox + dist) / 2
        bool  inv  = d == 1 ? close < dist : close > dist
        bool  mit  = d == 1 ? low <= lvl : high >= lvl
        bool  old  = bar_index - array.get(fBar, i) > FVGVaP
        if inv
            if d == 1
                bearIFVG := true
            else
                bullIFVG := true
        if inv or mit or old
            array.remove(fDist, i)
            array.remove(fProx, i)
            array.remove(fDir, i)
            array.remove(fBar, i)

if DConditionFVG
    array.push(fDist, DDFVG)
    array.push(fProx, DPFVG)
    array.push(fDir, 1)
    array.push(fBar, bar_index)
if SConditionFVG
    array.push(fDist, SDFVG)
    array.push(fProx, SPFVG)
    array.push(fDir, -1)
    array.push(fBar, bar_index)
if array.size(fDist) > 300
    array.shift(fDist)
    array.shift(fProx)
    array.shift(fDir)
    array.shift(fBar)

// ───────────────────────────── Swings für den SL ─────────────────────────────
tick = syminfo.mintick

var swHi = array.new_float()
var swLo = array.new_float()
float ph = ta.pivothigh(high, swL, swR)
float pl = ta.pivotlow(low, swL, swR)
if not na(ph)
    array.push(swHi, ph)
    if array.size(swHi) > 50
        array.shift(swHi)
if not na(pl)
    array.push(swLo, pl)
    if array.size(swLo) > 50
        array.shift(swLo)

// Noch nicht bestätigte Extreme der letzten Kerzen (der Swing kann gerade erst entstehen)
float recentLo = ta.lowest(low, swR + 1)
float recentHi = ta.highest(high, swR + 1)
float fbLo     = ta.lowest(low, fbLen)
float fbHi     = ta.highest(high, fbLen)

// Jüngstes Swing-Tief unter ref (Long) bzw. Swing-Hoch über ref (Short)
f_lastSwing(float[] arr, float ref, bool below) =>
    float res = na
    int n = array.size(arr)
    if n > 0
        for i = n - 1 to 0
            float v = array.get(arr, i)
            if below ? v < ref : v > ref
                res := v
                break
    res

float swingL = f_lastSwing(swLo, close, true)
float swingS = f_lastSwing(swHi, close, false)
float slL    = math.min(na(swingL) ? fbLo : swingL, recentLo) - bufTk * tick
float slS    = math.max(na(swingS) ? fbHi : swingS, recentHi) + bufTk * tick

// ───────────────────────────── Signale ─────────────────────────────
bool sigL = allowL and ((useFVG and DConditionFVG) or (useIFVG and bullIFVG))
bool sigS = allowS and ((useFVG and SConditionFVG) or (useIFVG and bearIFVG))
if sigL and sigS        // widersprüchlich → auslassen
    sigL := false
    sigS := false
string srcL = useIFVG and bullIFVG ? "IFVG" : "FVG"
string srcS = useIFVG and bearIFVG ? "IFVG" : "FVG"

bool inSess = not useSess or not na(time(timeframe.period, sess, "America/New_York"))

// ───────────────────────────── Trade-Logik ─────────────────────────────
var int    skipCnt = 0
var int    repCnt  = 0
var int    tradeNo = 0
var string curId   = ""
var box    bTP     = na
var box    bSL     = na
var int    drDir   = 0

float pos = strategy.position_size

// Trade-Box mitziehen, bis der Trade beendet ist
if drDir != 0
    box.set_right(bTP, bar_index)
    box.set_right(bSL, bar_index)
    if not ((drDir == 1 and pos > 0) or (drDir == -1 and pos < 0))
        drDir := 0

int   newDir  = 0
bool  skipped = false
bool  flipped = false
float nSL     = na
float nTP     = na

if sigL or sigS
    int   d    = sigL ? 1 : -1
    float sl   = d == 1 ? slL : slS
    float risk = d == 1 ? close - sl : sl - close
    bool  ok   = inSess and risk <= maxSL and risk >= math.max(minSL, tick)
    if ok
        newDir := d
        nSL    := sl
        nTP    := close + d * risk * rr
        if pos != 0
            flipped := true
            repCnt  += 1
            // Gleiche Richtung: alten Trade explizit schließen.
            // Gegenrichtung: strategy.entry dreht automatisch (schließt den alten mit).
            if math.sign(pos) == d
                strategy.close(curId, comment = "Neues Signal")
    else if inSess
        skipped := true
        skipCnt += 1

if newDir != 0
    string src = newDir == 1 ? srcL : srcS
    tradeNo += 1
    string eid = (newDir == 1 ? "Long " : "Short ") + str.tostring(tradeNo)
    curId := eid
    strategy.entry(eid, newDir == 1 ? strategy.long : strategy.short, comment = src + (flipped ? " ↻" : ""))
    strategy.exit("X " + eid, eid, stop = nSL, limit = nTP, comment_profit = "TP", comment_loss = "SL")
    if showTrd
        bTP := box.new(bar_index, nTP, bar_index + 1, close, border_color = color.new(cTP, 100), bgcolor = cTP)
        bSL := box.new(bar_index, close, bar_index + 1, nSL, border_color = color.new(cSL, 100), bgcolor = cSL)
        drDir := newDir
    label.new(bar_index, newDir == 1 ? low : high, src + (flipped ? " ↻" : ""), style = newDir == 1 ? label.style_label_up : label.style_label_down,
         color = newDir == 1 ? color.new(#4caf50, 20) : color.new(#ff5252, 20), textcolor = color.white, size = size.tiny)
    alert((newDir == 1 ? "LONG " : "SHORT ") + src + (flipped ? " (alter Trade geschlossen)" : "") + " @ " + str.tostring(close, format.mintick) +
         " | SL " + str.tostring(nSL, format.mintick) + " | TP " + str.tostring(nTP, format.mintick), alert.freq_once_per_bar_close)

plotshape(skipped and sigL, "Long ausgelassen (SL zu groß)", shape.xcross, location.belowbar, color.new(color.gray, 20), size = size.tiny)
plotshape(skipped and sigS, "Short ausgelassen (SL zu groß)", shape.xcross, location.abovebar, color.new(color.gray, 20), size = size.tiny)

// ───────────────────────────── Tabelle ─────────────────────────────
var table tbl = table.new(position.top_right, 2, 8, bgcolor = color.new(#131722, 10), frame_color = #434651, frame_width = 1, border_color = #434651, border_width = 1)

f_row(int r, string k, string v, color vc) =>
    table.cell(tbl, 0, r, k, text_color = #b2b5be, text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 1, r, v, text_color = vc, text_size = size.small, text_halign = text.align_right)

if showTbl and barstate.islast
    int   tr  = strategy.closedtrades
    float wr  = tr > 0 ? 100.0 * strategy.wintrades / tr : 0.0
    float be  = 100.0 / (1 + rr)    // nötige Trefferquote ohne Gebühren
    float pf  = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
    float net = strategy.netprofit
    f_row(0, "FVG/IFVG  R:R", str.tostring(rr, "#.##"), color.white)
    f_row(1, "Trades", str.tostring(tr), color.white)
    f_row(2, "Trefferquote", str.tostring(wr, "#.0") + " %", wr >= be ? #4caf50 : #ff5252)
    f_row(3, "Nötig (Break-even)", str.tostring(be, "#.0") + " %", color.white)
    f_row(4, "Profit-Faktor", na(pf) ? "–" : str.tostring(pf, "#.00"), nz(pf) >= 1 ? #4caf50 : #ff5252)
    f_row(5, "Netto", str.tostring(net, "#,##0") + " " + syminfo.currency, net >= 0 ? #4caf50 : #ff5252)
    f_row(6, "Trade ersetzt (neues Signal)", str.tostring(repCnt), color.white)
    f_row(7, "Ausgelassen (SL > Max)", str.tostring(skipCnt), color.white)
