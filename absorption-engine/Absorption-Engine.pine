//@version=6
// Absorption Engine – zeigt, ob an einem Preis gerade absorbiert wird (Footprint je Kerze).
//
// Bid-Absorption (bullisch): Verkäufer drücken mit viel aggressivem Volumen in die untersten Ticks der Kerze,
//   aber der Preis bleibt nicht unten (Schluss deutlich über dem Tief) → passive Käufer haben aufgenommen.
// Ask-Absorption (bärisch): spiegelbildlich am Hoch.
// Aufwand = aggressives Volumen in der Extrem-Zone im Verhältnis zur Ø-Kerze, Dominanz = Verkäufer/Käufer dort,
// Ergebnis = wie weit der Schluss vom Extrem weg ist. Signal erst bei Kerzenschluss (kein Repaint),
// die laufende Kerze wird live in der Tabelle angezeigt. Benötigt TradingView-Footprint (Premium/Ultimate).
indicator("Absorption Engine", shorttitle = "ABS", overlay = true, max_labels_count = 500, max_boxes_count = 300, max_lines_count = 20)

// ═══════════════════════════ INPUTS ═══════════════════════════
G1 = "Absorption"
rowTicks = input.int(1, "Footprint ticks per row", minval = 1, group = G1)
edgeT    = input.int(4, "Extreme zone (ticks from high/low)", minval = 1, group = G1,
     tooltip = "Aggressive volume inside this many ticks of the bar's low (bid absorption) or high (ask absorption) counts.")
baseLen  = input.int(50, "Average length (bars)", minval = 5, group = G1)
effX     = input.float(0.25, "Effort: aggressive volume in zone ≥ × avg bar volume", minval = 0.05, step = 0.05, group = G1)
domX     = input.float(1.3, "Dominance: aggressor / other side in zone ≥", minval = 1.0, step = 0.1, group = G1)
holdT    = input.int(3, "Held: close ≥ ticks away from extreme", minval = 0, group = G1)
holdFr   = input.float(0.25, "Held: or ≥ fraction of bar range", minval = 0.0, maxval = 1.0, step = 0.05, group = G1)
minStr   = input.int(30, "Min. strength to show (0–100)", minval = 0, maxval = 100, group = G1)

G2 = "Levels"
lvMode = input.string("Everywhere", "Show absorption", options = ["Everywhere", "Only at my levels"], group = G2)
lv1    = input.price(0.0, "Level 1 (0 = off)", group = G2)
lv2    = input.price(0.0, "Level 2 (0 = off)", group = G2)
lv3    = input.price(0.0, "Level 3 (0 = off)", group = G2)
usePD  = input.bool(true, "Previous day high/low as levels", group = G2)
tolT   = input.int(8, "Level tolerance (ticks)", minval = 0, group = G2)
showLv = input.bool(true, "Draw my levels", group = G2)

G3 = "Outcome tracking"
tgtT    = input.int(16, "Held = price moves ticks away", minval = 1, group = G3)
failT   = input.int(6, "Failed = price trades ticks through the extreme", minval = 1, group = G3)
maxBars = input.int(15, "Decide within bars", minval = 1, group = G3)

G4 = "Display"
showLbl = input.bool(true, "Labels", group = G4)
showBox = input.bool(true, "Absorption zones", group = G4)
showTbl = input.bool(true, "Status table", group = G4)
tblPos  = input.string("Top Right", "Table position", options = ["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group = G4)
cBull   = input.color(#26a69a, "Bid absorption", group = G4)
cBear   = input.color(#ef5350, "Ask absorption", group = G4)

// ═══════════════════════════ FOOTPRINT ═══════════════════════════
float tick = syminfo.mintick
footprint fp = request.footprint(rowTicks, 70)
bool fpOk = not na(fp)

float sLow = 0.0      // Verkäufer-Aggression in der unteren Zone
float bLow = 0.0
float sHigh = 0.0
float bHigh = 0.0     // Käufer-Aggression in der oberen Zone
if fpOk
    for rw in fp.rows()
        if rw.down_price() <= low + edgeT * tick
            sLow += nz(rw.sell_volume())
            bLow += nz(rw.buy_volume())
        if rw.up_price() >= high - edgeT * tick
            sHigh += nz(rw.sell_volume())
            bHigh += nz(rw.buy_volume())

float totV = fpOk ? nz(fp.buy_volume()) + nz(fp.sell_volume()) : nz(volume)
float avgV = ta.sma(totV, baseLen)[1]          // Durchschnitt ohne die aktuelle Kerze
float rng  = high - low

// ═══════════════════════════ ABSORPTION JE KERZE ═══════════════════════════
float effL = avgV > 0 ? sLow / avgV : 0.0
float domL = sLow / math.max(bLow, 1.0)
float awayL = close - low
bool  absL = fpOk and rng > 0 and effL >= effX and domL >= domX and awayL >= math.max(holdT * tick, holdFr * rng)

float effH = avgV > 0 ? bHigh / avgV : 0.0
float domH = bHigh / math.max(sHigh, 1.0)
float awayH = high - close
bool  absH = fpOk and rng > 0 and effH >= effX and domH >= domX and awayH >= math.max(holdT * tick, holdFr * rng)

f_strength(float eff, float dom, float away) =>
    float s1 = math.min(1.0, eff / (2.0 * effX))
    float s2 = math.min(1.0, (dom - 1.0) / math.max(2.0 * domX - 1.0, 0.1))
    float s3 = rng > 0 ? math.min(1.0, away / rng) : 0.0
    math.round(40 * s1 + 30 * s2 + 30 * s3)

int strL = absL ? f_strength(effL, domL, awayL) : 0
int strH = absH ? f_strength(effH, domH, awayH) : 0

// ═══════════════════════════ LEVELS ═══════════════════════════
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
f_near(float px) =>
    float tol = tolT * tick
    bool hit = false
    if lv1 > 0 and math.abs(px - lv1) <= tol
        hit := true
    if lv2 > 0 and math.abs(px - lv2) <= tol
        hit := true
    if lv3 > 0 and math.abs(px - lv3) <= tol
        hit := true
    if usePD and not na(pdh) and math.abs(px - pdh) <= tol
        hit := true
    if usePD and not na(pdl) and math.abs(px - pdl) <= tol
        hit := true
    hit

bool nearL = f_near(low)
bool nearH = f_near(high)
bool showL = absL and strL >= minStr and (lvMode == "Everywhere" or nearL)
bool showH = absH and strH >= minStr and (lvMode == "Everywhere" or nearH)

var line ln1 = na
var line ln2 = na
var line ln3 = na
if showLv and barstate.islast
    line.delete(ln1)
    line.delete(ln2)
    line.delete(ln3)
    if lv1 > 0
        ln1 := line.new(bar_index - 1, lv1, bar_index, lv1, extend = extend.both, color = color.new(color.yellow, 40), style = line.style_dashed)
    if lv2 > 0
        ln2 := line.new(bar_index - 1, lv2, bar_index, lv2, extend = extend.both, color = color.new(color.yellow, 40), style = line.style_dashed)
    if lv3 > 0
        ln3 := line.new(bar_index - 1, lv3, bar_index, lv3, extend = extend.both, color = color.new(color.yellow, 40), style = line.style_dashed)

// ═══════════════════════════ SIGNALE + AUSWERTUNG ═══════════════════════════
type Sig
    int   dir      // 1 = Bid-Absorption (bullisch), -1 = Ask-Absorption (bärisch)
    float ext      // absorbiertes Extrem
    int   bar
    box   bx

var array<Sig> openSigs = array.new<Sig>()
var int nHeld = 0
var int nFail = 0
var int nExp  = 0
var int dHeld = 0
var int dFail = 0
var int dExp  = 0
var int dSig  = 0
var string lastRes = "–"

if timeframe.change("D")
    dHeld := 0
    dFail := 0
    dExp  := 0
    dSig  := 0

if barstate.isconfirmed
    // offene Signale auswerten (ab der Kerze nach dem Signal; Fail vor Held in derselben Kerze)
    int nOpen = array.size(openSigs)
    for j = 0 to nOpen - 1
        if nOpen == 0
            break
        int i = nOpen - 1 - j
        Sig s = array.get(openSigs, i)
        if bar_index > s.bar
            bool failed = s.dir == 1 ? low <= s.ext - failT * tick : high >= s.ext + failT * tick
            bool held   = s.dir == 1 ? high >= s.ext + tgtT * tick : low <= s.ext - tgtT * tick
            string res = failed ? "FAILED" : held ? "HELD" : bar_index - s.bar >= maxBars ? "EXPIRED" : ""
            if res != ""
                if res == "HELD"
                    nHeld += 1
                    dHeld += 1
                else if res == "FAILED"
                    nFail += 1
                    dFail += 1
                else
                    nExp += 1
                    dExp += 1
                lastRes := res
                if not na(s.bx)
                    box.set_right(s.bx, bar_index)
                    color c = res == "HELD" ? (s.dir == 1 ? cBull : cBear) : res == "FAILED" ? color.gray : color.silver
                    box.set_bgcolor(s.bx, color.new(c, res == "HELD" ? 70 : 85))
                    box.set_border_color(s.bx, color.new(c, 40))
                array.remove(openSigs, i)
            else if not na(s.bx)
                box.set_right(s.bx, bar_index)
    // neue Signale
    if showL
        box bx = showBox ? box.new(bar_index, low + edgeT * tick, bar_index + 1, low, border_color = color.new(cBull, 30), bgcolor = color.new(cBull, 80)) : na
        array.push(openSigs, Sig.new(1, low, bar_index, bx))
        dSig += 1
        if showLbl
            label.new(bar_index, low, "ABS " + str.tostring(strL) + (nearL ? " @lvl" : ""), style = label.style_label_up,
                 color = color.new(cBull, 20), textcolor = color.white, size = size.tiny)
    if showH
        box bx = showBox ? box.new(bar_index, high, bar_index + 1, high - edgeT * tick, border_color = color.new(cBear, 30), bgcolor = color.new(cBear, 80)) : na
        array.push(openSigs, Sig.new(-1, high, bar_index, bx))
        dSig += 1
        if showLbl
            label.new(bar_index, high, "ABS " + str.tostring(strH) + (nearH ? " @lvl" : ""), style = label.style_label_down,
                 color = color.new(cBear, 20), textcolor = color.white, size = size.tiny)

// ═══════════════════════════ STATUS-TABELLE ═══════════════════════════
tPos = tblPos == "Top Right" ? position.top_right : tblPos == "Bottom Right" ? position.bottom_right : tblPos == "Top Left" ? position.top_left : position.bottom_left
var table tb = table.new(tPos, 2, 6, bgcolor = color.new(color.black, 25), border_width = 1)
if showTbl and barstate.islast
    string live = "WAITING"
    color  liveC = color.gray
    if not fpOk
        live := "No footprint data"
    else if absL and absH
        live := "ABSORBING both sides"
        liveC := color.orange
    else if absL
        live := "BID ABSORPTION " + str.tostring(f_strength(effL, domL, awayL)) + (nearL ? " @level" : "")
        liveC := cBull
    else if absH
        live := "ASK ABSORPTION " + str.tostring(f_strength(effH, domH, awayH)) + (nearH ? " @level" : "")
        liveC := cBear
    else if effL >= effX and domL >= domX
        live := "Sellers hitting low – not held yet"
        liveC := color.yellow
    else if effH >= effX and domH >= domX
        live := "Buyers lifting high – not held yet"
        liveC := color.yellow
    int dDone = dHeld + dFail + dExp
    int nDone = nHeld + nFail + nExp
    table.cell(tb, 0, 0, "Now", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 0, live, text_color = liveC, text_size = size.small)
    table.cell(tb, 0, 1, "Low zone sells / buys", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 1, str.tostring(sLow, "#") + " / " + str.tostring(bLow, "#") + "  (×" + str.tostring(effL, "#.00") + " avg)", text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 2, "High zone buys / sells", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 2, str.tostring(bHigh, "#") + " / " + str.tostring(sHigh, "#") + "  (×" + str.tostring(effH, "#.00") + " avg)", text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 3, "Today", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 3, str.tostring(dSig) + " signals · held " + str.tostring(dHeld) + " / failed " + str.tostring(dFail) + " / exp. " + str.tostring(dExp), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 4, "Chart history", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 4, nDone > 0 ? "held " + str.tostring(100.0 * nHeld / nDone, "#") + " % · failed " + str.tostring(100.0 * nFail / nDone, "#") + " % (" + str.tostring(nDone) + ")" : "–", text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 5, "Last result", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 5, lastRes, text_color = lastRes == "HELD" ? color.lime : lastRes == "FAILED" ? color.red : color.gray, text_size = size.small)

alertcondition(showL and barstate.isconfirmed, "Bid absorption", "Bid absorption (bullish) on {{ticker}} at {{low}}")
alertcondition(showH and barstate.isconfirmed, "Ask absorption", "Ask absorption (bearish) on {{ticker}} at {{high}}")
