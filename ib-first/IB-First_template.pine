//@version=6
indicator("IB First · Low first → High gets taken", shorttitle = "IB-First", overlay = true, max_lines_count = 200, max_labels_count = 200)
// 🦇 IB FIRST · by @Brucefcknwayne – NQ, ES, RTY, GC (+ MNQ, MES, M2K, MGC), detects the market automatically.
// Idea: if the IB low forms first, the IB high usually gets taken afterwards – and vice versa.
// At the end of the IB (length: best for market and start time, or fixed) the indicator shows:
//   Target    = "IB High taken 86% · before stop 76%" (before stop = before the first-formed extreme breaks again)
//   TP        = the farthest extension beyond the target that still has at least the chosen probability (TP mode)
//   Stop side = "Stop · Low retaken 35%" – how often the first-formed extreme breaks again until session end
// Lines only on a signal (before stop ≥ setting, default 70 %), otherwise grey "no signal".
// Stop first: target and TP end grey with "stop first ✗". Target first: ✓ and the stop line ends.
// Probabilities depend on: market, start time, IB length, which extreme came first, IB size vs. the 20 previous days
// (e.g. news IB) and where price sits at the end of the IB. Model: {{MODEL}}. Weekday tested: no edge, not included.
// Lines run until touched or until session end (17:00 for IBs before 09:30, otherwise 16:00).
// Data: Databento CME 1m until {{END}}. Analysis and out-of-sample test: data-lab/results/ib_first_model.md
// Built for 1m charts (order of high and low inside the IB).
// Alerts: create alert → condition "IB-First" → "Any alert() function call".

const string TZ    = "America/New_York"
const string ALPHA = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
const string KEYS  = "{{KEYS}}"
const int    NCF   = 32      // numbers per IB: extension 12, before stop 10, stop side 10
const int    KPB   = {{KPB}}      // start times per data block
const float  ZMAX  = {{ZMAX}}
const string G_I   = "Initial Balance"
const string G_A   = "Display"

string startIn  = input.string("09:30", "IB start (NY)", options = ["18:00", "19:00", "20:00", "21:00", "22:00", "23:00", "00:00", "01:00", "02:00", "03:00", "04:00", "05:00", "06:00", "07:00", "08:00", "08:30", "09:00", "09:30", "10:00", "10:30", "11:00", "12:00", "13:00", "14:00", "15:00"], group = G_I)
string lenIn    = input.string("Auto", "IB length", options = ["Auto", "15", "30", "45", "60"], group = G_I, tooltip = "Auto: the length with the best 'target before stop' rate for this market and start time (from the data).")
int    sigIn    = input.int(70, "Signal from (target before stop %)", minval = 50, maxval = 95, group = G_I, tooltip = "Lines only if the opposite IB side gets taken BEFORE the stop side with at least this probability. Otherwise: 'no signal'. Out-of-sample year at 70 %: signal on ~56 % of days, target before stop ~85 %.")
string tpIn     = input.string("80 %", "TP mode", options = ["60 % (more room, more risk)", "70 %", "80 %", "90 % (safe, short)"], group = G_I, tooltip = "Shows the farthest target beyond the opposite IB side that still has at least this probability.")
bool   showStop = input.bool(true, "Show stop side", group = G_A)
bool   showIB   = input.bool(true, "Show IB while forming", group = G_A)
bool   delOld   = input.bool(true, "Today only", group = G_A)
color  cUp      = input.color(#26a69a, "Target up", inline = "c", group = G_A)
color  cDn      = input.color(#ef5350, "Target down", inline = "c", group = G_A)
color  cGray    = input.color(#9598a1, "Stop side / IB", inline = "c", group = G_A)
string txtSize  = input.string("Normal", "Text size", options = ["Small", "Normal", "Large"], group = G_A)
bool   alOn     = input.bool(true, "Alerts (IB done, target / stop hit)", group = "Alerts")

float thrTP = str.startswith(tpIn, "60") ? 0.6 : str.startswith(tpIn, "70") ? 0.7 : str.startswith(tpIn, "80") ? 0.8 : 0.9
// correction per mode: the farthest target at the threshold edge is otherwise slightly optimistic (from validation)
float dTP   = thrTP == 0.6 ? {{D60}} : thrTP == 0.7 ? {{D70}} : thrTP == 0.8 ? {{D80}} : {{D90}}

// ═══ DATA: per market 2 blocks (start times x 4 lengths x 32 numbers of 2 chars) + best length per start time ═══
string root = syminfo.root
string mk   = root == "NQ" or root == "MNQ" ? "NQ" : root == "ES" or root == "MES" ? "ES" : root == "RTY" or root == "M2K" ? "RTY" : root == "GC" or root == "MGC" ? "GC" : ""
var string B0 = ""
var string B1 = ""
var string BL = ""
{{LOADS}}

int ki  = int(str.pos(KEYS, startIn) / 6)
int wdI = dayofweek(time_tradingday, "UTC") - dayofweek.monday          // Wochentag des Handelstags: 0 = Mo … 4 = Fr
int lAuto = str.length(BL) >= ki + 1 ? int(str.tonumber(str.substring(BL, ki, ki + 1))) - 1 : 1
int li    = lenIn == "Auto" ? lAuto : int(str.tonumber(lenIn) / 15) - 1
int L     = (li + 1) * 15

f_dec(string s, int p) =>
    int c1 = str.pos(ALPHA, str.substring(s, p, p + 1))
    int c2 = str.pos(ALPHA, str.substring(s, p + 1, p + 2))
    c1 >= 0 and c2 >= 0 ? (c1 * 62 + c2 - 1922) / 100.0 : na

// coefficients for start ki and length li
f_coefs() =>
    string src = int(ki / KPB) == 0 ? B0 : B1
    int    p0  = ((ki % KPB) * 4 + li) * NCF * 2
    array<float> c = array.new<float>(NCF, na)
    if str.length(src) >= p0 + NCF * 2
        for i = 0 to NCF - 1
            array.set(c, i, f_dec(src, p0 + i * 2))
    c

// Merkmale: [1, side, z, z², pos, pos², Di, Mi, Do, Fr]
f_lin(array<float> c, int o, array<float> x) =>
    float s = 0.0
    for i = 0 to 9
        s += array.get(c, o + i) * array.get(x, i)
    s

f_sig(float z) =>
    1 / (1 + math.exp(-z))

// P(Gegenseite + x IB wird erreicht)
f_pext(array<float> c, array<float> x, float xx) =>
    float u = math.log(xx + 0.05)
    f_sig(f_lin(c, 0, x) + array.get(c, 10) * u + array.get(c, 11) * u * u)

f_pct(float p) =>
    str.tostring(math.round(p * 100)) + "%"

f_fmt(float v) =>
    str.tostring(v, "0.0")

f_size() =>
    txtSize == "Small" ? size.small : txtSize == "Large" ? size.large : size.normal

// ═══ TIME & IB SIZE ═══
f_rel(int t) =>
    (hour(t, TZ) * 60 + minute(t, TZ) - 1080 + 1440) % 1440

int relS   = (int(str.tonumber(str.substring(startIn, 0, 2))) * 60 + int(str.tonumber(str.substring(startIn, 3, 5))) - 1080 + 1440) % 1440
int relE   = relS + L
int relEnd = relS < 930 ? 1380 : 1320
int relNow = f_rel(time)

// median IB range at the same time and length over the 20 previous days (from 15m bars)
f_ibMedian(int rs, int len) =>
    var array<float> hist = array.new<float>()
    var float h = na
    var float l = na
    if timeframe.change("D")
        h := na
        l := na
    float med = array.size(hist) >= 10 ? array.median(hist) : na
    int rn = f_rel(time)
    if rn >= rs and rn < rs + len
        h := na(h) ? high : math.max(h, high)
        l := na(l) ? low : math.min(l, low)
        if f_rel(time_close) == (rs + len) % 1440 and h > l
            array.push(hist, h - l)
            if array.size(hist) > 20
                array.shift(hist)
    med

float m15 = request.security(syminfo.tickerid, "15", f_ibMedian(relS, 15))
float m30 = request.security(syminfo.tickerid, "15", f_ibMedian(relS, 30))
float m45 = request.security(syminfo.tickerid, "15", f_ibMedian(relS, 45))
float m60 = request.security(syminfo.tickerid, "15", f_ibMedian(relS, 60))
float med = li == 0 ? m15 : li == 1 ? m30 : li == 2 ? m45 : m60

// ═══ TAGES-STATUS ═══
var float H    = na
var float Lo   = na
var int   tH   = na
var int   tL   = na
var bool  done = false
var line  ibH  = na
var line  ibL  = na
var label lbF  = na
var int   res  = 0      // 0 open, 1 target first, −1 stop first
var float stY  = na     // stop level (first-formed extreme)
// lines after the IB: 0 target (opposite side), 1 TP, 2 stop side
var array<line>   RL = array.new<line>(3)
var array<label>  RB = array.new<label>(3)
var array<float>  RY = array.new<float>(3, na)
var array<int>    RD = array.new<int>(3, 0)        // 1 = hit when high above level, −1 = when low below level
var array<bool>   RS = array.new<bool>(3, false)   // strict (IB extreme must be exceeded)
var array<bool>   RH = array.new<bool>(3, false)
var array<string> RX = array.new<string>(3, "")

if timeframe.isintraday and timeframe.change("D")
    if delOld
        line.delete(ibH)
        line.delete(ibL)
        label.delete(lbF)
        for i = 0 to 2
            line.delete(array.get(RL, i))
            label.delete(array.get(RB, i))
    ibH := na
    ibL := na
    lbF := na
    for i = 0 to 2
        array.set(RL, i, na)
        array.set(RB, i, na)
    array.fill(RY, na)
    array.fill(RH, false)
    H    := na
    Lo   := na
    tH   := na
    tL   := na
    done := false
    res  := 0
    stY  := na

// build the IB (first occurrence of high and low counts)
if timeframe.isintraday and relNow >= relS and relNow < relE
    if na(H) or high > H
        H  := high
        tH := time
    if na(Lo) or low < Lo
        Lo := low
        tL := time
    if showIB
        if na(ibH)
            ibH := line.new(time, H, time, H, xloc = xloc.bar_time, color = color.new(cGray, 40))
            ibL := line.new(time, Lo, time, Lo, xloc = xloc.bar_time, color = color.new(cGray, 40))
        line.set_y1(ibH, H)
        line.set_y2(ibH, H)
        line.set_y1(ibL, Lo)
        line.set_y2(ibL, Lo)
        line.set_x2(ibH, time)
        line.set_x2(ibL, time)

f_add(int i, float y, int dir, bool strict, string t, color c, int w, string st) =>
    array.set(RY, i, y)
    array.set(RD, i, dir)
    array.set(RS, i, strict)
    array.set(RX, i, t)
    array.set(RL, i, line.new(time, y, time, y, xloc = xloc.bar_time, color = c, width = w, style = st))
    array.set(RB, i, label.new(time, y, t, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(c, 100), textcolor = c, size = f_size()))

// IB done: which came first, how big, where is price → probabilities
string msg = ""
if not done and mk != "" and not na(H) and H > Lo and relNow >= relE and relNow < relEnd
    done := true
    int f = tL < tH ? 0 : tH < tL ? 1 : -1
    array<float> c = f_coefs()
    if f >= 0 and not na(array.get(c, 0))
        bool  lf  = f == 0
        float R   = H - Lo
        float z   = na(med) or med <= 0 ? 0.0 : math.max(-ZMAX, math.min(ZMAX, math.log(R / med)))
        float pr  = (close[1] - Lo) / R
        float pos = math.max(0.0, math.min(1.0, lf ? pr : 1 - pr))
        array<float> x = array.from(1.0, lf ? 1.0 : 0.0, z, z * z, pos, pos * pos, wdI == 1 ? 1.0 : 0.0, wdI == 2 ? 1.0 : 0.0, wdI == 3 ? 1.0 : 0.0, wdI == 4 ? 1.0 : 0.0)
        float pO  = f_pext(c, x, 0.0)
        float pOT = pO - dTP                                    // als TP (mit Korrektur)
        float pZ  = f_sig(f_lin(c, 12, x))
        float pS  = f_sig(f_lin(c, 22, x))
        float oy  = lf ? H : Lo
        int   dir = lf ? 1 : -1
        color cc  = lf ? cUp : cDn
        // TP: farthest x (0.1 … 2.0 IB) with P ≥ threshold, from inside out until the first miss
        float xTP = na
        float pTP = na
        if pOT >= thrTP
            for k = 1 to 20
                float pk = f_pext(c, x, k / 10.0) - dTP
                if pk < thrTP
                    break
                xTP := k / 10.0
                pTP := pk
        string head = (lf ? "IB High" : "IB Low") + " taken " + f_pct(pO) + " · before stop " + f_pct(pZ)
        string info = (lf ? "Low first" : "High first") + " · " + str.tostring(L) + "m" + (na(med) ? "" : " · IB " + f_fmt(R / med) + "×")
        if pZ >= sigIn / 100.0
            stY := lf ? Lo : H
            f_add(0, oy, dir, true, (pOT >= thrTP and na(xTP) ? "TP · " : "") + head, cc, 2, line.style_solid)
            if not na(xTP)
                f_add(1, oy + dir * xTP * R, dir, false, "TP +" + f_fmt(xTP) + " IB · " + f_pct(pTP), cc, 1, line.style_dashed)
            if showStop
                f_add(2, stY, -dir, true, "Stop · " + (lf ? "Low" : "High") + " retaken " + f_pct(pS), cGray, 1, line.style_dotted)
            msg := info + "\n" + head + (na(xTP) ? "" : "\nTP +" + f_fmt(xTP) + " IB " + f_pct(pTP) + " @ " + str.tostring(oy + dir * xTP * R, format.mintick))
        else
            info += " · no signal (before stop " + f_pct(pZ) + ")"
        lbF := label.new(lf ? tL : tH, lf ? Lo : H, info, xloc = xloc.bar_time, style = lf ? label.style_label_up : label.style_label_down, color = color.new(cGray, 100), textcolor = cGray, size = size.small)
if alOn and msg != ""
    alert("IB-First " + mk + " · " + startIn + "\n" + msg, alert.freq_once_per_bar)

// lines run until session end; what comes first: target (opposite side) or stop (same bar counts as stop, like the stats)
f_end(int i, string add, bool gray) =>
    if not na(array.get(RY, i)) and not array.get(RH, i)
        array.set(RH, i, true)
        label.set_text(array.get(RB, i), array.get(RX, i) + add)
        if gray
            line.set_color(array.get(RL, i), color.new(cGray, 40))
            label.set_textcolor(array.get(RB, i), cGray)

string msgHit = ""
if done and relNow < relEnd and not na(array.get(RY, 0))
    for i = 0 to 2
        if not na(array.get(RY, i)) and not array.get(RH, i)
            line.set_x2(array.get(RL, i), time)
            label.set_x(array.get(RB, i), time)
    int   d    = array.get(RD, 0)
    float ty   = array.get(RY, 0)
    bool  sHit = d == 1 ? low < stY : high > stY
    bool  tHit = d == 1 ? high > ty : low < ty
    if res == 0 and sHit
        res := -1
        f_end(0, " · stop first ✗", true)
        f_end(1, " · stop first ✗", true)
        f_end(2, " ✗", false)
        msgHit += "Stop first ✗ @ " + str.tostring(stY, format.mintick)
    else if res == 0 and tHit
        res := 1
        f_end(0, " ✓", false)
        f_end(2, "", false)
        msgHit += array.get(RX, 0) + " ✓\n"
    float tpy = array.get(RY, 1)
    if res == 1 and not na(tpy) and not array.get(RH, 1) and (d == 1 ? high >= tpy : low <= tpy)
        f_end(1, " ✓", false)
        msgHit += array.get(RX, 1) + " ✓"
if alOn and msgHit != ""
    alert("IB-First " + mk + "\n" + msgHit, alert.freq_once_per_bar)
