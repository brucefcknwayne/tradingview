//@version=6
indicator("IB First · Tief zuerst → Hoch wird geholt", shorttitle = "IB-First", overlay = true, max_lines_count = 200, max_labels_count = 200)
// 🦇 IB FIRST · by @Brucefcknwayne – NQ, ES, RTY, GC (+ MNQ, MES, M2K, MGC), erkennt den Markt selbst.
// Idee: Entsteht in der IB zuerst das Tief, wird danach meist das IB-Hoch geholt – und umgekehrt.
// Am Ende der IB (Länge automatisch die beste für Markt und Startzeit, oder fest gewählt) zeigt der Indikator:
//   Gegenseite = „Hoch wird geholt 86% · vor Stop 76%“ (vor Stop = bevor das zuerst gebildete Extrem noch einmal bricht)
//   TP         = die weiteste Ausdehnung über die Gegenseite, die mindestens die gewählte Sicherheit hat (TP-Modus)
//   Stop-Seite = „Tief nochmal 35%“ – wie oft das zuerst gebildete Extrem noch einmal gebrochen wird
// Die % hängen ab von: Markt, Startzeit, IB-Länge, was zuerst kam, IB-Größe ggü. den 20 Tagen davor (z. B. News-IB) und
// Lage des Kurses am IB-Ende. Modell: {{MODEL}}. Wochentag geprüft: im Test kein Vorteil, daher nicht drin.
// Jede Linie läuft bis zur Berührung (✓) oder bis Tagesende (17:00 für IBs vor 09:30, sonst 16:00).
// Daten: Databento CME 1m bis {{END}}. Analyse und Test im ungesehenen Jahr: data-lab/results/ib_first_model.md
// Für 1m-Charts gedacht (Reihenfolge von Hoch und Tief in der IB).
// Alarme: Alarm anlegen → Bedingung „IB-First“ → „Jeder alert()-Funktionsaufruf“.

const string TZ    = "America/New_York"
const string ALPHA = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
const string KEYS  = "{{KEYS}}"
const int    NCF   = 32      // Zahlen je IB: Ausdehnung 12, Ziel vor Stop 10, Stop-Seite 10
const int    KPB   = {{KPB}}      // Startzeiten je Datenblock
const float  ZMAX  = {{ZMAX}}
const string G_I   = "Initial Balance"
const string G_A   = "Anzeige"

string startIn  = input.string("09:30", "IB-Start (NY)", options = ["18:00", "19:00", "20:00", "21:00", "22:00", "23:00", "00:00", "01:00", "02:00", "03:00", "04:00", "05:00", "06:00", "07:00", "08:00", "08:30", "09:00", "09:30", "10:00", "10:30", "11:00", "12:00", "13:00", "14:00", "15:00"], group = G_I)
string lenIn    = input.string("Auto", "IB-Länge", options = ["Auto", "15", "30", "45", "60"], group = G_I, tooltip = "Auto: die Länge mit der besten Quote „Ziel vor Stop“ für Markt und Startzeit (aus den Daten).")
string tpIn     = input.string("80 %", "TP-Modus", options = ["60 % (mehr Weg, mehr Risiko)", "70 %", "80 %", "90 % (sicher, kurz)"], group = G_I, tooltip = "Zeigt das weiteste Ziel über der Gegenseite, das mindestens diese Wahrscheinlichkeit hat.")
bool   showStop = input.bool(true, "Stop-Seite (Erstseite nochmal) zeigen", group = G_A)
bool   showIB   = input.bool(true, "IB während der Bildung zeigen", group = G_A)
bool   delOld   = input.bool(true, "Nur heute zeigen", group = G_A)
color  cUp      = input.color(#26a69a, "Ziel oben", inline = "c", group = G_A)
color  cDn      = input.color(#ef5350, "Ziel unten", inline = "c", group = G_A)
color  cGray    = input.color(#9598a1, "Stop-Seite / IB", inline = "c", group = G_A)
string txtSize  = input.string("Normal", "Textgröße", options = ["Klein", "Normal", "Groß"], group = G_A)
bool   alOn     = input.bool(true, "Alarme (IB fertig, Ziel erreicht)", group = "Alarme")

float thrTP = str.startswith(tpIn, "60") ? 0.6 : str.startswith(tpIn, "70") ? 0.7 : str.startswith(tpIn, "80") ? 0.8 : 0.9
// Korrektur je Modus: das weiteste Ziel am Rand der Schwelle ist sonst leicht zu optimistisch (aus der Validierung)
float dTP   = thrTP == 0.6 ? {{D60}} : thrTP == 0.7 ? {{D70}} : thrTP == 0.8 ? {{D80}} : {{D90}}

// ═══ DATEN: je Markt 2 Blöcke (Startzeiten x 4 Längen x 32 Zahlen à 2 Zeichen) + beste Länge je Startzeit ═══
string root = syminfo.root
string mk   = root == "NQ" or root == "MNQ" ? "NQ" : root == "ES" or root == "MES" ? "ES" : root == "RTY" or root == "M2K" ? "RTY" : root == "GC" or root == "MGC" ? "GC" : ""
var string B0 = ""
var string B1 = ""
var string BL = ""
{{LOADS}}

int ki  = int(str.pos(KEYS, startIn) / 6)
int wdI = dayofweek(time_tradingday, "UTC") - dayofweek.monday          // Wochentag des Handelstags: 0 = Mo … 4 = Fr
int lAuto = str.length(BL) >= ki + 1 ? int(str.tonumber(str.substring(BL, ki, ki + 1))) - 1 : 1
int li    = lenIn == "Auto" ? lAuto : int(str.tonumber(lenIn) / 15) - 1
int L     = (li + 1) * 15

f_dec(string s, int p) =>
    int c1 = str.pos(ALPHA, str.substring(s, p, p + 1))
    int c2 = str.pos(ALPHA, str.substring(s, p + 1, p + 2))
    c1 >= 0 and c2 >= 0 ? (c1 * 62 + c2 - 1922) / 100.0 : na

// Koeffizienten für Start ki und Länge li (einmal je Tag gelesen)
f_coefs() =>
    string src = int(ki / KPB) == 0 ? B0 : B1
    int    p0  = ((ki % KPB) * 4 + li) * NCF * 2
    array<float> c = array.new<float>(NCF, na)
    if str.length(src) >= p0 + NCF * 2
        for i = 0 to NCF - 1
            array.set(c, i, f_dec(src, p0 + i * 2))
    c

// Merkmale: [1, side, z, z², pos, pos², Di, Mi, Do, Fr]
f_lin(array<float> c, int o, array<float> x) =>
    float s = 0.0
    for i = 0 to 9
        s += array.get(c, o + i) * array.get(x, i)
    s

f_sig(float z) =>
    1 / (1 + math.exp(-z))

// P(Gegenseite + x IB wird erreicht)
f_pext(array<float> c, array<float> x, float xx) =>
    float u = math.log(xx + 0.05)
    f_sig(f_lin(c, 0, x) + array.get(c, 10) * u + array.get(c, 11) * u * u)

f_pct(float p) =>
    str.tostring(math.round(p * 100)) + "%"

f_fmt(float v) =>
    str.replace(str.tostring(v, "0.0"), ".", ",")

f_size() =>
    txtSize == "Klein" ? size.small : txtSize == "Groß" ? size.large : size.normal

// ═══ ZEIT & IB-GRÖSSE ═══
f_rel(int t) =>
    (hour(t, TZ) * 60 + minute(t, TZ) - 1080 + 1440) % 1440

int relS   = (int(str.tonumber(str.substring(startIn, 0, 2))) * 60 + int(str.tonumber(str.substring(startIn, 3, 5))) - 1080 + 1440) % 1440
int relE   = relS + L
int relEnd = relS < 930 ? 1380 : 1320
int relNow = f_rel(time)

// Median der IB-Range derselben Uhrzeit und Länge an den 20 Tagen davor (aus 15-Min-Kerzen)
f_ibMedian(int rs, int len) =>
    var array<float> hist = array.new<float>()
    var float h = na
    var float l = na
    if timeframe.change("D")
        h := na
        l := na
    float med = array.size(hist) >= 10 ? array.median(hist) : na
    int rn = f_rel(time)
    if rn >= rs and rn < rs + len
        h := na(h) ? high : math.max(h, high)
        l := na(l) ? low : math.min(l, low)
        if f_rel(time_close) == (rs + len) % 1440 and h > l
            array.push(hist, h - l)
            if array.size(hist) > 20
                array.shift(hist)
    med

float m15 = request.security(syminfo.tickerid, "15", f_ibMedian(relS, 15))
float m30 = request.security(syminfo.tickerid, "15", f_ibMedian(relS, 30))
float m45 = request.security(syminfo.tickerid, "15", f_ibMedian(relS, 45))
float m60 = request.security(syminfo.tickerid, "15", f_ibMedian(relS, 60))
float med = li == 0 ? m15 : li == 1 ? m30 : li == 2 ? m45 : m60

// ═══ TAGES-STATUS ═══
var float H    = na
var float Lo   = na
var int   tH   = na
var int   tL   = na
var bool  done = false
var line  ibH  = na
var line  ibL  = na
var label lbF  = na
// Linien nach der IB: 0 Gegenseite, 1 TP, 2 Stop-Seite
var array<line>   RL = array.new<line>(3)
var array<label>  RB = array.new<label>(3)
var array<float>  RY = array.new<float>(3, na)
var array<int>    RD = array.new<int>(3, 0)        // 1 = gilt bei Hoch über Level, −1 = bei Tief unter Level
var array<bool>   RS = array.new<bool>(3, false)   // strikt (IB-Extrem muss überschritten werden)
var array<bool>   RH = array.new<bool>(3, false)
var array<string> RX = array.new<string>(3, "")

if timeframe.isintraday and timeframe.change("D")
    if delOld
        line.delete(ibH)
        line.delete(ibL)
        label.delete(lbF)
        for i = 0 to 2
            line.delete(array.get(RL, i))
            label.delete(array.get(RB, i))
    ibH := na
    ibL := na
    lbF := na
    for i = 0 to 2
        array.set(RL, i, na)
        array.set(RB, i, na)
    array.fill(RY, na)
    array.fill(RH, false)
    H    := na
    Lo   := na
    tH   := na
    tL   := na
    done := false

// IB bilden (erstes Auftreten von Hoch und Tief zählt)
if timeframe.isintraday and relNow >= relS and relNow < relE
    if na(H) or high > H
        H  := high
        tH := time
    if na(Lo) or low < Lo
        Lo := low
        tL := time
    if showIB
        if na(ibH)
            ibH := line.new(time, H, time, H, xloc = xloc.bar_time, color = color.new(cGray, 40))
            ibL := line.new(time, Lo, time, Lo, xloc = xloc.bar_time, color = color.new(cGray, 40))
        line.set_y1(ibH, H)
        line.set_y2(ibH, H)
        line.set_y1(ibL, Lo)
        line.set_y2(ibL, Lo)
        line.set_x2(ibH, time)
        line.set_x2(ibL, time)

f_add(int i, float y, int dir, bool strict, string t, color c, int w, string st) =>
    array.set(RY, i, y)
    array.set(RD, i, dir)
    array.set(RS, i, strict)
    array.set(RX, i, t)
    array.set(RL, i, line.new(time, y, time, y, xloc = xloc.bar_time, color = c, width = w, style = st))
    array.set(RB, i, label.new(time, y, t, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(c, 100), textcolor = c, size = f_size()))

// IB fertig: was kam zuerst, wie groß, wo steht der Kurs → Wahrscheinlichkeiten
string msg = ""
if not done and mk != "" and not na(H) and H > Lo and relNow >= relE and relNow < relEnd
    done := true
    int f = tL < tH ? 0 : tH < tL ? 1 : -1
    array<float> c = f_coefs()
    if f >= 0 and not na(array.get(c, 0))
        bool  lf  = f == 0
        float R   = H - Lo
        float z   = na(med) or med <= 0 ? 0.0 : math.max(-ZMAX, math.min(ZMAX, math.log(R / med)))
        float pr  = (close[1] - Lo) / R
        float pos = math.max(0.0, math.min(1.0, lf ? pr : 1 - pr))
        array<float> x = array.from(1.0, lf ? 1.0 : 0.0, z, z * z, pos, pos * pos, wdI == 1 ? 1.0 : 0.0, wdI == 2 ? 1.0 : 0.0, wdI == 3 ? 1.0 : 0.0, wdI == 4 ? 1.0 : 0.0)
        float pO  = f_pext(c, x, 0.0)
        float pOT = pO - dTP                                    // als TP (mit Korrektur)
        float pZ  = f_sig(f_lin(c, 12, x))
        float pS  = f_sig(f_lin(c, 22, x))
        float oy  = lf ? H : Lo
        int   dir = lf ? 1 : -1
        color cc  = lf ? cUp : cDn
        // TP: weitestes x (0,1 … 2,0 IB) mit P ≥ Schwelle, von innen nach außen bis zum ersten Unterschreiten
        float xTP = na
        float pTP = na
        if pOT >= thrTP
            for k = 1 to 20
                float pk = f_pext(c, x, k / 10.0) - dTP
                if pk < thrTP
                    break
                xTP := k / 10.0
                pTP := pk
        string head = (lf ? "Hoch" : "Tief") + " wird geholt " + f_pct(pO) + " · vor Stop " + f_pct(pZ)
        f_add(0, oy, dir, true, (pOT >= thrTP and na(xTP) ? "TP · " : "") + head, cc, 2, line.style_solid)
        if not na(xTP)
            f_add(1, oy + dir * xTP * R, dir, false, "TP +" + f_fmt(xTP) + " IB · " + f_pct(pTP), cc, 1, line.style_dashed)
        if showStop
            f_add(2, lf ? Lo : H, -dir, true, (lf ? "Tief" : "Hoch") + " nochmal " + f_pct(pS), cGray, 1, line.style_dotted)
        string info = (lf ? "Tief zuerst" : "Hoch zuerst") + " · " + str.tostring(L) + "m" + (na(med) ? "" : " · IB " + f_fmt(R / med) + "×")
        lbF := label.new(lf ? tL : tH, lf ? Lo : H, info, xloc = xloc.bar_time, style = lf ? label.style_label_up : label.style_label_down, color = color.new(cGray, 100), textcolor = cGray, size = size.small)
        msg := info + "\n" + head + (na(xTP) ? "" : "\nTP +" + f_fmt(xTP) + " IB " + f_pct(pTP) + " @ " + str.tostring(oy + dir * xTP * R, format.mintick))
if alOn and msg != ""
    alert("IB-First " + mk + " · " + startIn + "\n" + msg, alert.freq_once_per_bar)

// Linien laufen bis zur Berührung (✓) oder Tagesende
string msgHit = ""
if done and relNow < relEnd
    for i = 0 to 2
        float y = array.get(RY, i)
        if not na(y) and not array.get(RH, i)
            line.set_x2(array.get(RL, i), time)
            label.set_x(array.get(RB, i), time)
            bool st  = array.get(RS, i)
            bool hit = array.get(RD, i) == 1 ? (st ? high > y : high >= y) : (st ? low < y : low <= y)
            if hit
                array.set(RH, i, true)
                string t = array.get(RX, i) + " ✓"
                label.set_text(array.get(RB, i), t)
                msgHit += t + "\n"
if alOn and msgHit != ""
    alert("IB-First " + mk + "\n" + msgHit, alert.freq_once_per_bar)
