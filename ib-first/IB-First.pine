//@version=6
indicator("IB First", shorttitle = "IB-First", overlay = true, max_lines_count = 200, max_labels_count = 200)
// 🦇 IB FIRST · by @Brucefcknwayne – NQ, ES, RTY, GC (+ MNQ, MES, M2K, MGC) · context, not a strategy
// Which side of the Initial Balance breaks first after the IB is done?
// If the IB makes its LOW first, the IB HIGH usually breaks first afterwards – and vice versa.
// When the IB is done:  line at the side that broke first most often, e.g. "15m · High breaks first 76%"
//                       ✓ = that side broke first · ✗ = the other side broke first (line ends)
//                       optional extension beyond it, e.g. "+0.4 IB 81%" (reached by session end)
// Also other IB lengths (15/30/45/60) as dotted lines if their side broke first at least "from %" often.
// The % depend on market, start time, IB length, which extreme formed first, IB size vs. the 20 previous days (e.g. news)
// and where price sits at the end of the IB. Built for 1m charts.
// Data: CME 1m until 2026-10-16, model: first + IB size + price location, last 5 years, ridge 1. Tested on an unseen year (data-lab/results/ib_first_model.md).
// Alerts: create alert → condition "IB-First" → "Any alert() function call".

const string TZ    = "America/New_York"
const string ALPHA = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
const string KEYS  = "18:00 19:00 20:00 21:00 22:00 23:00 00:00 01:00 02:00 03:00 04:00 05:00 06:00 07:00 08:00 09:00 10:00 11:00 12:00 13:00 14:00 15:00 08:30 09:30 10:30"
const int    NCF   = 32      // numbers per IB: extension 12, other side breaks first 10, first side breaks first 10
const int    KPB   = 13      // start times per data block
const float  ZMAX  = 1.2
const string G_I   = "Initial Balance"
const string G_A   = "Display"

string startIn  = input.string("09:30", "IB start (New York time)", options = ["18:00", "19:00", "20:00", "21:00", "22:00", "23:00", "00:00", "01:00", "02:00", "03:00", "04:00", "05:00", "06:00", "07:00", "08:00", "08:30", "09:00", "09:30", "10:00", "10:30", "11:00", "12:00", "13:00", "14:00", "15:00"], group = G_I)
string lenIn    = input.string("Auto", "IB length (minutes)", options = ["Auto", "15", "30", "45", "60"], group = G_I, tooltip = "Auto = the best length for this market and start time.")
int    minIn    = input.int(70, "Show from (min %)", minval = 50, maxval = 95, group = G_I, tooltip = "Only draw the line if that side broke first at least this often.")
string tpIn     = input.string("80%", "Extension", options = ["Off", "60%", "70%", "80%", "90%"], group = G_I, tooltip = "Farthest level beyond the IB side that was reached by session end at least this often. Lower % = further away.")
bool   showOth  = input.bool(true, "Also show other IB lengths", inline = "o", group = G_I, tooltip = "Dotted line for every other IB length (15/30/45/60) whose side broke first at least this often.")
int    othMin   = input.int(80, "from %", minval = 50, maxval = 95, inline = "o", group = G_I)
bool   showIB   = input.bool(true, "Show IB while forming", group = G_A)
bool   delOld   = input.bool(true, "Today only", group = G_A)
color  cUp      = input.color(#26a69a, "Above", inline = "c", group = G_A)
color  cDn      = input.color(#ef5350, "Below", inline = "c", group = G_A)
color  cGray    = input.color(#9598a1, "Done / IB", inline = "c", group = G_A)
string txtSize  = input.string("Normal", "Text size", options = ["Small", "Normal", "Large"], group = G_A)
bool   alOn     = input.bool(true, "Alerts", group = "Alerts")

bool  extOn = tpIn != "Off"
float thrTP = str.startswith(tpIn, "60") ? 0.6 : str.startswith(tpIn, "70") ? 0.7 : str.startswith(tpIn, "80") ? 0.8 : 0.9
// correction per mode: the farthest level at the threshold edge is otherwise slightly optimistic (from validation)
float dTP   = thrTP == 0.6 ? 0.006 : thrTP == 0.7 ? 0.008 : thrTP == 0.8 ? 0.009 : 0.009

// ═══ DATA: per market 2 blocks (start times x 4 lengths x 32 numbers of 2 chars) + best length per start time ═══
string root = syminfo.root
string mk   = root == "NQ" or root == "MNQ" ? "NQ" : root == "ES" or root == "MES" ? "ES" : root == "RTY" or root == "M2K" ? "RTY" : root == "GC" or root == "MGC" ? "GC" : ""
var string B0 = ""
var string B1 = ""
var string BL = ""
B0 := barstate.isfirst and mk == "NQ" ? "" : B0
B1 := barstate.isfirst and mk == "NQ" ? "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~" : B1
BL := barstate.isfirst and mk == "NQ" ? "3343334411442113122311113" : BL
B0 := barstate.isfirst and mk == "ES" ? "" : B0
B1 := barstate.isfirst and mk == "ES" ? "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~" : B1
BL := barstate.isfirst and mk == "ES" ? "3433344211442343221321142" : BL
B0 := barstate.isfirst and mk == "RTY" ? "" : B0
B1 := barstate.isfirst and mk == "RTY" ? "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~" : B1
BL := barstate.isfirst and mk == "RTY" ? "2423114411243343111321121" : BL
B0 := barstate.isfirst and mk == "GC" ? "" : B0
B1 := barstate.isfirst and mk == "GC" ? "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~" : B1
BL := barstate.isfirst and mk == "GC" ? "1444413231221333221111221" : BL

int ki  = int(str.pos(KEYS, startIn) / 6)
int wdI = dayofweek(time_tradingday, "UTC") - dayofweek.monday          // weekday of the trading day: 0 = Mon … 4 = Fri
int lAuto = str.length(BL) >= ki + 1 ? int(str.tonumber(str.substring(BL, ki, ki + 1))) - 1 : 1
int li    = lenIn == "Auto" ? lAuto : int(str.tonumber(lenIn) / 15) - 1
int L     = (li + 1) * 15

f_dec(string s, int p) =>
    int c1 = str.pos(ALPHA, str.substring(s, p, p + 1))
    int c2 = str.pos(ALPHA, str.substring(s, p + 1, p + 2))
    c1 >= 0 and c2 >= 0 ? (c1 * 62 + c2 - 1922) / 100.0 : na

// coefficients for start ki and IB length index l (0 = 15m … 3 = 60m)
f_coefs(int l) =>
    string src = int(ki / KPB) == 0 ? B0 : B1
    int    p0  = ((ki % KPB) * 4 + l) * NCF * 2
    array<float> c = array.new<float>(NCF, na)
    if str.length(src) >= p0 + NCF * 2
        for i = 0 to NCF - 1
            array.set(c, i, f_dec(src, p0 + i * 2))
    c

// features: [1, side, z, z², pos, pos², Tue, Wed, Thu, Fri]
f_lin(array<float> c, int o, array<float> x) =>
    float s = 0.0
    for i = 0 to 9
        s += array.get(c, o + i) * array.get(x, i)
    s

f_sig(float z) =>
    1 / (1 + math.exp(-z))

// P(other IB side + x IB gets reached by session end)
f_pext(array<float> c, array<float> x, float xx) =>
    float u = math.log(xx + 0.05)
    f_sig(f_lin(c, 0, x) + array.get(c, 10) * u + array.get(c, 11) * u * u)

f_pct(float p) =>
    str.tostring(math.round(p * 100)) + "%"

f_size() =>
    txtSize == "Small" ? size.small : txtSize == "Large" ? size.large : size.normal

// ═══ TIME & IB SIZE ═══
f_rel(int t) =>
    (hour(t, TZ) * 60 + minute(t, TZ) - 1080 + 1440) % 1440

int relS   = (int(str.tonumber(str.substring(startIn, 0, 2))) * 60 + int(str.tonumber(str.substring(startIn, 3, 5))) - 1080 + 1440) % 1440
int relE   = relS + L
int relEnd = relS < 930 ? 1380 : 1320
int relNow = f_rel(time)

// median IB range at the same time and length over the 20 previous days (from 15m bars)
f_ibMedian(int rs, int len) =>
    var array<float> hist = array.new<float>()
    var float h = na
    var float l = na
    if timeframe.change("D")
        h := na
        l := na
    float med = array.size(hist) >= 10 ? array.median(hist) : na
    int rn = f_rel(time)
    if rn >= rs and rn < rs + len
        h := na(h) ? high : math.max(h, high)
        l := na(l) ? low : math.min(l, low)
        if f_rel(time_close) == (rs + len) % 1440 and h > l
            array.push(hist, h - l)
            if array.size(hist) > 20
                array.shift(hist)
    med

float m15 = request.security(syminfo.tickerid, "15", f_ibMedian(relS, 15))
float m30 = request.security(syminfo.tickerid, "15", f_ibMedian(relS, 30))
float m45 = request.security(syminfo.tickerid, "15", f_ibMedian(relS, 45))
float m60 = request.security(syminfo.tickerid, "15", f_ibMedian(relS, 60))
f_med(int l) =>
    l == 0 ? m15 : l == 1 ? m30 : l == 2 ? m45 : m60

// ═══ STATE per IB length (0 = 15m … 3 = 60m) ═══
var array<float>  AH  = array.new<float>(4, na)
var array<float>  AL  = array.new<float>(4, na)
var array<int>    ATH = array.new<int>(4, na)
var array<int>    ATL = array.new<int>(4, na)
var array<bool>   ADN = array.new<bool>(4, false)
var array<line>   LN  = array.new<line>(4)        // line at the side that breaks first
var array<label>  LB  = array.new<label>(4)
var array<float>  FY  = array.new<float>(4, na)   // that side
var array<float>  OY  = array.new<float>(4, na)   // the other side
var array<int>    FD  = array.new<int>(4, 0)      // 1 = favoured side above, −1 = below
var array<bool>   FR  = array.new<bool>(4, false) // resolved (one side broke)
var array<string> FT  = array.new<string>(4, "")
var line   eLn = na                               // extension (main IB only)
var label  eLb = na
var float  eY  = na
var int    eD  = 0
var bool   eHit = false
var string eTx = ""
var line   ibH = na
var line   ibL = na
var label  lbF = na

if timeframe.isintraday and timeframe.change("D")
    if delOld
        line.delete(ibH)
        line.delete(ibL)
        label.delete(lbF)
        line.delete(eLn)
        label.delete(eLb)
        for l = 0 to 3
            line.delete(array.get(LN, l))
            label.delete(array.get(LB, l))
    ibH := na
    ibL := na
    lbF := na
    eLn := na
    eLb := na
    eY  := na
    eHit := false
    for l = 0 to 3
        array.set(LN, l, na)
        array.set(LB, l, na)
        array.set(AH, l, na)
        array.set(AL, l, na)
        array.set(ATH, l, na)
        array.set(ATL, l, na)
    array.fill(ADN, false)
    array.fill(FY, na)
    array.fill(OY, na)
    array.fill(FR, false)

string msg = ""
for l = 0 to 3
    int  e    = relS + (l + 1) * 15
    bool main = l == li
    // build the IB (first occurrence of high and low counts)
    if timeframe.isintraday and relNow >= relS and relNow < e
        if na(array.get(AH, l)) or high > array.get(AH, l)
            array.set(AH, l, high)
            array.set(ATH, l, time)
        if na(array.get(AL, l)) or low < array.get(AL, l)
            array.set(AL, l, low)
            array.set(ATL, l, time)
        if main and showIB
            if na(ibH)
                ibH := line.new(time, high, time, high, xloc = xloc.bar_time, color = color.new(cGray, 40))
                ibL := line.new(time, low, time, low, xloc = xloc.bar_time, color = color.new(cGray, 40))
            line.set_xy1(ibH, line.get_x1(ibH), array.get(AH, l))
            line.set_xy2(ibH, time, array.get(AH, l))
            line.set_xy1(ibL, line.get_x1(ibL), array.get(AL, l))
            line.set_xy2(ibL, time, array.get(AL, l))
    float H  = array.get(AH, l)
    float Lo = array.get(AL, l)
    // IB done: which side breaks first?
    if (main or showOth) and mk != "" and not array.get(ADN, l) and relNow >= e and relNow < relEnd and not na(H) and H > Lo
        array.set(ADN, l, true)
        int f = array.get(ATL, l) < array.get(ATH, l) ? 0 : array.get(ATH, l) < array.get(ATL, l) ? 1 : -1
        array<float> c = f_coefs(l)
        if f >= 0 and not na(array.get(c, 0))
            bool  lf  = f == 0
            float R   = H - Lo
            float md  = f_med(l)
            float z   = na(md) or md <= 0 ? 0.0 : math.max(-ZMAX, math.min(ZMAX, math.log(R / md)))
            float pr  = (close[1] - Lo) / R
            float pos = math.max(0.0, math.min(1.0, lf ? pr : 1 - pr))
            array<float> x = array.from(1.0, lf ? 1.0 : 0.0, z, z * z, pos, pos * pos, wdI == 1 ? 1.0 : 0.0, wdI == 2 ? 1.0 : 0.0, wdI == 3 ? 1.0 : 0.0, wdI == 4 ? 1.0 : 0.0)
            float pOpp = f_sig(f_lin(c, 12, x))           // other side breaks first
            float pSam = f_sig(f_lin(c, 22, x))           // first-formed side breaks first
            bool  opp  = pOpp >= pSam
            float p    = opp ? pOpp : pSam
            bool  up   = opp == lf                        // favoured side is the IB high
            float y    = up ? H : Lo
            if main
                lbF := label.new(lf ? array.get(ATL, l) : array.get(ATH, l), lf ? Lo : H, lf ? "low formed first" : "high formed first", xloc = xloc.bar_time, style = lf ? label.style_label_up : label.style_label_down, color = color.new(cGray, 25), textcolor = color.white, size = size.small)
            if p >= (main ? minIn : othMin) / 100.0
                color  cc = up ? cUp : cDn
                string t  = str.tostring((l + 1) * 15) + "m · " + (up ? "High" : "Low") + " breaks first " + f_pct(p)
                array.set(FY, l, y)
                array.set(OY, l, up ? Lo : H)
                array.set(FD, l, up ? 1 : -1)
                array.set(FT, l, t)
                array.set(LN, l, line.new(time, y, time, y, xloc = xloc.bar_time, color = cc, width = 2, style = main ? line.style_solid : line.style_dotted))
                array.set(LB, l, label.new(time, y, t, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(cc, 10), textcolor = color.white, size = f_size()))
                msg += t + " @ " + str.tostring(y, format.mintick) + "\n"
                // extension beyond the other IB side (main IB only, only when that side is the favoured one)
                if main and extOn and opp and f_pext(c, x, 0.0) - dTP >= thrTP
                    float xE = na
                    float pE = na
                    for k = 1 to 20
                        float pk = f_pext(c, x, k / 10.0) - dTP
                        if pk < thrTP
                            break
                        xE := k / 10.0
                        pE := pk
                    if not na(xE)
                        eY  := y + (up ? 1 : -1) * xE * R
                        eD  := up ? 1 : -1
                        eTx := "+" + str.tostring(xE, "0.0") + " IB " + f_pct(pE)
                        eLn := line.new(time, eY, time, eY, xloc = xloc.bar_time, color = cc, width = 1, style = line.style_dashed)
                        eLb := label.new(time, eY, eTx, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(cc, 10), textcolor = color.white, size = f_size())
                        msg += eTx + " @ " + str.tostring(eY, format.mintick) + "\n"
    // run until one side breaks: ✓ favoured side first, ✗ other side first (same bar = ✗, like the stats)
    float fy = array.get(FY, l)
    if not na(fy) and not array.get(FR, l) and relNow < relEnd
        line.set_x2(array.get(LN, l), time)
        label.set_x(array.get(LB, l), time)
        int  d    = array.get(FD, l)
        float oy  = array.get(OY, l)
        bool fHit = d == 1 ? high > fy : low < fy
        bool oHit = d == 1 ? low < oy : high > oy
        if fHit or oHit
            array.set(FR, l, true)
            string t = array.get(FT, l) + (fHit and not oHit ? " ✓" : " ✗")
            label.set_text(array.get(LB, l), t)
            label.set_color(array.get(LB, l), color.new(cGray, 25))
            if not (fHit and not oHit)
                line.set_color(array.get(LN, l), color.new(cGray, 40))
            msg += t + "\n"

// extension runs until reached (✓) or session end
if not na(eY) and not eHit and relNow < relEnd
    line.set_x2(eLn, time)
    label.set_x(eLb, time)
    if eD == 1 ? high >= eY : low <= eY
        eHit := true
        label.set_text(eLb, eTx + " ✓")
        label.set_color(eLb, color.new(cGray, 25))
        msg += eTx + " ✓\n"

if alOn and msg != ""
    alert("IB-First " + mk + " · " + startIn + "\n" + msg, alert.freq_once_per_bar)
