//@version=6
indicator("AdamCapitals · Breaker + Inducement", shorttitle = "AC-BRK", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ─────────────────────────────────────────────────────────────────────────────
//  Modell nach "High RR Precision – The Adam Capitals Method":
//
//  LONG (Short genau gespiegelt):
//   1. Supply-Zone entsteht (bärischer Strukturbruch → Kerze mit dem höchsten Hoch)
//   2. Kurs SCHLIESST über der Supply  → FAILED SUPPLY = bullischer Breaker
//   3. Unmitigated Demand = Ursprung dieses Impulses (Kerze mit dem tiefsten Tief
//      seit der Supply). Dort liegt später das BUY LIMIT (Oberkante der Zone).
//   4. INDUCEMENT: nach dem Breaker bildet sich ein kleines Swing-Tief ÜBER der
//      Demand → Liquidität (LIQ). Regel: NO LIQ → NO TRADE.
//   5. Kurs holt die LIQ und tippt die Demand an → Limit gefüllt.
//      SL unter der Zone (+ Puffer), TP = 1:7 (oder nächstes Swing-Hoch),
//      Teilgewinn bei 1:4 → SL auf Break Even.
//   Max. 2 Trades pro Tag. Alles auf dem Chart-Timeframe (1m–15m).
//
//  Signale nur bei Kerzenschluss → kein Repaint.
// ─────────────────────────────────────────────────────────────────────────────

const string G_S = "Struktur"
const string G_T = "Trade"
const string G_A = "Anzeige"

int    swLen    = input.int(5, "Swing-Länge (Zonen)", minval = 2, maxval = 20, group = G_S, tooltip = "Für Supply/Demand und Strukturbrüche. Größer = weniger, wichtigere Zonen.")
int    idmLen   = input.int(2, "Swing-Länge (Inducement)", minval = 1, maxval = 10, group = G_S, tooltip = "Kleiner Pullback-Swing nach dem Breaker, der als Liquidität (LIQ) dient.")
int    maxWait  = input.int(240, "Setup verfällt nach (Kerzen)", minval = 10, group = G_S)

string tpMode   = input.string("Fix (R)", "Take Profit", options = ["Fix (R)", "Swing-Liquidität"], group = G_T, tooltip = "Swing-Liquidität: nächstes Swing-Hoch/-Tief, das mindestens 'Min. R' bringt. Sonst Fix (R).")
float  rrTP     = input.float(7.0, "TP (R)", minval = 1, step = 0.5, group = G_T)
float  rrMin    = input.float(3.0, "Min. R für Swing-TP", minval = 1, step = 0.5, group = G_T)
float  rrPart   = input.float(4.0, "Teilgewinn + BE bei (R)", minval = 0, step = 0.5, group = G_T, tooltip = "0 = aus")
int    bufTicks = input.int(2, "SL-Puffer (Ticks)", minval = 0, group = G_T)
float  maxSLATR = input.float(0, "Max. SL (× ATR 14, 0 = aus)", minval = 0, step = 0.5, group = G_T, tooltip = "Zu großer SL → Setup auslassen und auf kleinerem Timeframe verfeinern.")
int    maxDay   = input.int(2, "Max. Trades pro Tag", minval = 1, group = G_T)
bool   useSess  = input.bool(false, "Nur in der Handelszeit füllen", group = G_T)
string sess     = input.session("0930-1600", "Handelszeit (New York)", group = G_T)

bool   showZn   = input.bool(true, "Supply/Demand-Zonen zeigen", group = G_A)
int    maxZn    = input.int(6, "Max. Zonen je Seite", minval = 1, maxval = 30, group = G_A)
color  cDem     = input.color(color.new(#089981, 85), "Demand", inline = "z", group = G_A)
color  cSup     = input.color(color.new(#f23645, 85), "Supply", inline = "z", group = G_A)
color  cBrk     = input.color(color.new(#2962ff, 80), "Breaker", inline = "z", group = G_A)
bool   showTbl  = input.bool(true, "Statistik-Tabelle", group = G_A)
bool   alertOn  = input.bool(true, "alert() aktiv", group = G_A, tooltip = "Alarm anlegen: Bedingung 'AC-BRK' → 'Jeder alert()-Funktionsaufruf'.")

// ═══════════════════════════ BASIS ═══════════════════════════
float atr    = ta.atr(14)
float ph     = ta.pivothigh(high, swLen, swLen)
float pl     = ta.pivotlow(low, swLen, swLen)
float iph    = ta.pivothigh(high, idmLen, idmLen)
float ipl    = ta.pivotlow(low, idmLen, idmLen)
bool  newDay = timeframe.change("D")
bool  inSess = not useSess or not na(time(timeframe.period, sess, "America/New_York"))
float tick   = syminfo.mintick

f_px(float p) => str.tostring(p, format.mintick)
f_alert(string msg) =>
    if alertOn
        alert(syminfo.ticker + " · " + msg, alert.freq_once_per_bar_close)

// Letzte Swing-Hochs/-Tiefs (für Swing-TP)
var array<float> swHs = array.new<float>()
var array<float> swLs = array.new<float>()

// ═══════════════════════════ ZONEN ═══════════════════════════
var float swH  = na
var int   swHi = na
var float swL  = na
var int   swLi = na

var array<float> supT = array.new<float>()
var array<float> supB = array.new<float>()
var array<int>   supI = array.new<int>()
var array<box>   supX = array.new<box>()
var array<float> demT = array.new<float>()
var array<float> demB = array.new<float>()
var array<int>   demI = array.new<int>()
var array<box>   demX = array.new<box>()

f_addZone(array<float> t, array<float> b, array<int> ix, array<box> bx, float top, float bot, int idx, int tm, color c, string txt) =>
    array.push(t, top)
    array.push(b, bot)
    array.push(ix, idx)
    array.push(bx, showZn ? box.new(tm, top, time, bot, xloc = xloc.bar_time, extend = extend.right, bgcolor = c, border_color = color.new(c, 50), text = txt, text_size = size.tiny, text_color = color.new(c, 20), text_halign = text.align_left) : na)
    if array.size(t) > maxZn
        array.shift(t)
        array.shift(b)
        array.shift(ix)
        box.delete(array.shift(bx))

// ═══════════════════════════ SETUP-ZUSTAND ═══════════════════════════
// Zustand: 0 = nichts · 1 = Breaker da, warte auf Inducement · 2 = LIQ da, Limit liegt
var int   lSt  = 0
var float lTop = na
var float lBot = na
var int   lBar = na
var float lIdm = na
var box   lBx  = na
var line  lLn  = na
var int   sSt  = 0
var float sTop = na
var float sBot = na
var int   sBar = na
var float sIdm = na
var box   sBx  = na
var line  sLn  = na

// Offener Trade
var int   tDir  = 0
var float tE    = na
var float tSL   = na
var float tTP   = na
var float tP    = na
var float tR    = na
var bool  tPart = false
var box   tWin  = na
var box   tLos  = na
var line  tPLn  = na
var int   dayN  = 0

// Statistik
var int   stSet = 0
var int   stTr  = 0
var int   stW   = 0
var int   stL   = 0
var int   stBE  = 0
var float stR   = 0.0

if newDay
    dayN := 0

f_clear(box b, line l) =>
    box.delete(b)
    line.delete(l)

if barstate.isconfirmed and not na(atr)
    // ─── Swings merken ───
    if not na(ph)
        swH  := ph
        swHi := bar_index - swLen
        array.push(swHs, ph)
        if array.size(swHs) > 20
            array.shift(swHs)
    if not na(pl)
        swL  := pl
        swLi := bar_index - swLen
        array.push(swLs, pl)
        if array.size(swLs) > 20
            array.shift(swLs)

    // ─── Neue Zonen aus Strukturbrüchen ───
    if not na(swH) and close > swH
        int   n  = math.max(1, math.min(bar_index - swHi, 300))
        float lo = low
        int   k  = 0
        for i = 1 to n
            if low[i] < lo
                lo := low[i]
                k  := i
        f_addZone(demT, demB, demI, demX, high[k], low[k], bar_index - k, time[k], cDem, "Demand")
        swH := na
    if not na(swL) and close < swL
        int   n  = math.max(1, math.min(bar_index - swLi, 300))
        float hi = high
        int   k  = 0
        for i = 1 to n
            if high[i] > hi
                hi := high[i]
                k  := i
        f_addZone(supT, supB, supI, supX, high[k], low[k], bar_index - k, time[k], cSup, "Supply")
        swL := na

    // ─── FAILED SUPPLY → bullischer Breaker → Long-Setup ───
    int nS = array.size(supT)
    if nS > 0
        for j = nS - 1 to 0
            if close > array.get(supT, j)
                // Ursprung des Impulses = unmitigated Demand
                int   n  = math.max(1, math.min(bar_index - array.get(supI, j), 300))
                float lo = low
                int   k  = 0
                for i = 1 to n
                    if low[i] < lo
                        lo := low[i]
                        k  := i
                box zb = array.get(supX, j)
                if not na(zb)
                    box.set_extend(zb, extend.none)
                    box.set_right(zb, time)
                    box.set_bgcolor(zb, cBrk)
                    box.set_border_color(zb, color.new(cBrk, 40))
                    box.set_text(zb, "Failed Supply → Breaker")
                    box.set_text_color(zb, color.new(cBrk, 0))
                array.remove(supT, j)
                array.remove(supB, j)
                array.remove(supI, j)
                array.remove(supX, j)
                if tDir == 0
                    if lSt != 0
                        f_clear(lBx, lLn)
                    lSt  := 1
                    lTop := high[k]
                    lBot := low[k]
                    lBar := bar_index
                    lIdm := na
                    lBx  := box.new(time[k], lTop, time, lBot, xloc = xloc.bar_time, extend = extend.right, bgcolor = color.new(#089981, 70), border_color = #089981, text = "Unmitigated Demand", text_size = size.tiny, text_color = #089981, text_halign = text.align_left)
                    lLn  := na
                    f_alert("Failed Supply → Breaker. Warte auf Inducement über " + f_px(lTop))
                break

    // ─── FAILED DEMAND → bärischer Breaker → Short-Setup ───
    int nD = array.size(demT)
    if nD > 0
        for j = nD - 1 to 0
            if close < array.get(demB, j)
                int   n  = math.max(1, math.min(bar_index - array.get(demI, j), 300))
                float hi = high
                int   k  = 0
                for i = 1 to n
                    if high[i] > hi
                        hi := high[i]
                        k  := i
                box zb = array.get(demX, j)
                if not na(zb)
                    box.set_extend(zb, extend.none)
                    box.set_right(zb, time)
                    box.set_bgcolor(zb, cBrk)
                    box.set_border_color(zb, color.new(cBrk, 40))
                    box.set_text(zb, "Failed Demand → Breaker")
                    box.set_text_color(zb, color.new(cBrk, 0))
                array.remove(demT, j)
                array.remove(demB, j)
                array.remove(demI, j)
                array.remove(demX, j)
                if tDir == 0
                    if sSt != 0
                        f_clear(sBx, sLn)
                    sSt  := 1
                    sTop := high[k]
                    sBot := low[k]
                    sBar := bar_index
                    sIdm := na
                    sBx  := box.new(time[k], sTop, time, sBot, xloc = xloc.bar_time, extend = extend.right, bgcolor = color.new(#f23645, 70), border_color = #f23645, text = "Unmitigated Supply", text_size = size.tiny, text_color = #f23645, text_halign = text.align_left)
                    sLn  := na
                    f_alert("Failed Demand → Breaker. Warte auf Inducement unter " + f_px(sBot))
                break

    // ─── Inducement suchen (kleines Swing-Tief über der Demand / -Hoch unter der Supply) ───
    if lSt == 1 and not na(ipl) and bar_index - idmLen > lBar and ipl > lTop
        lSt  := 2
        lIdm := ipl
        lLn  := line.new(time[idmLen], ipl, time, ipl, xloc = xloc.bar_time, extend = extend.right, color = #ff9800, style = line.style_dotted, width = 1)
        label.new(time[idmLen], ipl, "LIQ", xloc = xloc.bar_time, style = label.style_label_up, color = color.new(#ff9800, 20), textcolor = color.white, size = size.tiny)
        stSet += 1
        f_alert("▲ LONG-Setup scharf · BUY LIMIT " + f_px(lTop) + " · SL " + f_px(lBot - bufTicks * tick) + " · LIQ " + f_px(ipl))
    if sSt == 1 and not na(iph) and bar_index - idmLen > sBar and iph < sBot
        sSt  := 2
        sIdm := iph
        sLn  := line.new(time[idmLen], iph, time, iph, xloc = xloc.bar_time, extend = extend.right, color = #ff9800, style = line.style_dotted, width = 1)
        label.new(time[idmLen], iph, "LIQ", xloc = xloc.bar_time, style = label.style_label_down, color = color.new(#ff9800, 20), textcolor = color.white, size = size.tiny)
        stSet += 1
        f_alert("▼ SHORT-Setup scharf · SELL LIMIT " + f_px(sBot) + " · SL " + f_px(sTop + bufTicks * tick) + " · LIQ " + f_px(iph))

    // ─── Offenen Trade verwalten ───
    if tDir != 0
        bool  hSL = tDir == 1 ? low <= tSL : high >= tSL
        bool  hTP = tDir == 1 ? high >= tTP : low <= tTP
        bool  hP  = rrPart > 0 and not tPart and (tDir == 1 ? high >= tP : low <= tP)
        float res = na
        if hSL
            res := tPart ? 0.5 * rrPart : -1.0
        else if hTP
            res := tPart ? 0.5 * rrPart + 0.5 * (tTP - tE) * tDir / tR : (tTP - tE) * tDir / tR
        else if hP
            tPart := true
            line.set_color(tPLn, color.new(color.white, 40))
            f_alert("Teilgewinn " + str.tostring(rrPart) + "R · SL auf Break Even " + f_px(tE))
            tSL   := tE
        if not na(res)
            box.set_extend(tWin, extend.none)
            box.set_right(tWin, time)
            box.set_extend(tLos, extend.none)
            box.set_right(tLos, time)
            line.set_extend(tPLn, extend.none)
            line.set_x2(tPLn, time)
            string txt = (res > 0 ? "+" : "") + str.tostring(res, "#.#") + "R"
            label.new(time, tDir == 1 ? (hSL ? low : high) : (hSL ? high : low), txt, xloc = xloc.bar_time, style = (tDir == 1) == hSL ? label.style_label_up : label.style_label_down, color = res > 0.01 ? #089981 : res < -0.01 ? #f23645 : color.gray, textcolor = color.white, size = size.small)
            stR += res
            if hSL and not tPart
                stL += 1
            else if hTP
                stW += 1
            else
                stBE += 1
            f_alert("Trade beendet: " + txt)
            tDir := 0

    // ─── Limit-Füllung: Kurs holt die LIQ und tippt die Zone an ───
    bool canFill = tDir == 0 and inSess and dayN < maxDay
    int  fillDir = 0
    if lSt == 1 and low <= lTop
        f_clear(lBx, lLn)
        lSt := 0      // Zone angetippt ohne Inducement → NO LIQ, NO TRADE
    if sSt == 1 and high >= sBot
        f_clear(sBx, sLn)
        sSt := 0
    if lSt == 2 and low <= lTop
        fillDir := canFill ? 1 : 0
        if not canFill
            f_clear(lBx, lLn)
            lSt := 0
    if sSt == 2 and high >= sBot and fillDir == 0
        fillDir := canFill ? -1 : 0
        if not canFill
            f_clear(sBx, sLn)
            sSt := 0

    if fillDir != 0
        float e  = fillDir == 1 ? math.min(lTop, open) : math.max(sBot, open)
        float sl = fillDir == 1 ? lBot - bufTicks * tick : sTop + bufTicks * tick
        float r  = math.abs(e - sl)
        bool  ok = r > 0 and (maxSLATR == 0 or r <= maxSLATR * atr)
        if ok
            float tp = e + fillDir * rrTP * r
            if tpMode == "Swing-Liquidität"
                array<float> src = fillDir == 1 ? swHs : swLs
                float best = na
                int   ns   = array.size(src)
                if ns > 0
                    for i = 0 to ns - 1
                        float v = array.get(src, i)
                        if fillDir * (v - e) >= rrMin * r and (na(best) or fillDir * (v - best) < 0)
                            best := v
                tp := na(best) ? tp : best
            tDir  := fillDir
            tE    := e
            tSL   := sl
            tTP   := tp
            tR    := r
            tP    := e + fillDir * rrPart * r
            tPart := false
            dayN  += 1
            stTr  += 1
            tWin  := box.new(time, math.max(e, tp), time, math.min(e, tp), xloc = xloc.bar_time, extend = extend.right, bgcolor = color.new(#089981, 80), border_color = color.new(#089981, 60))
            tLos  := box.new(time, math.max(e, sl), time, math.min(e, sl), xloc = xloc.bar_time, extend = extend.right, bgcolor = color.new(#f23645, 75), border_color = color.new(#f23645, 60))
            tPLn  := rrPart > 0 ? line.new(time, tP, time, tP, xloc = xloc.bar_time, extend = extend.right, color = color.new(#089981, 20), style = line.style_dashed) : na
            label.new(time, e, (fillDir == 1 ? "BUY " : "SELL ") + f_px(e) + " · 1:" + str.tostring((tp - e) * fillDir / r, "#.#"), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(#131722, 10), textcolor = color.white, size = size.tiny)
            f_alert((fillDir == 1 ? "▲ LONG gefüllt " : "▼ SHORT gefüllt ") + f_px(e) + " · SL " + f_px(sl) + " · TP " + f_px(tp))
            // Füllkerze trifft direkt den SL → sofort Verlust (konservativ)
            if fillDir == 1 ? low <= sl : high >= sl
                box.set_extend(tWin, extend.none)
                box.set_extend(tLos, extend.none)
                line.delete(tPLn)
                label.new(time, fillDir == 1 ? low : high, "-1R", xloc = xloc.bar_time, style = fillDir == 1 ? label.style_label_up : label.style_label_down, color = #f23645, textcolor = color.white, size = size.small)
                stL  += 1
                stR  -= 1.0
                tDir := 0
        if fillDir == 1
            box.set_extend(lBx, extend.none)
            box.set_right(lBx, time)
            line.set_extend(lLn, extend.none)
            line.set_x2(lLn, time)
            lSt := 0
        else
            box.set_extend(sBx, extend.none)
            box.set_right(sBx, time)
            line.set_extend(sLn, extend.none)
            line.set_x2(sLn, time)
            sSt := 0

    // ─── Setups verfallen lassen ───
    if lSt != 0 and bar_index - lBar > maxWait
        f_clear(lBx, lLn)
        lSt := 0
    if sSt != 0 and bar_index - sBar > maxWait
        f_clear(sBx, sLn)
        sSt := 0

// ═══════════════════════════ STATISTIK ═══════════════════════════
var table tb = table.new(position.top_right, 2, 7, bgcolor = #131722, frame_color = #2a2e39, frame_width = 1, border_color = #2a2e39, border_width = 1)
if barstate.islast and showTbl
    int    nDone = stW + stL + stBE
    string st    = tDir == 1 ? "▲ im Long" : tDir == -1 ? "▼ im Short" : lSt == 2 ? "▲ BUY LIMIT " + f_px(lTop) : sSt == 2 ? "▼ SELL LIMIT " + f_px(sBot) : lSt == 1 or sSt == 1 ? "Breaker · warte auf LIQ" : "–"
    array<string> k = array.from("Status", "Setups mit LIQ", "Trades", "TP erreicht", "SL", "Break Even", "Summe")
    array<string> v = array.from(st, str.tostring(stSet), str.tostring(stTr), str.tostring(stW) + (nDone > 0 ? "  (" + str.tostring(100.0 * stW / nDone, "#") + " %)" : ""), str.tostring(stL), str.tostring(stBE), (stR >= 0 ? "+" : "") + str.tostring(stR, "#.#") + " R")
    for i = 0 to 6
        table.cell(tb, 0, i, array.get(k, i), text_color = #8a8f9c, text_size = size.small, text_halign = text.align_left)
        table.cell(tb, 1, i, array.get(v, i), text_color = i == 6 ? (stR >= 0 ? #4caf50 : #ff5252) : #d1d4dc, text_size = size.small, text_halign = text.align_left)
