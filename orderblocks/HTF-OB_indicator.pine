//@version=6
indicator("1H Orderblocks", shorttitle = "1H OB", overlay = true, max_boxes_count = 500)

// ─────────────────────────────────────────────────────────────────────────────
//  Zeigt Orderblocks aus dem 1h-Chart auf jedem kleineren Chart (1m, 5m, 15m …).
//
//  Bullischer OB: 1h schließt ÜBER dem letzten Swing-Hoch (Strukturbruch).
//                 OB = die Kerze mit dem tiefsten Tief seit diesem Swing-Hoch
//                 (dort haben die Käufer die Bewegung gestartet).
//  Bärischer OB:  1h schließt UNTER dem letzten Swing-Tief.
//                 OB = die Kerze mit dem höchsten Hoch seit diesem Swing-Tief.
//
//  Ein OB erscheint erst, wenn die 1h-Kerze mit dem Bruch GESCHLOSSEN ist
//  → kein Repaint. Gebrochen = Schluss (oder Docht) durch die andere Seite der Zone.
// ─────────────────────────────────────────────────────────────────────────────

const string G_D = "Erkennung"
const string G_A = "Anzeige"

string htf      = input.timeframe("60", "Timeframe der Orderblocks", group = G_D)
int    swLen    = input.int(5, "Swing-Länge", minval = 1, maxval = 20, group = G_D, tooltip = "Ein Swing-Hoch braucht so viele niedrigere Kerzen links UND rechts. Größer = weniger, dafür wichtigere Orderblocks.")
string zoneMode = input.string("Ganze Kerze", "Zone", options = ["Ganze Kerze", "Nur Körper"], group = G_D)
string brkSrc   = input.string("Schlusskurs", "Ungültig bei", options = ["Schlusskurs", "Docht"], group = G_D, tooltip = "Schlusskurs: OB ist erst gebrochen, wenn eine Kerze jenseits der Zone SCHLIESST. Docht: schon ein Durchstechen reicht.")

int    maxShow  = input.int(5, "Max. OBs je Richtung", minval = 1, maxval = 50, group = G_A)
bool   keepBrk  = input.bool(false, "Gebrochene OBs grau stehen lassen", group = G_A)
color  colBull  = input.color(color.new(#089981, 80), "Bullisch", inline = "c", group = G_A)
color  colBear  = input.color(color.new(#f23645, 80), "Bärisch",  inline = "c", group = G_A)
color  colBrk   = input.color(color.new(color.gray, 88), "Gebrochen", inline = "c", group = G_A)
bool   showLbl  = input.bool(true, "Beschriftung", group = G_A)
bool   alertOn  = input.bool(true, "alert() bei erster Berührung", group = G_A, tooltip = "Alarm anlegen: Bedingung '1H OB' → 'Jeder alert()-Funktionsaufruf'.")

// ═══════════════════════════ ERKENNUNG (läuft auf dem 1h-Chart) ═══════════════════════════
f_ob(int len, bool body) =>
    float ph = ta.pivothigh(high, len, len)
    float pl = ta.pivotlow(low, len, len)
    var float swH  = na
    var int   swHi = na
    var float swL  = na
    var int   swLi = na
    if not na(ph)
        swH  := ph
        swHi := bar_index - len
    if not na(pl)
        swL  := pl
        swLi := bar_index - len

    float bT  = na
    float bB  = na
    int   bTm = na
    float sT  = na
    float sB  = na
    int   sTm = na

    // Bruch über das Swing-Hoch → Kerze mit dem tiefsten Tief seit dem Swing = bullischer OB
    if not na(swH) and close > swH
        int   n  = math.max(1, math.min(bar_index - swHi, 200))
        float lo = low
        int   k  = 0
        for i = 1 to n
            if low[i] < lo
                lo := low[i]
                k  := i
        bT  := body ? math.max(open[k], close[k]) : high[k]
        bB  := body ? math.min(open[k], close[k]) : low[k]
        bTm := time[k]
        swH := na

    // Bruch unter das Swing-Tief → Kerze mit dem höchsten Hoch seit dem Swing = bärischer OB
    if not na(swL) and close < swL
        int   n  = math.max(1, math.min(bar_index - swLi, 200))
        float hi = high
        int   k  = 0
        for i = 1 to n
            if high[i] > hi
                hi := high[i]
                k  := i
        sT  := body ? math.max(open[k], close[k]) : high[k]
        sB  := body ? math.min(open[k], close[k]) : low[k]
        sTm := time[k]
        swL := na

    // [1] + lookahead_on = Wert der letzten GESCHLOSSENEN 1h-Kerze → kein Repaint
    [bT[1], bB[1], bTm[1], sT[1], sB[1], sTm[1]]

[bT, bB, bTm, sT, sB, sTm] = request.security(syminfo.tickerid, htf, f_ob(swLen, zoneMode == "Nur Körper"), lookahead = barmerge.lookahead_on)

bool newBull = not na(bTm) and (na(bTm[1]) or bTm != bTm[1])
bool newBear = not na(sTm) and (na(sTm[1]) or sTm != sTm[1])

// ═══════════════════════════ ZEICHNEN + VERWALTEN ═══════════════════════════
string tfLbl = htf == "60" ? "1H" : htf == "240" ? "4H" : htf == "30" ? "30m" : htf == "15" ? "15m" : htf
bool   tfBad = timeframe.in_seconds() > timeframe.in_seconds(htf)

var array<box>  bullBx  = array.new<box>()
var array<bool> bullAct = array.new<bool>()
var array<bool> bullHit = array.new<bool>()
var array<box>  bearBx  = array.new<box>()
var array<bool> bearAct = array.new<bool>()
var array<bool> bearHit = array.new<bool>()

f_new(array<box> bxs, array<bool> act, array<bool> hit, int t, float top, float bot, color c, string txt) =>
    box b = box.new(t, top, time, bot, xloc = xloc.bar_time, extend = extend.right, bgcolor = c, border_color = color.new(c, 40), text = showLbl ? txt : "", text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_center, text_color = color.new(c, 0))
    array.push(bxs, b)
    array.push(act, true)
    array.push(hit, false)
    if array.size(bxs) > maxShow
        array.shift(act)
        array.shift(hit)
        box.delete(array.shift(bxs))

// dir = 1 bullisch (bricht nach unten), -1 bärisch (bricht nach oben)
f_manage(array<box> bxs, array<bool> act, array<bool> hit, int dir, string txt) =>
    int n = array.size(bxs)
    if n > 0
        for i = n - 1 to 0
            if array.get(act, i)
                box   bx  = array.get(bxs, i)
                float top = box.get_top(bx)
                float bot = box.get_bottom(bx)
                bool  brk = brkSrc == "Schlusskurs" ? barstate.isconfirmed and (dir == 1 ? close < bot : close > top) : (dir == 1 ? low < bot : high > top)
                if brk
                    if keepBrk
                        box.set_extend(bx, extend.none)
                        box.set_right(bx, time)
                        box.set_bgcolor(bx, colBrk)
                        box.set_border_color(bx, colBrk)
                        box.set_text_color(bx, color.new(color.gray, 40))
                        array.set(act, i, false)
                    else
                        array.remove(bxs, i)
                        array.remove(act, i)
                        array.remove(hit, i)
                        box.delete(bx)
                else if not array.get(hit, i) and (dir == 1 ? low <= top : high >= bot)
                    array.set(hit, i, true)
                    if alertOn
                        alert(syminfo.ticker + " berührt " + txt + " " + str.tostring(bot, format.mintick) + " – " + str.tostring(top, format.mintick), alert.freq_once_per_bar)

if not tfBad
    if newBull
        f_new(bullBx, bullAct, bullHit, bTm, bT, bB, colBull, tfLbl + " OB ▲")
    if newBear
        f_new(bearBx, bearAct, bearHit, sTm, sT, sB, colBear, tfLbl + " OB ▼")
    f_manage(bullBx, bullAct, bullHit, 1,  "bullischen " + tfLbl + " OB")
    f_manage(bearBx, bearAct, bearHit, -1, "bärischen " + tfLbl + " OB")

var table warn = table.new(position.top_right, 1, 1)
if barstate.islast and tfBad
    table.cell(warn, 0, 0, "Chart-Timeframe muss ≤ " + tfLbl + " sein", text_color = color.white, bgcolor = color.new(color.red, 20), text_size = size.small)
