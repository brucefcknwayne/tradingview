//@version=6
indicator("Zera Heatmap · Volumen-Kerzen", shorttitle = "ZeraHM 500V", overlay = true)

// ─────────────────────────────────────────────────────────────────────────────
//  MotiveWave "ZeraHeatmap" auf 500-Volumen-Kerzen – nachgebaut in TradingView.
//
//  TradingView hat keine Volumen-Kerzen. Deshalb baut das Skript sie selbst:
//  Es holt die Sekunden-Daten (1S) jeder Chart-Kerze und schneidet daraus
//  Kerzen mit je 500 Kontrakten (Überhang wandert in die nächste Kerze).
//  Auf diesen Volumen-Kerzen läuft exakt die Zera-Formel:
//
//   src = OHLC4,  z = (src − SMA(src, 50)) / StdAbw(src, 50)   (Populations-StdAbw)
//   |z| <  T1  → Neutral,  |z| >= T2 → Magenta,  dazwischen Cyan → Magenta
//   (Farbe hängt nur vom Betrag ab – Hochs und Tiefs gleich.)
//
//  Signal: Sobald eine fertige Volumen-Kerze wieder NEUTRAL ist und die davor
//  Cyan/Magenta war → Dreieck unter der TradingView-Kerze, in der das passiert.
//
//  Empfehlung: NQ1! / MNQ1!, Chart 1m (oder Sekunden-Chart), Intrabar "1S".
//  Sekunden-Daten brauchen ein TradingView-Abo mit Sekunden-Intervallen.
// ─────────────────────────────────────────────────────────────────────────────

const string G_V = "Volumen-Kerzen"
const string G_Z = "Z-Score"
const string G_C = "Farben"
const string G_S = "Signal"

int    volSize  = input.int(500, "Volumen pro Kerze", minval = 1, group = G_V)
string ltf      = input.timeframe("1S", "Intrabar-Daten", group = G_V, tooltip = "Woraus die Volumen-Kerzen gebaut werden. 1S = so nah wie möglich an MotiveWave. Muss kleiner als der Chart-Timeframe sein.")
bool   resetSes = input.bool(false, "Zählung bei Sessionstart neu beginnen", group = G_V, tooltip = "Verwirft die angefangene Volumen-Kerze beim Sessionstart.")

int   len  = input.int(50, "Lookback", minval = 2, maxval = 2000, group = G_Z)
float t1   = input.float(2.0, "Threshold T1", minval = 0.1, maxval = 100, step = 0.1, group = G_Z, inline = "t")
float t2   = input.float(3.0, "Threshold T2", minval = 0.1, maxval = 100, step = 0.1, group = G_Z, inline = "t")

color cNeg   = input.color(color.rgb(45, 171, 173), "Cyan (T1)", group = G_C)
color cPos   = input.color(color.rgb(229, 5, 255), "Magenta (T2)", group = G_C)
color cNeu   = input.color(color.rgb(51, 51, 51), "Neutral", group = G_C)
bool  paint  = input.bool(true, "Chart-Kerzen einfärben", group = G_C)
string pMode = input.string("Stärkste Volumen-Kerze", "Farbe der Chart-Kerze", options = ["Stärkste Volumen-Kerze", "Letzte Volumen-Kerze"], group = G_C, tooltip = "Eine 1m-Kerze kann mehrere 500V-Kerzen enthalten.")

bool  showSig = input.bool(true, "Dreieck bei Rückkehr zu Neutral", group = G_S)
color sigCol  = input.color(color.yellow, "Dreieck-Farbe", group = G_S)
bool  showTbl = input.bool(true, "Info-Tabelle", group = G_S)

// ── Farbe exakt wie MotiveWave (lineare RGB-Interpolation, gerundet) ────────
mix(float a, float b, float f) =>
    math.max(0, math.min(255, math.round(a + (b - a) * f)))

heatColor(float zz) =>
    color c = na
    if not na(zz)
        float az = math.abs(zz)
        if az < t1
            c := cNeu
        else if az >= t2
            c := cPos
        else
            float f = math.max(0.0, math.min(1.0, (az - t1) / (t2 - t1)))
            c := color.rgb(mix(color.r(cNeg), color.r(cPos), f), mix(color.g(cNeg), color.g(cPos), f), mix(color.b(cNeg), color.b(cPos), f))
    c

// ── Intrabar-Daten ───────────────────────────────────────────────────────────
[aO, aH, aL, aC, aV] = request.security_lower_tf(syminfo.tickerid, ltf, [open, high, low, close, volume])

// ── Zustand der Volumen-Kerzen ───────────────────────────────────────────────
var array<float> hist = array.new_float()       // OHLC4 der letzten "len" fertigen Volumen-Kerzen
var bool  vbOpen  = false
var float vbO     = na
var float vbH     = na
var float vbL     = na
var float vbC     = na
var float vbV     = 0.0
var int   vbCount = 0
var bool  lastHot = false
var float lastZ   = na

if resetSes and session.isfirstbar
    vbOpen := false
    vbV    := 0.0

float zMax = na          // stärkster |z| in dieser Chart-Kerze
float zEnd = na          // letzter z in dieser Chart-Kerze
int   sigN = 0           // Anzahl Rückkehr-zu-Neutral in dieser Chart-Kerze

int n = aC.size()
if n > 0
    for i = 0 to n - 1
        float v = nz(aV.get(i))
        if v <= 0
            continue
        if not vbOpen
            vbO    := aO.get(i)
            vbH    := aH.get(i)
            vbL    := aL.get(i)
            vbOpen := true
        else
            vbH := math.max(vbH, aH.get(i))
            vbL := math.min(vbL, aL.get(i))
        vbC := aC.get(i)
        vbV += v
        // Volumen-Kerze(n) abschließen
        while vbV >= volSize
            float x = (vbO + vbH + vbL + vbC) / 4.0
            hist.push(x)
            if hist.size() > len
                hist.shift()
            vbCount += 1
            if vbCount > len                        // wie MotiveWave: erst ab Index >= Lookback
                float m  = hist.avg()
                float sd = hist.stdev()             // biased = Populations-StdAbw
                float z  = sd != 0 ? (x - m) / sd : 0.0
                bool hot = math.abs(z) >= t1
                if lastHot and not hot
                    sigN += 1
                lastHot := hot
                lastZ   := z
                zEnd    := z
                if na(zMax) or math.abs(z) > math.abs(zMax)
                    zMax := z
            vbV -= volSize
            if vbV > 0                              // Überhang startet die nächste Kerze
                vbO := vbC
                vbH := vbC
                vbL := vbC
            else
                vbOpen := false

// ── Anzeige ──────────────────────────────────────────────────────────────────
float zShow = pMode == "Stärkste Volumen-Kerze" ? zMax : zEnd
if na(zShow)
    zShow := lastZ                                  // keine Volumen-Kerze fertig → Farbe halten
barcolor(paint ? heatColor(zShow) : na, title = "Heatmap")

bool backNeu = sigN > 0
plotshape(showSig and backNeu, "Zurück zu Neutral", shape.triangleup, location.belowbar, sigCol, size = size.tiny)
plot(lastZ, "Z-Score (letzte Volumen-Kerze)", display = display.data_window)

alertcondition(backNeu, "Zera: zurück zu Neutral", "Zera Heatmap 500V: Farbe wieder neutral – {{ticker}} {{close}}")

var table tbl = table.new(position.top_right, 2, 3, bgcolor = color.new(color.black, 20), border_width = 1)
if showTbl and barstate.islast
    string st = n == 0 and vbCount == 0 ? "keine " + ltf + "-Daten" : str.tostring(vbCount)
    table.cell(tbl, 0, 0, "Volumen-Kerzen", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 0, st, text_color = color.white, text_size = size.small)
    table.cell(tbl, 0, 1, "Z letzte", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 1, na(lastZ) ? "–" : str.tostring(lastZ, "#.##"), text_color = color.white, bgcolor = heatColor(lastZ), text_size = size.small)
    table.cell(tbl, 0, 2, "laufend", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 2, str.tostring(vbV, "#") + " / " + str.tostring(volSize), text_color = color.white, text_size = size.small)
