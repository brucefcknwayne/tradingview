//@version=6
indicator("Gotham Cracks Levels", shorttitle = "Cracks", overlay = true, max_lines_count = 500, max_labels_count = 500)
plot(na, "dummy", display = display.none)   // Pflicht-Output, zeichnet nichts

// ═════════════════════════════════════════════════════════════════════════
// Zeigt die Cracks-Levels aus MotiveWave als weiße Linien mit Label rechts
// ("5M  7788.25"). Die Levels werden eingefügt, nicht berechnet.
//
// Format (Gruppen mit ; oder Zeilenumbruch trennen, Dezimalpunkt):
//   7D=7788.25,7801.50;30D=7650.00;60D=7512.25;90D=7400.75
// oder eine Zeile pro Level:
//   5M 7788.25
//   30D 7650.00
//
// Dazu die Multi-Timeframe-RSI-Tabelle aus dem Gotham Signals Indi.
// ═════════════════════════════════════════════════════════════════════════

// ─────────────── Levels ───────────────
txtAll     = input.text_area("", "Cracks-Levels einfügen", group = "Cracks", tooltip = "TAG=Preis,Preis;TAG=Preis   Beispiel: 7D=7788.25,7801.5;30D=7650\nOder eine Zeile pro Level: 5M 7788.25")
onlyTags   = input.string("", "Nur diese Tags zeigen (leer = alle)", group = "Cracks", tooltip = "Komma-getrennt, z. B. 7D,30D")
lvlColor   = input.color(color.white, "Farbe", group = "Cracks - Stil")
lvlWidth   = input.int(1, "Linienbreite", minval = 1, maxval = 5, group = "Cracks - Stil")
styleIn    = input.string("Durchgezogen", "Linienstil", options = ["Durchgezogen", "Gestrichelt", "Gepunktet"], group = "Cracks - Stil")
showLabels = input.bool(true, "Labels zeigen", group = "Cracks - Stil")
lookBack   = input.int(1500, "Linie X Kerzen nach links", minval = 20, maxval = 5000, group = "Cracks - Stil")
extendBars = input.int(20, "Linie X Kerzen nach rechts", minval = 0, maxval = 300, group = "Cracks - Stil")
maxDistPct = input.float(0.0, "Levels weiter als X% vom Preis ausblenden", minval = 0.0, step = 0.5, group = "Cracks - Stil", tooltip = "0 = alle zeigen.")

// ─────────────── RSI ───────────────
rsiLen     = input.int(14, "RSI length", minval = 2, group = "RSI")
rsiOB      = input.float(70.0, "Overbought (for shorts)", minval = 50.0, maxval = 100.0, step = 1.0, group = "RSI")
rsiOS      = input.float(30.0, "Oversold (for longs)", minval = 0.0, maxval = 50.0, step = 1.0, group = "RSI")
showRsiTbl = input.bool(true, "Show the multi-timeframe RSI table", group = "RSI")
rsiTblPos  = input.string("Middle right", "RSI table position", options = ["Middle right", "Middle left", "Bottom right", "Bottom left", "Top left", "Top right"], group = "RSI")

// ─────────────── Level drawing ───────────────
var array<line>  dLines  = array.new<line>()
var array<label> dLabels = array.new<label>()

lineStyle = styleIn == "Gestrichelt" ? line.style_dashed : styleIn == "Gepunktet" ? line.style_dotted : line.style_solid

tagVisible(string tag) =>
    f = str.upper(str.replace_all(onlyTags, " ", ""))
    str.length(f) == 0 or str.contains("," + f + ",", "," + str.upper(tag) + ",")

drawOne(float px, string tag) =>
    inRange = maxDistPct <= 0 or math.abs(px - close) <= close * maxDistPct / 100.0
    if px > 0 and inRange and tagVisible(tag)
        array.push(dLines, line.new(math.max(0, bar_index - lookBack), px, bar_index + extendBars, px, xloc = xloc.bar_index, color = lvlColor, style = lineStyle, width = lvlWidth))
        if showLabels
            body = (str.length(tag) > 0 ? tag + "  " : "") + str.tostring(px, format.mintick)
            array.push(dLabels, label.new(bar_index + extendBars, px, body, xloc = xloc.bar_index, style = label.style_label_left, color = color.new(color.black, 100), textcolor = lvlColor, size = size.normal))

drawAll(string txt) =>
    norm = str.replace_all(str.replace_all(txt, "\r", ""), "\n", ";")
    for grp in str.split(norm, ";")
        g  = str.trim(grp)
        ei = str.pos(g, "=")
        if str.length(g) > 0
            if not na(ei)
                // TAG=Preis,Preis
                tag = str.upper(str.trim(str.substring(g, 0, ei)))
                for s in str.split(str.substring(g, ei + 1), ",")
                    t = str.trim(s)
                    if str.length(t) > 0
                        drawOne(nz(str.tonumber(t)), tag)
            else
                // "5M 7788.25" – Zahl = Preis, Rest = Tag
                string tag = ""
                float  px  = na
                for tok in str.split(g, " ")
                    t = str.trim(tok)
                    if str.length(t) > 0
                        v = str.tonumber(t)
                        if na(v)
                            tag := str.length(tag) > 0 ? tag + " " + str.upper(t) : str.upper(t)
                        else
                            px := v
                if not na(px)
                    drawOne(px, tag)

if barstate.islast
    for ln in dLines
        line.delete(ln)
    array.clear(dLines)
    for lb in dLabels
        label.delete(lb)
    array.clear(dLabels)
    if str.length(str.trim(txtAll)) > 0
        drawAll(txtAll)

// ═════════════════ Multi-timeframe RSI ═════════════════
// Same overbought/oversold read on 1m, 5m, 15m, 45m, 1H and 4H at once.
// Requests live at global scope and are made unconditionally.
// These read the DEVELOPING higher-timeframe bar, so e.g. the 4H figure moves
// during the day and only settles when that bar closes.
rsiM1  = request.security(syminfo.tickerid, "1",   ta.rsi(close, rsiLen))
rsiM5  = request.security(syminfo.tickerid, "5",   ta.rsi(close, rsiLen))
rsiM15 = request.security(syminfo.tickerid, "15",  ta.rsi(close, rsiLen))
rsiM45 = request.security(syminfo.tickerid, "45",  ta.rsi(close, rsiLen))
rsiH1  = request.security(syminfo.tickerid, "60",  ta.rsi(close, rsiLen))
rsiH4  = request.security(syminfo.tickerid, "240", ta.rsi(close, rsiLen))

rsiPos = rsiTblPos == "Middle right" ? position.middle_right : rsiTblPos == "Middle left" ? position.middle_left : rsiTblPos == "Bottom right" ? position.bottom_right : rsiTblPos == "Bottom left" ? position.bottom_left : rsiTblPos == "Top right" ? position.top_right : position.top_left
var table rt = table.new(rsiPos, 3, 7, border_width = 1, frame_color = color.gray, frame_width = 1)

if barstate.islast and showRsiTbl
    hdrBg2 = color.new(color.gray, 70)
    valBg2 = color.new(color.gray, 88)

    lbls = array.from("1m", "5m", "15m", "45m", "1H", "4H")
    tfms = array.from(1, 5, 15, 45, 60, 240)
    vals = array.from(rsiM1, rsiM5, rsiM15, rsiM45, rsiH1, rsiH4)

    table.cell(rt, 0, 0, "TF",  bgcolor = hdrBg2, text_color = color.white, text_size = size.small)
    table.cell(rt, 1, 0, "RSI", bgcolor = hdrBg2, text_color = color.white, text_size = size.small)
    table.cell(rt, 2, 0, str.tostring(rsiLen) + " · " + str.tostring(rsiOS, "#") + "/" + str.tostring(rsiOB, "#"), bgcolor = hdrBg2, text_color = color.gray, text_size = size.small)

    chartMin = timeframe.in_seconds() / 60.0

    for i = 0 to 5
        row = i + 1
        v   = array.get(vals, i)
        // below the chart timeframe request.security cannot give an honest answer
        tooFine = array.get(tfms, i) < chartMin
        side    = tooFine or na(v) ? "-" : v >= rsiOB ? "short" : v <= rsiOS ? "long" : "neither"
        sideCol = tooFine or na(v) ? color.gray : v >= rsiOB ? color.red : v <= rsiOS ? color.lime : color.gray

        table.cell(rt, 0, row, array.get(lbls, i), bgcolor = valBg2, text_color = tooFine ? color.gray : color.white, text_size = size.small)
        table.cell(rt, 1, row, tooFine ? "below chart TF" : na(v) ? "-" : str.tostring(v, "#.#"), bgcolor = valBg2, text_color = tooFine ? color.gray : color.white, text_size = size.small)
        table.cell(rt, 2, row, side, bgcolor = valBg2, text_color = sideCol, text_size = size.small)

// ENDE
