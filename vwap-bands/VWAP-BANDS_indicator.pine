//@version=6
indicator("VWAP · 0.5σ & 2–3σ Zones", shorttitle = "VWAP-Bands", overlay = true)

// ─────────────────────────────────────────────────────────────────────────────
//  VWAP with three zones:
//    · Middle: ±0.5σ around VWAP (fair value zone)
//    · Upper:  +2σ to +3σ  (upside extension)
//    · Lower:  −2σ to −3σ  (downside extension)
//  Band lines white, zone fills grey.
//  Lines break on anchor reset (no connecting line).
// ─────────────────────────────────────────────────────────────────────────────

// ═══════════════════════════ INPUTS ═══════════════════════════
const string G_V = "VWAP"
const string G_Z = "Zones (σ)"
const string G_C = "Colors"

string anchorIn = input.string("Session", "Anchor", options = ["Session", "RTH (9:30 NY)", "Week", "Month"], group = G_V)
float  src      = input.source(hlc3, "Source", group = G_V)

float  midSig   = input.float(0.5, "Middle zone ±", minval = 0.1, step = 0.1, group = G_Z)
float  inSig    = input.float(2.0, "Outer zone from", minval = 0.5, step = 0.25, inline = "o", group = G_Z)
float  outSig   = input.float(3.0, "to",              minval = 0.5, step = 0.25, inline = "o", group = G_Z)
bool   showMid  = input.bool(true, "Show middle zone",  group = G_Z)
bool   showOut  = input.bool(true, "Show outer zones",  group = G_Z)
bool   showLn   = input.bool(true, "Show band lines",   group = G_Z)

color  colVw    = input.color(color.new(#FFD600, 0),  "VWAP",        group = G_C)
color  colLn    = input.color(color.new(#FFFFFF, 0),  "Band lines",  group = G_C)
color  colMid   = input.color(color.new(#9E9E9E, 85), "Middle zone", group = G_C)
color  colOut   = input.color(color.new(#9E9E9E, 85), "Outer zones", group = G_C)

// ═══════════════════════════ VWAP + σ ═══════════════════════════
bool rthNow    = not na(time(timeframe.period, "0930-1600", "America/New_York"))
bool rthStart  = rthNow and not rthNow[1]
bool anchorChg = anchorIn == "Week" ? timeframe.change("W") : anchorIn == "Month" ? timeframe.change("M") : anchorIn == "RTH (9:30 NY)" ? rthStart : timeframe.change("D")

[vw, upB, loB] = ta.vwap(src, anchorChg, 1.0)
float sigma = upB - vw

// na on the anchor bar → lines and fills break cleanly
float vwP   = anchorChg ? na : vw
float mUp   = anchorChg ? na : vw + midSig * sigma
float mDn   = anchorChg ? na : vw - midSig * sigma
float iUp   = anchorChg ? na : vw + inSig  * sigma
float oUp   = anchorChg ? na : vw + outSig * sigma
float iDn   = anchorChg ? na : vw - inSig  * sigma
float oDn   = anchorChg ? na : vw - outSig * sigma

// ═══════════════════════════ DRAWING ═══════════════════════════
color lnMid = showMid and showLn ? colLn : na
color lnOut = showOut and showLn ? colLn : na

plot(vwP, "VWAP", colVw, 2, plot.style_linebr)

pMU = plot(mUp, "+0.5σ", lnMid, 1, plot.style_linebr)
pMD = plot(mDn, "−0.5σ", lnMid, 1, plot.style_linebr)
pIU = plot(iUp, "+2σ",   lnOut, 1, plot.style_linebr)
pOU = plot(oUp, "+3σ",   lnOut, 1, plot.style_linebr)
pID = plot(iDn, "−2σ",   lnOut, 1, plot.style_linebr)
pOD = plot(oDn, "−3σ",   lnOut, 1, plot.style_linebr)

fill(pMU, pMD, showMid ? colMid : na, "Middle zone")
fill(pIU, pOU, showOut ? colOut : na, "Upper zone")
fill(pID, pOD, showOut ? colOut : na, "Lower zone")
