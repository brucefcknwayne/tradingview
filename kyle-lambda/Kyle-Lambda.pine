//@version=6
// Kyle Lambda Profile – Preis-Impact je Kontrakt: rollierend (Regression Δp auf vorzeichenbehaftetes Volumen) und je Preiszone.
// Hohes λ = wenig Volumen bewegt den Preis weit (dünn, schnell durchgelaufen). Niedriges λ = viel Volumen ohne Bewegung (dick, absorbiert).
indicator("Kyle Lambda Profile", shorttitle = "Kyle λ", overlay = true, max_boxes_count = 500, max_bars_back = 5000)

// ───── Inputs ─────
grpS = "Signed volume"
svMode = input.string("BVC (math)", "Method", options = ["BVC (math)", "Lower TF tick rule"], group = grpS,
     tooltip = "BVC: buy share = Φ(Δp / σΔp) (Bulk Volume Classification, Easley/López de Prado/O'Hara 2012).\nTick rule: sign of every lower-timeframe price change × its volume. The lower timeframe must be ≤ chart timeframe (empty = chart).")
bvcLen = input.int(100, "BVC σ length", minval = 10, group = grpS)
ltfIn  = input.timeframe("", "Lower TF (tick rule)", group = grpS)

grpR = "Rolling Kyle λ"
kLen    = input.int(60, "Regression length (bars)", minval = 10, group = grpR)
pLen    = input.int(1000, "Percentile lookback", minval = 50, group = grpR)
showTbl = input.bool(true, "Show table", group = grpR)
tblPos  = input.string("Top Right", "Table position", options = ["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group = grpR)

grpP = "λ profile"
pMode     = input.string("Current session", "Range", options = ["Current session", "Previous session", "Last N bars"], group = grpP)
nBars     = input.int(1380, "N bars", minval = 50, maxval = 4900, group = grpP)
rows      = input.int(80, "Rows", minval = 20, maxval = 200, group = grpP)
minHits   = input.int(3, "Min. bars per row", minval = 1, group = grpP)
thinX     = input.float(2.0, "Thin zone: λ ≥ × median", minval = 1.0, step = 0.1, group = grpP)
thickX    = input.float(0.5, "Thick zone: λ ≤ × median", minval = 0.05, maxval = 1.0, step = 0.05, group = grpP)
showHist  = input.bool(true, "Show histogram", group = grpP)
histW     = input.int(40, "Histogram width (bars)", minval = 5, group = grpP)
histOff   = input.int(5, "Histogram offset (bars)", minval = 0, group = grpP)
showThin  = input.bool(true, "Show thin zones", group = grpP)
showThick = input.bool(true, "Show thick zones", group = grpP)
extR      = input.int(30, "Extend zones right (bars)", minval = 0, group = grpP)
cThin     = input.color(color.new(#eb6834, 75), "Thin color", group = grpP)
cThick    = input.color(color.new(#2a78d6, 80), "Thick color", group = grpP)
cMid      = input.color(color.new(color.gray, 85), "Neutral color", group = grpP)

// ───── Standardnormal-Verteilung (Abramowitz/Stegun 26.2.17) ─────
f_ncdf(float x) =>
    float t = 1.0 / (1.0 + 0.2316419 * math.abs(x))
    float d = 0.3989423 * math.exp(-x * x / 2.0)
    float p = d * t * (0.3193815 + t * (-0.3565638 + t * (1.781478 + t * (-1.821256 + t * 1.330274))))
    x > 0 ? 1.0 - p : p

// ───── Vorzeichenbehaftetes Volumen ─────
float dp    = close - close[1]
float sdp   = ta.stdev(dp, bvcLen)
float svBvc = sdp > 0 ? volume * (2.0 * f_ncdf(dp / sdp) - 1.0) : 0.0

[ltfC, ltfV] = request.security_lower_tf(syminfo.tickerid, ltfIn, [close, volume])
var float lastC = na
var float lastS = 0.0
float svTick = 0.0
int nI = array.size(ltfC)
if nI > 0
    for i = 0 to nI - 1
        float c = array.get(ltfC, i)
        float v = array.get(ltfV, i)
        float s = na(lastC) ? 0.0 : c > lastC ? 1.0 : c < lastC ? -1.0 : lastS
        svTick += na(v) ? 0.0 : s * v
        lastC := c
        lastS := s
float sv = svMode == "BVC (math)" ? svBvc : svTick

// ───── Rollierendes Kyle λ: Δp = λ · SV + ε (Punkte je 1.000 Kontrakte) ─────
float mXY = ta.sma(dp * sv, kLen)
float mX  = ta.sma(sv, kLen)
float mY  = ta.sma(dp, kLen)
float vX  = ta.variance(sv, kLen)
float lam = vX > 0 ? (mXY - mX * mY) / vX * 1000.0 : na
float r2  = math.pow(ta.correlation(dp, sv, kLen), 2)
float pr  = ta.percentrank(lam, pLen)
plot(lam, "Kyle λ (pts / 1k contracts)", display = display.data_window)
plot(pr, "Kyle λ percentile", display = display.data_window)

// ───── Session-Anfänge (Handelstag, bei Futures 18:00 ET) ─────
var int sessStart = na
var int prevStart = na
if timeframe.change("D")
    prevStart := sessStart
    sessStart := bar_index

// ───── λ-Profil je Preiszone: λ(p) = Σ|Δp|·w / Σ|SV|·w, w = Anteil der Kerze an der Zeile ─────
var array<box> bxs = array.new<box>()
if barstate.islast
    for b in bxs
        box.delete(b)
    array.clear(bxs)
    int oTo   = 0
    int oFrom = 0
    if pMode == "Current session"
        oFrom := na(sessStart) ? math.min(bar_index, nBars - 1) : bar_index - sessStart
    else if pMode == "Previous session"
        if not na(prevStart)
            oTo   := bar_index - sessStart + 1
            oFrom := bar_index - prevStart
    else
        oFrom := math.min(bar_index, nBars - 1)
    oFrom := math.min(oFrom, 4900)
    if oFrom > oTo
        float hi = na
        float lo = na
        for i = oTo to oFrom
            hi := na(hi) ? high[i] : math.max(hi, high[i])
            lo := na(lo) ? low[i] : math.min(lo, low[i])
        float bs = (hi - lo) / rows
        if bs > 0
            array<float> num  = array.new<float>(rows, 0.0)
            array<float> den  = array.new<float>(rows, 0.0)
            array<int>   hits = array.new<int>(rows, 0)
            for i = oTo to oFrom
                float d = math.abs(dp[i])
                float s = math.abs(sv[i])
                if not na(d) and not na(s)
                    int r0 = math.max(0, math.min(rows - 1, int(math.floor((low[i] - lo) / bs))))
                    int r1 = math.max(0, math.min(rows - 1, int(math.floor((high[i] - lo) / bs))))
                    float k = r1 - r0 + 1
                    for r = r0 to r1
                        array.set(num, r, array.get(num, r) + d / k)
                        array.set(den, r, array.get(den, r) + s / k)
                        array.set(hits, r, array.get(hits, r) + 1)
            // Glättung über ±1 Zeile (Verhältnis der Summen)
            array<float> lr = array.new<float>(rows, na)
            for r = 0 to rows - 1
                float n3 = 0.0
                float d3 = 0.0
                for j = math.max(0, r - 1) to math.min(rows - 1, r + 1)
                    n3 += array.get(num, j)
                    d3 += array.get(den, j)
                if array.get(hits, r) >= minHits and d3 > 0
                    array.set(lr, r, n3 / d3)
            array<float> valid = array.new<float>()
            for r = 0 to rows - 1
                float v = array.get(lr, r)
                if not na(v)
                    array.push(valid, v)
            float med = array.size(valid) > 0 ? array.median(valid) : na
            if not na(med) and med > 0
                int xL = bar_index - oFrom
                if showHist
                    for r = 0 to rows - 1
                        float v = array.get(lr, r)
                        if not na(v)
                            float q = v / med
                            int w = math.max(1, int(math.round(histW * math.min(q / (thinX * 1.5), 1.0))))
                            color c = q >= thinX ? cThin : q <= thickX ? cThick : cMid
                            array.push(bxs, box.new(bar_index + histOff, lo + (r + 1) * bs, bar_index + histOff + w, lo + r * bs,
                                 border_color = color.new(c, 100), bgcolor = color.new(c, 35)))
                int ri = 0
                while ri < rows
                    float v = array.get(lr, ri)
                    int typ = na(v) ? 0 : v / med >= thinX ? 1 : v / med <= thickX ? -1 : 0
                    if typ != 0
                        int rEnd = ri
                        float qX = v / med
                        while rEnd + 1 < rows
                            float v2 = array.get(lr, rEnd + 1)
                            int t2 = na(v2) ? 0 : v2 / med >= thinX ? 1 : v2 / med <= thickX ? -1 : 0
                            if t2 != typ
                                break
                            rEnd += 1
                            qX := typ == 1 ? math.max(qX, v2 / med) : math.min(qX, v2 / med)
                        if (typ == 1 and showThin) or (typ == -1 and showThick)
                            color zc = typ == 1 ? cThin : cThick
                            array.push(bxs, box.new(xL, lo + (rEnd + 1) * bs, bar_index + extR, lo + ri * bs, border_color = zc, bgcolor = zc,
                                 text = (typ == 1 ? "thin λ ×" : "thick λ ×") + str.tostring(qX, "#.0#"), text_color = color.gray,
                                 text_size = size.tiny, text_halign = text.align_left, text_valign = text.align_top))
                        ri := rEnd + 1
                    else
                        ri += 1

// ───── Tabelle ─────
tPos = tblPos == "Top Right" ? position.top_right : tblPos == "Bottom Right" ? position.bottom_right : tblPos == "Top Left" ? position.top_left : position.bottom_left
var table tb = table.new(tPos, 2, 4, bgcolor = color.new(color.black, 30), border_width = 1)
if showTbl and barstate.islast
    string reg = na(pr) ? "–" : pr >= 80 ? "Thin (fast)" : pr <= 20 ? "Thick (absorbing)" : "Normal"
    color regC = na(pr) ? color.gray : pr >= 80 ? #eb6834 : pr <= 20 ? #2a78d6 : color.gray
    table.cell(tb, 0, 0, "Kyle λ", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 0, str.tostring(lam, "#.###") + " pts/1k", text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 1, "Percentile", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 1, str.tostring(pr, "#") + " %", text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 2, "R²", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 2, str.tostring(r2, "#.00"), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 3, "Regime", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 3, reg, text_color = regC, text_size = size.small)
