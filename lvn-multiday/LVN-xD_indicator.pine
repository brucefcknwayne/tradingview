// This Pine Script™ is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
// LVN-Logik übernommen aus "Volume Profile Imbalances (Multi-Zone LVN) [DZOI]",
// erweitert auf ein frei einstellbares Mehrtages-Profil (z. B. 7 / 30 / 60 / 90 Tage).
//  • Live: Profil wird laufend neu berechnet, Zonen bleiben stehen, bis sie
//    gefüllt sind oder im Profil keine LVN mehr sind.
//  • Profil wird auf einem höheren Timeframe gerechnet (Standard 15m), damit
//    auch auf dem 1m-Chart 30–90 Tage Historie verfügbar sind.
//@version=6
indicator("Multi-Day LVN (einstellbare Tage)", "LVN xD", overlay=true, max_boxes_count=500)

// ══════════════════════════════════════════════════════════════════════════════
// ─── INPUTS ──────────────────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════════════
i_days          = input.int(30, "Anzahl Tage im Profil", 1, 365, group="Profil", tooltip="Wie viele abgeschlossene Handelstage (Session 18:00–18:00 ET) in das Volumenprofil eingehen, z. B. 7, 30, 60 oder 90.")
i_tf            = input.timeframe("15", "Profil-Timeframe", group="Profil", tooltip="Auf diesem Timeframe wird das Profil gerechnet – unabhängig vom Chart. Höher = mehr Tage Historie verfügbar, aber etwas gröber. Faustregel: 5m für bis ~30 Tage, 15m für 30–90 Tage, 30m/60m für mehr. Ist der Chart-Timeframe höher, wird der Chart-Timeframe genommen.")
i_incl_today    = input.bool(true, "Laufende Session einbeziehen", group="Profil", tooltip="Die aktuelle, noch nicht abgeschlossene Session fließt live mit ins Profil ein.")
i_show_days     = input.int(10, "Zonen anzeigen für letzte X Tage", 1, 365, group="Profil", tooltip="Nur in diesem Zeitraum wird live gerechnet und gezeichnet. Weiter zurück spart nur Rechenzeit, da der 1m-Chart ohnehin nicht so weit zurückreicht.")
i_row_ticks     = input.int(4,  "Raster (Ticks)", 1, 1000, group="Profil", tooltip="Feines Preisraster, in dem das Volumen gesammelt wird. NQ: 4 Ticks = 1 Punkt. Größer = weniger Speicher, aber gröber.")

i_sens          = input.string("Mittel", "Sensitivität", options=["Sehr niedrig", "Niedrig", "Mittel", "Hoch", "Sehr hoch", "Manuell"], group="LVN / Sensitivität", tooltip="Wie ausgeprägt ein Volumen-Tal sein muss, um als LVN zu zählen. Niedrig = nur sehr deutliche Löcher (wenige Zonen). Hoch = auch flache Täler (viele Zonen). 'Manuell' nutzt die zwei Werte darunter.")
i_max_zones     = input.int(6,   "Max. Anzahl LVNs", 1, 50, group="LVN / Sensitivität")
i_prominence    = input.int(25,  "Manuell: Min. Prominenz (%)", 0, 90, group="LVN / Sensitivität", tooltip="Nur bei Sensitivität 'Manuell'. Eine LVN muss mindestens so viel % weniger Volumen haben als die niedrigere der beiden Volumen-Schultern links/rechts.")
i_prom_window   = input.int(6,   "Manuell: Prominenz-Suchfenster (Bins)", 1, 20, group="LVN / Sensitivität", tooltip="Nur bei Sensitivität 'Manuell'.")
i_bins          = input.int(100, "Volume Profile Bins", 10, 300, group="LVN / Sensitivität", tooltip="In so viele gleich große Fächer wird der Preisbereich des Profils aufgeteilt. Eine Zone ist genau ein Fach breit. Mehr Bins = schmalere Zonen.")
i_edge_pct      = input.int(15,  "Rand ignorieren (%)", 0, 40, group="LVN / Sensitivität", tooltip="Oberste und unterste x % des Profils werden nicht nach LVNs durchsucht.")
i_min_sep_ticks = input.int(20,  "Min. Abstand zwischen Zonen (Ticks)", 1, 5000, group="LVN / Sensitivität")
i_smooth        = input.bool(true, "Histogramm glätten (3 Bins)", group="LVN / Sensitivität")

i_fill_mode     = input.string("Berührung", "Zone gefüllt bei", options=["Berührung", "Komplett durchlaufen"], group="Zonen", tooltip="Berührung: erster Kontakt beendet die Zone. Komplett durchlaufen: erst wenn der Preis sowohl Ober- als auch Unterkante gehandelt hat.")
i_del_done      = input.bool(false, "Beendete Zonen löschen", group="Zonen", tooltip="Aus: gefüllte bzw. erloschene Zonen bleiben grau stehen. An: sie verschwinden.")
i_color         = input.color(#FF9800, "Farbe aktive Zone", group="Zonen")
i_done_color    = input.color(color.gray, "Farbe beendete Zone", group="Zonen")
i_opacity       = input.int(80, "Transparenz (%)", 0, 100, group="Zonen")
i_show_text     = input.bool(true, "Zonen beschriften", group="Zonen")
i_show_table    = input.bool(true, "Info-Tabelle anzeigen", group="Anzeige")
i_table_pos     = input.string("Top Right", "Tabellen-Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group="Anzeige")

// ══════════════════════════════════════════════════════════════════════════════
// ─── GRUNDWERTE ──────────────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════════════
float row           = i_row_ticks * syminfo.mintick
float min_sep_price = i_min_sep_ticks * syminfo.mintick
float edge          = i_edge_pct / 100.0

int prom_val = switch i_sens
    "Sehr niedrig" => 50
    "Niedrig"      => 35
    "Mittel"       => 25
    "Hoch"         => 15
    "Sehr hoch"    => 8
    => i_prominence
int prom_win = switch i_sens
    "Sehr niedrig" => 8
    "Niedrig"      => 7
    "Mittel"       => 6
    "Hoch"         => 5
    "Sehr hoch"    => 4
    => i_prom_window
float prom_pct = prom_val / 100.0

string prof_tf = timeframe.in_seconds(i_tf) < timeframe.in_seconds() ? timeframe.period : i_tf

// ══════════════════════════════════════════════════════════════════════════════
// ─── HILFSFUNKTIONEN ─────────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════════════
type DayProfile
    map<int, float> vols

add_to(map<int, float> m, int k, float v) =>
    m.put(k, nz(m.get(k)) + v)

// Volumen eines Preisbereichs anteilig auf die Profil-Bins verteilen
spread(array<float> bins, float l, float h, float v, float scan_lo, float bin_size, int bin_count) =>
    int sB = math.max(0, math.min(bin_count - 1, math.floor((l - scan_lo) / bin_size)))
    int eB = math.max(0, math.min(bin_count - 1, math.floor((h - scan_lo) / bin_size)))
    if sB == eB
        array.set(bins, sB, array.get(bins, sB) + v)
    else
        float rng = h - l
        for b = sB to eB
            float b_lo = scan_lo + b * bin_size
            float ov   = math.min(h, b_lo + bin_size) - math.max(l, b_lo)
            if ov > 0
                array.set(bins, b, array.get(bins, b) + v * ov / rng)
    true

// LVN-Suche – Logik wie im Original (Bins, Glättung, lokale Minima,
// Prominenz-Filter, Sortierung nach Volumen, Mindestabstand)
find_lvns(map<int, float> g, map<int, float> td, bool use_td, float rw, int bin_count, int max_zones, float min_sep, float prom_thresh, int p_win, bool do_smooth, float edg) =>
    int k_min = 2147483647
    int k_max = -2147483647
    for k in g.keys()
        k_min := math.min(k_min, k)
        k_max := math.max(k_max, k)
    if use_td
        for k in td.keys()
            k_min := math.min(k_min, k)
            k_max := math.max(k_max, k)

    array<float> out_his = array.new<float>(0)
    array<float> out_los = array.new<float>(0)

    if k_max >= k_min
        float scan_lo  = k_min * rw
        float scan_hi  = (k_max + 1) * rw
        float bin_size = (scan_hi - scan_lo) / bin_count
        array<float> bin_vols = array.new<float>(bin_count, 0.0)

        for [k, v] in g
            spread(bin_vols, k * rw, (k + 1) * rw, v, scan_lo, bin_size, bin_count)
        if use_td
            for [k, v] in td
                spread(bin_vols, k * rw, (k + 1) * rw, v, scan_lo, bin_size, bin_count)

        array<float> work_vols = array.new<float>(bin_count, 0.0)
        for b = 0 to bin_count - 1
            if do_smooth
                float sum = array.get(bin_vols, b)
                int cnt = 1
                if b > 0
                    sum += array.get(bin_vols, b - 1)
                    cnt += 1
                if b < bin_count - 1
                    sum += array.get(bin_vols, b + 1)
                    cnt += 1
                array.set(work_vols, b, sum / cnt)
            else
                array.set(work_vols, b, array.get(bin_vols, b))

        int start_bin = math.max(0, math.floor(bin_count * edg))
        int end_bin   = math.min(bin_count - 1, math.floor(bin_count * (1 - edg)))

        array<int>   loc_min_idx = array.new<int>(0)
        array<float> loc_min_vol = array.new<float>(0)
        if end_bin >= start_bin
            for b = start_bin to end_bin
                float bv     = array.get(work_vols, b)
                float prev_v = array.get(work_vols, math.max(0, b - 1))
                float next_v = array.get(work_vols, math.min(bin_count - 1, b + 1))
                if bv <= prev_v and bv <= next_v
                    float left_peak = bv
                    for wb = math.max(0, b - p_win) to b
                        left_peak := math.max(left_peak, array.get(work_vols, wb))
                    float right_peak = bv
                    for wb = b to math.min(bin_count - 1, b + p_win)
                        right_peak := math.max(right_peak, array.get(work_vols, wb))
                    float shoulder   = math.min(left_peak, right_peak)
                    float prominence = shoulder > 0 ? (shoulder - bv) / shoulder : 0.0
                    if prominence >= prom_thresh
                        array.push(loc_min_idx, b)
                        array.push(loc_min_vol, bv)

        int num_mins = array.size(loc_min_idx)
        if num_mins > 1
            for i = 0 to num_mins - 2
                for j = i + 1 to num_mins - 1
                    float vol_i = array.get(loc_min_vol, i)
                    float vol_j = array.get(loc_min_vol, j)
                    if vol_j < vol_i
                        array.set(loc_min_vol, i, vol_j)
                        array.set(loc_min_vol, j, vol_i)
                        int idx_i = array.get(loc_min_idx, i)
                        int idx_j = array.get(loc_min_idx, j)
                        array.set(loc_min_idx, i, idx_j)
                        array.set(loc_min_idx, j, idx_i)

        int zones_added = 0
        if num_mins > 0
            for i = 0 to num_mins - 1
                if zones_added >= max_zones
                    break
                int idx = array.get(loc_min_idx, i)
                float cand_center = scan_lo + idx * bin_size + bin_size / 2.0
                bool valid = true
                if zones_added > 0
                    for z = 0 to zones_added - 1
                        float z_center = (array.get(out_his, z) + array.get(out_los, z)) / 2.0
                        if math.abs(cand_center - z_center) < min_sep
                            valid := false
                            break
                if valid
                    array.push(out_los, scan_lo + idx * bin_size)
                    array.push(out_his, scan_lo + (idx + 1) * bin_size)
                    zones_added += 1

    [out_his, out_los]

// ══════════════════════════════════════════════════════════════════════════════
// ─── PROFIL-ENGINE (läuft auf dem Profil-Timeframe) ──────────────────────────
// Jeder Tag wird als eigenes Profil gespeichert (Raster-Index → Volumen).
// "grid" ist die Summe aller gespeicherten Tage; fällt ein Tag aus dem
// Fenster, wird sein Volumen wieder abgezogen. Rückgabe als Text:
// "geladene Tage|unten,oben;unten,oben;..."
// ══════════════════════════════════════════════════════════════════════════════
lvn_engine() =>
    var array<DayProfile> days    = array.new<DayProfile>()
    var map<int, float>   grid    = map.new<int, float>()
    var map<int, float>   today   = map.new<int, float>()
    var bool              started = false
    var string            out     = ""

    // Tageswechsel: abgeschlossenen Tag speichern, ältesten entfernen
    if timeframe.change("D") and bar_index > 0
        if started and today.size() > 0
            array.push(days, DayProfile.new(today))
            for [k, v] in today
                add_to(grid, k, v)
        started := true
        today := map.new<int, float>()
        while array.size(days) > i_days
            DayProfile old = array.shift(days)
            for [k, v] in old.vols
                float nv = nz(grid.get(k)) - v
                if nv <= 1e-6
                    grid.remove(k)
                else
                    grid.put(k, nv)
        if grid.size() > 45000
            runtime.error("Preisraster zu fein für diesen Zeitraum – 'Raster (Ticks)' erhöhen.")

    // Volumen der Kerze anteilig auf ihre High-Low-Spanne verteilen
    float vol  = math.max(nz(volume), 1.0)
    int   k_lo = math.floor(low / row)
    int   k_hi = math.floor(high / row)
    if k_lo == k_hi
        add_to(today, k_lo, vol)
    else if k_hi - k_lo <= 5000
        float bar_rng = high - low
        for k = k_lo to k_hi
            float r_lo = k * row
            float ov   = math.min(high, r_lo + row) - math.max(low, r_lo)
            if ov > 0
                add_to(today, k, vol * ov / bar_rng)

    // Live-Neuberechnung im Anzeige-Zeitraum
    if array.size(days) > 0 and (time >= timenow - i_show_days * 86400000 or barstate.islast)
        [his, los] = find_lvns(grid, today, i_incl_today, row, i_bins, i_max_zones, min_sep_price, prom_pct, prom_win, i_smooth, edge)
        string s = str.tostring(array.size(days)) + "|"
        int n = array.size(his)
        if n > 0
            for i = 0 to n - 1
                s += (i > 0 ? ";" : "") + str.tostring(array.get(los, i), "#.########") + "," + str.tostring(array.get(his, i), "#.########")
        out := s
    out

string res = request.security(syminfo.tickerid, prof_tf, lvn_engine())

// ══════════════════════════════════════════════════════════════════════════════
// ─── ZONEN-VERWALTUNG (Chart) ────────────────────────────────────────────────
// Aktive Zone bleibt stehen, bis sie gefüllt ist oder im aktuellen Profil
// keine LVN mehr ist. Gefüllte Bereiche werden gesperrt, damit sie nicht
// sofort neu gezeichnet werden, solange dort noch eine LVN liegt.
// ══════════════════════════════════════════════════════════════════════════════
overlaps_any(float top, float bot, array<float> his, array<float> los) =>
    bool hit = false
    int n = array.size(his)
    if n > 0
        for i = 0 to n - 1
            if array.get(los, i) < top and array.get(his, i) > bot
                hit := true
                break
    hit

var array<box>   a_box    = array.new<box>(0)
var array<float> a_top    = array.new<float>(0)
var array<float> a_bot    = array.new<float>(0)
var array<bool>  a_hit_hi = array.new<bool>(0)
var array<bool>  a_hit_lo = array.new<bool>(0)
var array<float> s_top    = array.new<float>(0)   // Sperrliste gefüllter Bereiche
var array<float> s_bot    = array.new<float>(0)
var array<box>   h_box    = array.new<box>(0)     // beendete Zonen (Historie)
var string       last_res = ""
var int          loaded   = 0

// Zone beenden (Index i aus den aktiven Listen)
end_zone(int i, string why) =>
    box b = array.get(a_box, i)
    box.set_extend(b, extend.none)
    box.set_right(b, bar_index)
    if i_del_done
        box.delete(b)
    else
        box.set_bgcolor(b, color.new(i_done_color, math.min(100, i_opacity + 5)))
        box.set_text(b, i_show_text ? why : "")
        box.set_text_color(b, i_done_color)
        array.push(h_box, b)
        if array.size(h_box) > 300
            box.delete(array.shift(h_box))
    array.remove(a_box, i)
    array.remove(a_top, i)
    array.remove(a_bot, i)
    array.remove(a_hit_hi, i)
    array.remove(a_hit_lo, i)
    true

// Neues Ergebnis aus der Engine verarbeiten
if not na(res) and str.length(res) > 0 and res != last_res
    last_res := res
    array<string> parts = str.split(res, "|")
    loaded := int(nz(str.tonumber(array.get(parts, 0))))
    array<float> n_his = array.new<float>(0)
    array<float> n_los = array.new<float>(0)
    if array.size(parts) > 1 and str.length(array.get(parts, 1)) > 0
        for z in str.split(array.get(parts, 1), ";")
            array<string> p = str.split(z, ",")
            if array.size(p) == 2
                array.push(n_los, str.tonumber(array.get(p, 0)))
                array.push(n_his, str.tonumber(array.get(p, 1)))

    // 1. Aktive Zonen, die keine LVN mehr sind, beenden
    if array.size(a_box) > 0
        for i = array.size(a_box) - 1 to 0
            if not overlaps_any(array.get(a_top, i), array.get(a_bot, i), n_his, n_los)
                end_zone(i, "kein LVN mehr")

    // 2. Sperrliste: Bereiche freigeben, die keine LVN mehr sind
    if array.size(s_top) > 0
        for i = array.size(s_top) - 1 to 0
            if not overlaps_any(array.get(s_top, i), array.get(s_bot, i), n_his, n_los)
                array.remove(s_top, i)
                array.remove(s_bot, i)

    // 3. Neue LVNs zeichnen (nicht schon aktiv, nicht gesperrt)
    int nn = array.size(n_his)
    if nn > 0
        for j = 0 to nn - 1
            float nt = array.get(n_his, j)
            float nb = array.get(n_los, j)
            if not overlaps_any(nt, nb, a_top, a_bot) and not overlaps_any(nt, nb, s_top, s_bot)
                box zb = box.new(left=bar_index, top=nt, right=bar_index, bottom=nb,
                     border_color=color.new(i_color, 100), bgcolor=color.new(i_color, i_opacity), extend=extend.right,
                     text=i_show_text ? str.tostring(i_days) + "D LVN" : "", text_size=size.tiny, text_color=i_color,
                     text_halign=text.align_right, text_valign=text.align_center)
                array.push(a_box, zb)
                array.push(a_top, nt)
                array.push(a_bot, nb)
                array.push(a_hit_hi, false)
                array.push(a_hit_lo, false)

// Füllung prüfen
if array.size(a_box) > 0
    for i = array.size(a_box) - 1 to 0
        float zt = array.get(a_top, i)
        float zb = array.get(a_bot, i)
        bool filled = false
        if i_fill_mode == "Berührung"
            filled := low <= zt and high >= zb
        else
            if low <= zt and high >= zt
                array.set(a_hit_hi, i, true)
            if low <= zb and high >= zb
                array.set(a_hit_lo, i, true)
            filled := array.get(a_hit_hi, i) and array.get(a_hit_lo, i)
        if filled
            array.push(s_top, zt)
            array.push(s_bot, zb)
            end_zone(i, "gefüllt")

// ══════════════════════════════════════════════════════════════════════════════
// ─── INFO-TABELLE ────────────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════════════
table_pos = switch i_table_pos
    "Top Left"     => position.top_left
    "Top Right"    => position.top_right
    "Bottom Left"  => position.bottom_left
    => position.bottom_right

var table info = table.new(table_pos, 2, 6, bgcolor=color.new(#111111, 20), border_color=color.new(#444444, 80), border_width=1)

if i_show_table and barstate.islast
    float above_top = na
    float above_bot = na
    float below_top = na
    float below_bot = na
    int n_act = array.size(a_box)
    if n_act > 0
        for i = 0 to n_act - 1
            float zt = array.get(a_top, i)
            float zb = array.get(a_bot, i)
            if zb > close and (na(above_bot) or zb < above_bot)
                above_bot := zb
                above_top := zt
            if zt < close and (na(below_top) or zt > below_top)
                below_top := zt
                below_bot := zb

    bool short_hist = loaded < i_days
    table.cell(info, 0, 0, "Profil:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(info, 1, 0, str.tostring(i_days) + " Tage · TF " + prof_tf + " · " + i_sens, text_color=color.white, text_size=size.small, text_halign=text.align_right)
    table.cell(info, 0, 1, "Geladen:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(info, 1, 1, str.tostring(loaded) + " / " + str.tostring(i_days) + " Tage", text_color=short_hist ? color.orange : color.white, text_size=size.small, text_halign=text.align_right)
    table.cell(info, 0, 2, "", text_size=size.small)
    table.cell(info, 1, 2, short_hist ? "Zu wenig Historie → Profil-TF erhöhen" : "", text_color=color.orange, text_size=size.small, text_halign=text.align_right)
    table.cell(info, 0, 3, "Aktive LVNs:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(info, 1, 3, str.tostring(n_act), text_color=color.white, text_size=size.small, text_halign=text.align_right)
    table.cell(info, 0, 4, "Nächste ↑:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(info, 1, 4, na(above_bot) ? "–" : str.tostring(above_bot, format.mintick) + " – " + str.tostring(above_top, format.mintick), text_color=i_color, text_size=size.small, text_halign=text.align_right)
    table.cell(info, 0, 5, "Nächste ↓:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(info, 1, 5, na(below_top) ? "–" : str.tostring(below_bot, format.mintick) + " – " + str.tostring(below_top, format.mintick), text_color=i_color, text_size=size.small, text_halign=text.align_right)
