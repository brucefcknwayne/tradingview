//@version=6
indicator("LVN 9:25 – Tag & Woche + Tagesprofil", shorttitle = "LVN 925", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_polylines_count = 100)

// ─────────────────────────────────────────────────────────────────────────────
//  Jeden Tag um 9:25 (New York) werden neu markiert:
//    • Tages-LVNs   – Profil von Tagesstart (18:00) bis 9:25          (rote Boxen)
//    • Wochen-LVNs  – Profil der letzten 5 Handelstage + heute bis 9:25 (lila Boxen)
//  Die Boxen laufen nach rechts, bis um 9:25 am nächsten Tag die neuen kommen.
//
//  Volume Profile (nur Tag) im Stil des TradingView-SVP: graue Session-Box,
//  1 Zeile pro Tick, Value Area hell, Rest grau, POC-Linie, Breite 35 %.
//  Das Wochenprofil wird NICHT gezeichnet – nur seine LVNs.
//
//  Ohne TV-Abo: Volumen aus 1-Minuten-Intrabars (auf 1m-Chart = Chartkerzen),
//  je Kerze gleichmäßig auf jeden Tick zwischen Hoch und Tief verteilt.
//  Snapshot zählt nur Volumen VOR 9:25:00.
//
//  LVN: Profil leicht geglättet → lokales Tief mit klar höheren Peaks links
//  UND rechts (Tal ≤ Max. Tiefe % des kleineren Peaks). Tiefste Täler zuerst.
//
//  Wichtig: Chart mit Extended Hours (ETH). Für das Wochenprofil müssen
//  6 Handelstage geladen sein (siehe Info-Tabelle).
// ─────────────────────────────────────────────────────────────────────────────

const string TZ       = "America/New_York"
const string G_D      = "Daten / Auflösung"
const string G_T      = "Zeiten (New York)"
const string G_L      = "LVN Tag"
const string G_W      = "LVN Woche"
const string G_A      = "LVN-Boxen"
const string G_P      = "Volume Profile (Tag)"
const int    MAX_ROWS = 4900
const int    CHUNK    = 3000   // Zeilen je Polyline (3 Punkte je Zeile, max. 10.000)

string ltf      = input.timeframe("1", "Intrabar-Timeframe", group = G_D, tooltip = "1 = 1 Minute, geht ohne Abo. Auf dem 1m-Chart werden die Chartkerzen selbst benutzt.")
int    rowTicks = input.int(1, "Zeilengröße (Ticks)", minval = 1, maxval = 100, group = G_D, tooltip = "1 = kleinstmögliche Zeile (NQ/MNQ: 0,25 Punkte).")

int dsH = input.int(18, "Tagesstart", minval = 0, maxval = 23, inline = "ds", group = G_T)
int dsM = input.int(0,  ":",          minval = 0, maxval = 59, inline = "ds", group = G_T, tooltip = "18:00 = Start des Globex-Handelstags (NQ).")
int trH = input.int(9,  "LVN-Zeit",   minval = 0, maxval = 23, inline = "tr", group = G_T)
int trM = input.int(25, ":",          minval = 0, maxval = 59, inline = "tr", group = G_T)

bool  dOn     = input.bool(true, "Tages-LVNs", group = G_L)
int   dSmooth = input.int(4,    "Glättung ± Ticks",    minval = 0, maxval = 400,  group = G_L, tooltip = "Gegen Tick-Rauschen. 0 = Rohprofil.")
int   dWin    = input.int(12,   "Tal-Fenster ± Ticks", minval = 1, maxval = 1000, group = G_L, tooltip = "Das LVN muss in diesem Bereich die niedrigste Stelle sein.")
int   dPeak   = input.int(80,   "Peak-Suche ± Ticks",  minval = 2, maxval = 4000, group = G_L, tooltip = "In diesem Bereich links und rechts wird der höchste Peak gesucht.")
float dDepth  = input.float(50, "Max. Tiefe %",        minval = 1, maxval = 100, step = 5, group = G_L, tooltip = "Volumen im Tal ≤ X % des kleineren Nachbar-Peaks. Kleiner = nur sehr ausgeprägte LVNs.")
float dMinPk  = input.float(15, "Min. Peak % vom POC", minval = 0, maxval = 100, step = 5, group = G_L, tooltip = "Filtert Täler in den dünnen Rändern des Profils.")
int   dDist   = input.int(16,   "Min. Abstand Ticks",  minval = 1, maxval = 4000, group = G_L)
int   dMax    = input.int(6,    "Max. LVNs",           minval = 1, maxval = 15,   group = G_L)
color dCol    = input.color(color.new(#f23645, 80), "Box", inline = "dc", group = G_L)
color dColB   = input.color(color.new(#f23645, 45), "Rand", inline = "dc", group = G_L)

bool  wOn     = input.bool(true, "Wochen-LVNs", group = G_W)
int   wDays   = input.int(5,    "Vergangene Handelstage", minval = 1, maxval = 10, group = G_W, tooltip = "Wochenprofil = diese Anzahl abgeschlossener Tage + heute bis 9:25.")
int   wSmooth = input.int(12,   "Glättung ± Ticks",    minval = 0, maxval = 400,  group = G_W)
int   wWin    = input.int(40,   "Tal-Fenster ± Ticks", minval = 1, maxval = 1000, group = G_W)
int   wPeak   = input.int(240,  "Peak-Suche ± Ticks",  minval = 2, maxval = 4000, group = G_W)
float wDepth  = input.float(50, "Max. Tiefe %",        minval = 1, maxval = 100, step = 5, group = G_W)
float wMinPk  = input.float(10, "Min. Peak % vom POC", minval = 0, maxval = 100, step = 5, group = G_W)
int   wDist   = input.int(48,   "Min. Abstand Ticks",  minval = 1, maxval = 4000, group = G_W)
int   wMax    = input.int(6,    "Max. LVNs",           minval = 1, maxval = 15,   group = G_W)
color wCol    = input.color(color.new(#9c27b0, 75), "Box", inline = "wc", group = G_W)
color wColB   = input.color(color.new(#9c27b0, 40), "Rand", inline = "wc", group = G_W)

float zoneEdge = input.float(25, "Box-Höhe (Rand %)", minval = 1, maxval = 100, step = 5, group = G_A, tooltip = "Box = Bereich um das LVN, in dem das Volumen unter Tal + X % des Abstands zum Peak bleibt. Größer = dickere Boxen.")
int    keepDays = input.int(2, "Tage anzeigen", minval = 1, maxval = 10, group = G_A, tooltip = "1 = nur die aktuellen Boxen. 2 = zusätzlich die von gestern (enden um 9:25 heute).")
bool   showLbl  = input.bool(false, "Preis-Label", group = G_A)

bool  showVP   = input.bool(true, "Volume Profile anzeigen", group = G_P)
float vpWidth  = input.float(35, "Breite %", minval = 1, maxval = 100, group = G_P, tooltip = "Längste Zeile = X % der Box-Breite (Tagesstart bis aktuelle Kerze).")
int   vaPct    = input.int(68, "Value Area %", minval = 1, maxval = 100, group = G_P)
color colVA    = input.color(color.new(#d1d4dc, 10), "Value Area", inline = "v", group = G_P)
color colOut   = input.color(color.new(#787b86, 35), "Rest", inline = "v", group = G_P)
color colBg    = input.color(color.new(#787b86, 88), "Box", inline = "v", group = G_P)
bool  showPOC  = input.bool(true, "POC", inline = "p", group = G_P)
color colPOC   = input.color(color.new(#f23645, 0), "", inline = "p", group = G_P)
int   pocW     = input.int(2, "Breite", minval = 1, maxval = 4, inline = "p", group = G_P)
bool  showVAL  = input.bool(false, "VAH / VAL", inline = "va", group = G_P)
color colVAL   = input.color(color.new(#2962ff, 0), "", inline = "va", group = G_P)
int   keepProf = input.int(1, "Profile vergangener Tage", minval = 0, maxval = 10, group = G_P)
bool  showInfo = input.bool(true, "Info-Tabelle", group = G_P)

// ═══════════════════════════ TYPEN ═══════════════════════════
type DayVol
    map<int, float> m
    bool            full

type Prof
    array<polyline> polys
    box             bg
    line            poc
    line            vah
    line            val

type LvnSet
    array<box>   boxes
    array<label> lbls

method del(Prof p) =>
    for pl in p.polys
        pl.delete()
    p.bg.delete()
    p.poc.delete()
    p.vah.delete()
    p.val.delete()

method del(LvnSet s) =>
    for b in s.boxes
        b.delete()
    for l in s.lbls
        l.delete()

// Boxen eines alten Satzes enden, wenn die neuen kommen
method freeze(LvnSet s, int x2) =>
    for b in s.boxes
        b.set_right(x2)
        b.set_extend(extend.none)

// ═══════════════════════════ ZEIT ═══════════════════════════
int startMin = dsH * 60 + dsM
int trigTd   = (trH * 60 + trM - startMin + 1440) % 1440

// Minuten seit Tagesstart
f_tdMin(int t) =>
    (hour(t, TZ) * 60 + minute(t, TZ) - startMin + 1440) % 1440

// Handelstag-Kennung (Tagesstart wird auf 0:00 verschoben)
f_dayKey(int t) =>
    int s = t + (1440 - startMin) * 60000
    year(s, TZ) * 10000 + month(s, TZ) * 100 + dayofmonth(s, TZ)

// ═══════════════════════════ PROFIL ═══════════════════════════
// Volumen gleichmäßig auf alle Ticks von Tief bis Hoch verteilen (Map: Tick-Index → Volumen)
f_add(map<int, float> m, float h, float l, float v) =>
    if v > 0 and not na(h) and not na(l)
        int lo = math.round(l / syminfo.mintick)
        int hi = math.round(h / syminfo.mintick)
        float part = v / (hi - lo + 1)
        for k = lo to hi
            m.put(k, nz(m.get(k)) + part)

// Tick-Map → Zeilen-Array (rt Ticks je Zeile)
f_rows(map<int, float> m, int rt) =>
    array<int> ks = m.keys()
    int kLo  = int(ks.min())
    int kHi  = int(ks.max())
    int base = int(math.floor(kLo / float(rt))) * rt
    int n    = int(math.floor((kHi - base) / float(rt))) + 1
    array<float> raw = array.new<float>(n, 0.0)
    for k in ks
        int r = int(math.floor((k - base) / float(rt)))
        raw.set(r, raw.get(r) + m.get(k))
    [raw, base]

f_rowMid(int base, int rt, int r) => (base + r * rt + (rt - 1) / 2.0) * syminfo.mintick
f_rowBot(int base, int rt, int r) => (base + r * rt - 0.5) * syminfo.mintick
f_rowTop(int base, int rt, int r) => (base + r * rt + rt - 0.5) * syminfo.mintick

// Value Area: ab POC jeweils die stärkere Nachbarzeile dazunehmen
f_va(array<float> raw, int poc, float pct) =>
    int   n      = raw.size()
    float target = raw.sum() * pct / 100
    float acc    = raw.get(poc)
    int lo = poc
    int hi = poc
    while acc < target and (lo > 0 or hi < n - 1)
        float up = hi < n - 1 ? raw.get(hi + 1) : -1.0
        float dn = lo > 0 ? raw.get(lo - 1) : -1.0
        if up >= dn
            hi += 1
            acc += up
        else
            lo -= 1
            acc += dn
    [lo, hi]

// Zeilen a..b als Kamm (eine waagerechte Linie je Zeile) zeichnen
f_comb(array<polyline> out, array<float> raw, int base, int rt, int a, int b, int x0, float wMs, float mx, color col) =>
    if b >= a
        int i0 = a
        while i0 <= b
            int i1 = math.min(b, i0 + CHUNK - 1)
            array<chart.point> pts = array.new<chart.point>()
            for i = i0 to i1
                float y = f_rowMid(base, rt, i)
                int   x = x0 + int(math.round(raw.get(i) / mx * wMs))
                pts.push(chart.point.from_time(x0, y))
                pts.push(chart.point.from_time(x, y))
                pts.push(chart.point.from_time(x0, y))
            out.push(polyline.new(pts, curved = false, closed = false, xloc = xloc.bar_time, line_color = col, line_width = 1))
            i0 := i1 + 1

// Komplettes Tagesprofil im SVP-Stil
f_drawProf(map<int, float> m, int t0, int t1) =>
    Prof p = Prof.new(array.new<polyline>(), na, na, na, na)
    if m.size() > 0
        array<int> ks = m.keys()
        int span = int(ks.max()) - int(ks.min()) + 1
        int rt   = rowTicks * math.max(1, int(math.ceil(span / (rowTicks * MAX_ROWS * 1.0))))   // nur bei Riesen-Range zusammenfassen
        [raw, base] = f_rows(m, rt)
        int   n  = raw.size()
        float mx = raw.max()
        int   x1 = math.max(t1, t0 + 60000)
        p.bg := box.new(t0, f_rowTop(base, rt, n - 1), x1, f_rowBot(base, rt, 0), border_color = color(na), border_width = 0, xloc = xloc.bar_time, bgcolor = colBg)
        if mx > 0
            int poc = raw.indexof(mx)
            [vaLo, vaHi] = f_va(raw, poc, vaPct)
            float wMs = (x1 - t0) * vpWidth / 100
            f_comb(p.polys, raw, base, rt, 0, vaLo - 1, t0, wMs, mx, colOut)
            f_comb(p.polys, raw, base, rt, vaLo, vaHi, t0, wMs, mx, colVA)
            f_comb(p.polys, raw, base, rt, vaHi + 1, n - 1, t0, wMs, mx, colOut)
            if showPOC
                float py = f_rowMid(base, rt, poc)
                p.poc := line.new(t0, py, x1, py, xloc = xloc.bar_time, color = colPOC, width = pocW)
            if showVAL
                float yh = f_rowTop(base, rt, vaHi)
                float yl = f_rowBot(base, rt, vaLo)
                p.vah := line.new(t0, yh, x1, yh, xloc = xloc.bar_time, color = colVAL, width = 1)
                p.val := line.new(t0, yl, x1, yl, xloc = xloc.bar_time, color = colVAL, width = 1)
    p

// ═══════════════════════════ LVN-ERKENNUNG ═══════════════════════════
f_lvn(map<int, float> m, int smT, int winT, int pkT, float depthMax, float minPeak, int distT, int maxN) =>
    [raw, base] = f_rows(m, rowTicks)
    int n  = raw.size()
    int sR = math.round(smT / float(rowTicks))
    int wR = math.max(1, math.round(winT / float(rowTicks)))
    int pR = math.max(wR + 1, math.round(pkT / float(rowTicks)))
    int dR = math.max(1, math.round(distT / float(rowTicks)))

    // Glättung (gleitender Mittelwert über Präfixsummen)
    array<float> ps = array.new<float>(n + 1, 0.0)
    for i = 0 to n - 1
        ps.set(i + 1, ps.get(i) + raw.get(i))
    array<float> s = array.new<float>(n, 0.0)
    for i = 0 to n - 1
        int a = math.max(0, i - sR)
        int b = math.min(n - 1, i + sR)
        s.set(i, (ps.get(b + 1) - ps.get(a)) / (b - a + 1))
    float sMax = s.max()

    // Kandidaten: lokales Tief mit höheren Peaks auf beiden Seiten
    array<int>   cIdx = array.new<int>()
    array<float> cDep = array.new<float>()
    array<float> cPk  = array.new<float>()
    if n > 2 * wR + 2
        for i = wR to n - 1 - wR
            float v = s.get(i)
            bool isMin = v < s.get(i - 1)
            if isMin
                for j = i - wR to i + wR
                    if s.get(j) < v
                        isMin := false
                        break
            if isMin
                float lp = 0.0
                for j = math.max(0, i - pR) to i - 1
                    lp := math.max(lp, s.get(j))
                float rp = 0.0
                for j = i + 1 to math.min(n - 1, i + pR)
                    rp := math.max(rp, s.get(j))
                float pk = math.min(lp, rp)
                if pk > 0 and pk >= sMax * minPeak / 100 and v / pk <= depthMax / 100
                    cIdx.push(i)
                    cDep.push(v / pk)
                    cPk.push(pk)

    // Auswahl: tiefste Täler zuerst, Mindestabstand einhalten
    array<int>   sel   = array.new<int>()
    array<float> selPk = array.new<float>()
    if cIdx.size() > 0
        array<int> ord = cDep.sort_indices(order.ascending)
        for o in ord
            int  i  = cIdx.get(o)
            bool ok = sel.size() < maxN
            for q in sel
                if math.abs(q - i) < dR
                    ok := false
                    break
            if ok
                sel.push(i)
                selPk.push(cPk.get(o))

    // Preis + Box-Grenzen je LVN
    array<float> pMid = array.new<float>()
    array<float> pLo  = array.new<float>()
    array<float> pHi  = array.new<float>()
    for [k, i] in sel
        float v    = s.get(i)
        float edge = v + (selPk.get(k) - v) * zoneEdge / 100
        int lo = i
        while lo > 0 and s.get(lo - 1) <= edge
            lo -= 1
        int hi = i
        while hi < n - 1 and s.get(hi + 1) <= edge
            hi += 1
        pMid.push(f_rowMid(base, rowTicks, i))
        pLo.push(f_rowBot(base, rowTicks, lo))
        pHi.push(f_rowTop(base, rowTicks, hi))
    [pMid, pLo, pHi]

// LVN-Boxen ab x1 nach rechts
f_makeSet(array<float> pMid, array<float> pLo, array<float> pHi, int x1, color cBg, color cBd, string tag) =>
    LvnSet s = LvnSet.new(array.new<box>(), array.new<label>())
    for [k, p] in pMid
        s.boxes.push(box.new(x1, pHi.get(k), x1, pLo.get(k), border_color = cBd, border_width = 1, extend = extend.right, xloc = xloc.bar_time, bgcolor = cBg))
        if showLbl
            s.lbls.push(label.new(x1, p, tag + " " + str.tostring(p, format.mintick), xloc = xloc.bar_time, style = label.style_label_lower_left, color = color(na), textcolor = cBd, size = size.small))
    s

// Anzahl vollständiger Tage unter den letzten nd
f_fullDays(array<DayVol> h, int nd) =>
    int c = 0
    if h.size() > 0
        for j = math.max(0, h.size() - nd) to h.size() - 1
            if h.get(j).full
                c += 1
    c

// ═══════════════════════════ DATEN ═══════════════════════════
[ibT, ibH, ibL, ibV] = request.security_lower_tf(syminfo.tickerid, ltf, [time, high, low, volume], ignore_invalid_timeframe = true)
bool useLtf = timeframe.in_seconds(ltf) < timeframe.in_seconds(timeframe.period)
bool hasIb  = useLtf and not na(ibT) and ibT.size() > 0

int  dayKey = f_dayKey(time)
bool newDay = bar_index == 0 or dayKey != dayKey[1]

var map<int, float> vol      = map.new<int, float>()
var array<DayVol>   hist     = array.new<DayVol>()
var array<Prof>     profs    = array.new<Prof>()
var array<LvnSet>   dSets    = array.new<LvnSet>()
var array<LvnSet>   wSets    = array.new<LvnSet>()
var bool            done     = false
var bool            validDay = false
var int             dayT0    = na
var int             lastTc   = na
var int             cntIb    = 0
var int             cntFb    = 0

if newDay
    if bar_index > 0
        // abgeschlossenen Tag speichern (Wochenprofil) und sein Profil zeichnen
        hist.push(DayVol.new(vol, validDay))
        while hist.size() > wDays
            hist.shift()
        if showVP and keepProf > 0
            profs.push(f_drawProf(vol, dayT0, lastTc))
            while profs.size() > keepProf
                profs.shift().del()
    vol      := map.new<int, float>()
    done     := false
    validDay := bar_index > 0   // erster Chart-Tag ist meist unvollständig
    dayT0    := time
    cntIb    := 0
    cntFb    := 0

lastTc := time_close

if hasIb
    cntIb += 1
else if volume > 0
    cntFb += 1

// Intrabars der Reihe nach: vor jedem Intrabar prüfen, ob 9:25 erreicht ist
int nIb = hasIb ? ibT.size() : 1
for i = 0 to nIb - 1
    int   t = hasIb ? ibT.get(i) : time
    float h = hasIb ? ibH.get(i) : high
    float l = hasIb ? ibL.get(i) : low
    float v = hasIb ? ibV.get(i) : volume

    if validDay and not done and f_tdMin(t) >= trigTd
        done := true
        if vol.size() > 0
            int x1 = time

            if dOn
                [dM, dL, dH] = f_lvn(vol, dSmooth, dWin, dPeak, dDepth, dMinPk, dDist, dMax)
                if dSets.size() > 0
                    dSets.last().freeze(x1)
                dSets.push(f_makeSet(dM, dL, dH, x1, dCol, dColB, "D-LVN"))
                while dSets.size() > keepDays
                    dSets.shift().del()

            if wOn and f_fullDays(hist, wDays) >= wDays
                map<int, float> wk = vol.copy()
                for j = hist.size() - wDays to hist.size() - 1
                    for [k, x] in hist.get(j).m
                        wk.put(k, nz(wk.get(k)) + x)
                [wM, wL, wH] = f_lvn(wk, wSmooth, wWin, wPeak, wDepth, wMinPk, wDist, wMax)
                if wSets.size() > 0
                    wSets.last().freeze(x1)
                wSets.push(f_makeSet(wM, wL, wH, x1, wCol, wColB, "W-LVN"))
                while wSets.size() > keepDays
                    wSets.shift().del()

    f_add(vol, h, l, v)

// ═══════════════════════════ VOLUME PROFILE HEUTE (live) ═══════════════════════════
var Prof cur = na
if barstate.islast and showVP
    if not na(cur)
        cur.del()
    cur := f_drawProf(vol, dayT0, time_close)

// ═══════════════════════════ INFO ═══════════════════════════
var table info = table.new(position.top_right, 1, 1)
if barstate.islast and showInfo
    int    tot = cntIb + cntFb
    float  pct = tot > 0 ? 100.0 * cntIb / tot : 0.0
    string src = useLtf ? "Intrabars " + ltf + ": " + str.tostring(pct, "#") + " %" : "Chartkerzen"
    string wk  = "Woche " + str.tostring(f_fullDays(hist, wDays)) + "/" + str.tostring(wDays) + " Tage"
    info.cell(0, 0, "LVN 925 · " + src + " · Zeile " + str.tostring(rowTicks * syminfo.mintick) + " Pkt · " + wk, text_color = chart.fg_color, text_size = size.small, bgcolor = color.new(chart.bg_color, 20))
