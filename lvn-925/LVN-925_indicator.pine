//@version=6
indicator("LVN 9:25 + Tagesprofil", shorttitle = "LVN 925", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_polylines_count = 100)

// ─────────────────────────────────────────────────────────────────────────────
//  Markiert um 9:25 (New York) die LVNs (Low Volume Nodes) des Tagesprofils
//  und zeichnet das Volume Profile ab Tagesstart live mit.
//
//  HQ-Daten:  Das Volumen kommt aus Intrabars (Standard 1 Sekunde) und wird
//             je Intrabar gleichmäßig auf jeden Tick zwischen Hoch und Tief
//             verteilt. Zeilengröße = 1 Tick (NQ/MNQ: 0,25 Punkte).
//             Ohne Intrabar-Daten (ältere Historie) → Fallback auf die Chartkerze.
//
//  Snapshot:  Es zählt nur Volumen, das VOR 9:25:00 gehandelt wurde – auf jedem
//             Timeframe exakt, weil die Intrabars einzeln geprüft werden.
//
//  LVN:       Profil wird leicht geglättet, dann gesucht: lokales Tief im
//             Tal-Fenster, mit klar höheren Peaks links UND rechts
//             (Tiefe = Tal / kleinerer Peak ≤ Max. Tiefe). Die tiefsten Täler
//             zuerst, mit Mindestabstand zueinander.
//
//  Wichtig:   Chart mit Extended Hours (ETH) verwenden, sonst fehlt die Nacht.
// ─────────────────────────────────────────────────────────────────────────────

const string TZ       = "America/New_York"
const string G_D      = "Daten / Auflösung"
const string G_T      = "Zeiten (New York)"
const string G_L      = "LVN-Erkennung"
const string G_A      = "LVN-Anzeige"
const string G_P      = "Volume Profile"
const int    MAX_ROWS = 4900   // Polyline: max. 10.000 Punkte → 2 Punkte je Zeile

string ltf      = input.timeframe("1S", "Intrabar-Timeframe", group = G_D, tooltip = "Je kleiner, desto genauer die Volumenverteilung. 1S braucht ein Abo mit Sekunden-Charts – sonst 1 (Minute) wählen. Ältere Historie ohne Intrabars nutzt automatisch die Chartkerze.")
int    rowTicks = input.int(1, "Zeilengröße (Ticks)", minval = 1, maxval = 100, group = G_D, tooltip = "1 = kleinstmögliche Zeile (NQ/MNQ: 0,25 Punkte).")

int dsH = input.int(18, "Tagesstart", minval = 0, maxval = 23, inline = "ds", group = G_T)
int dsM = input.int(0,  ":",          minval = 0, maxval = 59, inline = "ds", group = G_T, tooltip = "18:00 = Start des Globex-Handelstags (NQ). 0:00 = Kalendertag.")
int trH = input.int(9,  "LVN-Zeit",   minval = 0, maxval = 23, inline = "tr", group = G_T)
int trM = input.int(25, ":",          minval = 0, maxval = 59, inline = "tr", group = G_T)
int enH = input.int(16, "Linien bis", minval = 0, maxval = 23, inline = "en", group = G_T)
int enM = input.int(0,  ":",          minval = 0, maxval = 59, inline = "en", group = G_T)

int   smoothT  = input.int(4,     "Glättung ± Ticks",       minval = 0, maxval = 200,  group = G_L, tooltip = "Gegen Tick-Rauschen. 0 = Rohprofil.")
int   winT     = input.int(12,    "Tal-Fenster ± Ticks",    minval = 1, maxval = 400,  group = G_L, tooltip = "Das LVN muss in diesem Bereich die niedrigste Stelle sein.")
int   peakT    = input.int(80,    "Peak-Suche ± Ticks",     minval = 2, maxval = 2000, group = G_L, tooltip = "In diesem Bereich links und rechts wird der höchste Peak gesucht.")
float depthMax = input.float(50,  "Max. Tiefe %",           minval = 1, maxval = 100, step = 5, group = G_L, tooltip = "Volumen im Tal ≤ X % des kleineren Nachbar-Peaks. Kleiner = nur sehr ausgeprägte LVNs.")
float minPeak  = input.float(15,  "Min. Peak % vom POC",    minval = 0, maxval = 100, step = 5, group = G_L, tooltip = "Filtert Täler in den dünnen Rändern des Profils.")
int   minDistT = input.int(16,    "Min. Abstand Ticks",     minval = 1, maxval = 2000, group = G_L)
int   maxLvn   = input.int(6,     "Max. LVNs",              minval = 1, maxval = 20,   group = G_L)

bool   showZone   = input.bool(true, "LVN-Zone", inline = "z", group = G_A)
float  zoneEdge   = input.float(25, "Rand %", minval = 1, maxval = 100, step = 5, inline = "z", group = G_A, tooltip = "Zone = Bereich um das LVN, in dem das Volumen unter Tal + X % des Abstands zum Peak bleibt.")
int    keepDays   = input.int(3, "Tage anzeigen", minval = 1, maxval = 20, group = G_A)
bool   extRight   = input.bool(false, "Linien nach rechts verlängern", group = G_A)
color  colLvn     = input.color(color.new(#ff9800, 0),  "Linie", inline = "c", group = G_A)
color  colZone    = input.color(color.new(#ff9800, 85), "Zone",  inline = "c", group = G_A)
int    lnWidth    = input.int(1, "Breite", minval = 1, maxval = 4, inline = "c", group = G_A)
string lnStyleStr = input.string("Durchgezogen", "Stil", options = ["Durchgezogen", "Gestrichelt", "Gepunktet"], group = G_A)
bool   showLbl    = input.bool(true, "Preis-Label", group = G_A)

bool  showVP    = input.bool(true, "Volume Profile anzeigen", group = G_P)
float vpWidth   = input.float(35, "Breite %", minval = 1, maxval = 100, group = G_P, tooltip = "Längste Zeile = X % der Strecke von Tagesstart bis zur aktuellen Kerze.")
color colVP     = input.color(color.new(#5d606b, 70), "Fläche", inline = "v", group = G_P)
color colVPLine = input.color(color.new(#5d606b, 30), "Kontur", inline = "v", group = G_P)
bool  showPOC   = input.bool(true, "POC", inline = "p", group = G_P)
color colPOC    = input.color(color.new(#f23645, 0), "", inline = "p", group = G_P)
bool  showInfo  = input.bool(true, "Info-Tabelle (Datenqualität)", group = G_P)

string lnStyle = lnStyleStr == "Gestrichelt" ? line.style_dashed : lnStyleStr == "Gepunktet" ? line.style_dotted : line.style_solid

// ═══════════════════════════ ZEIT ═══════════════════════════
int startMin = dsH * 60 + dsM
int trigTd   = (trH * 60 + trM - startMin + 1440) % 1440

// Minuten seit Tagesstart
f_tdMin(int t) =>
    (hour(t, TZ) * 60 + minute(t, TZ) - startMin + 1440) % 1440

// Handelstag-Kennung (Tagesstart wird auf 0:00 verschoben)
f_dayKey(int t) =>
    int s = t + (1440 - startMin) * 60000
    year(s, TZ) * 10000 + month(s, TZ) * 100 + dayofmonth(s, TZ)

// ═══════════════════════════ PROFIL ═══════════════════════════
// Volumen gleichmäßig auf alle Ticks von Tief bis Hoch verteilen (Map: Tick-Index → Volumen)
f_add(map<int, float> m, float h, float l, float v) =>
    if v > 0 and not na(h) and not na(l)
        int lo = math.round(l / syminfo.mintick)
        int hi = math.round(h / syminfo.mintick)
        float part = v / (hi - lo + 1)
        for k = lo to hi
            m.put(k, nz(m.get(k)) + part)

// Tick-Map → Zeilen-Array (rt Ticks je Zeile)
f_rows(map<int, float> m, int rt) =>
    array<int> ks = m.keys()
    int kLo  = int(ks.min())
    int kHi  = int(ks.max())
    int base = int(math.floor(kLo / rt)) * rt
    int n    = int(math.floor((kHi - base) / rt)) + 1
    array<float> raw = array.new<float>(n, 0.0)
    for k in ks
        int r = int(math.floor((k - base) / rt))
        raw.set(r, raw.get(r) + m.get(k))
    [raw, base]

f_rowMid(int base, int rt, int r) => (base + r * rt + (rt - 1) / 2.0) * syminfo.mintick
f_rowBot(int base, int rt, int r) => (base + r * rt - 0.5) * syminfo.mintick
f_rowTop(int base, int rt, int r) => (base + r * rt + rt - 0.5) * syminfo.mintick

// ═══════════════════════════ LVN-ERKENNUNG ═══════════════════════════
f_lvn(map<int, float> m) =>
    [raw, base] = f_rows(m, rowTicks)
    int n  = raw.size()
    int sR = math.round(smoothT / float(rowTicks))
    int wR = math.max(1, math.round(winT / float(rowTicks)))
    int pR = math.max(wR + 1, math.round(peakT / float(rowTicks)))
    int dR = math.max(1, math.round(minDistT / float(rowTicks)))

    // Glättung (gleitender Mittelwert über Präfixsummen)
    array<float> ps = array.new<float>(n + 1, 0.0)
    for i = 0 to n - 1
        ps.set(i + 1, ps.get(i) + raw.get(i))
    array<float> s = array.new<float>(n, 0.0)
    for i = 0 to n - 1
        int a = math.max(0, i - sR)
        int b = math.min(n - 1, i + sR)
        s.set(i, (ps.get(b + 1) - ps.get(a)) / (b - a + 1))
    float sMax = s.max()

    // Kandidaten: lokales Tief mit höheren Peaks auf beiden Seiten
    array<int>   cIdx = array.new<int>()
    array<float> cDep = array.new<float>()
    array<float> cRef = array.new<float>()
    if n > 2 * wR + 2
        for i = wR to n - 1 - wR
            float v = s.get(i)
            bool isMin = v < s.get(i - 1)
            if isMin
                for j = i - wR to i + wR
                    if s.get(j) < v
                        isMin := false
                        break
            if isMin
                float lp = 0.0
                for j = math.max(0, i - pR) to i - 1
                    lp := math.max(lp, s.get(j))
                float rp = 0.0
                for j = i + 1 to math.min(n - 1, i + pR)
                    rp := math.max(rp, s.get(j))
                float pk = math.min(lp, rp)
                if pk > 0 and pk >= sMax * minPeak / 100 and v / pk <= depthMax / 100
                    cIdx.push(i)
                    cDep.push(v / pk)
                    cRef.push(pk)

    // Auswahl: tiefste Täler zuerst, Mindestabstand einhalten
    array<int>   sel    = array.new<int>()
    array<float> selRef = array.new<float>()
    if cIdx.size() > 0
        array<int> ord = cDep.sort_indices(order.ascending)
        for o in ord
            int  i  = cIdx.get(o)
            bool ok = sel.size() < maxLvn
            for p in sel
                if math.abs(p - i) < dR
                    ok := false
                    break
            if ok
                sel.push(i)
                selRef.push(cRef.get(o))

    // Preis + Zone je LVN
    array<float> pMid = array.new<float>()
    array<float> pLo  = array.new<float>()
    array<float> pHi  = array.new<float>()
    for [k, i] in sel
        float v    = s.get(i)
        float edge = v + (selRef.get(k) - v) * zoneEdge / 100
        int lo = i
        while lo > 0 and s.get(lo - 1) <= edge
            lo -= 1
        int hi = i
        while hi < n - 1 and s.get(hi + 1) <= edge
            hi += 1
        pMid.push(f_rowMid(base, rowTicks, i))
        pLo.push(f_rowBot(base, rowTicks, lo))
        pHi.push(f_rowTop(base, rowTicks, hi))
    [pMid, pLo, pHi]

// ═══════════════════════════ DATEN ═══════════════════════════
[ibT, ibH, ibL, ibV] = request.security_lower_tf(syminfo.tickerid, ltf, [time, high, low, volume], ignore_invalid_timeframe = true)
bool useLtf = timeframe.in_seconds(ltf) < timeframe.in_seconds(timeframe.period)
bool hasIb  = useLtf and not na(ibT) and ibT.size() > 0

int  dayKey = f_dayKey(time)
bool newDay = bar_index == 0 or dayKey != dayKey[1]

var map<int, float> vol = map.new<int, float>()
var bool done     = false
var bool validDay = false
var int  dayBar   = na
var int  cntIb    = 0
var int  cntFb    = 0

var array<line>  lvnLines  = array.new<line>()
var array<label> lvnLabels = array.new<label>()
var array<box>   lvnBoxes  = array.new<box>()
var array<int>   perDay    = array.new<int>()

if newDay
    vol.clear()
    done     := false
    validDay := bar_index > 0   // erster Chart-Tag ist meist unvollständig
    dayBar   := bar_index
    cntIb    := 0
    cntFb    := 0

if hasIb
    cntIb += 1
else if volume > 0
    cntFb += 1

// Intrabars der Reihe nach: vor jedem Intrabar prüfen, ob 9:25 erreicht ist
int nIb = hasIb ? ibT.size() : 1
for i = 0 to nIb - 1
    int   t = hasIb ? ibT.get(i) : time
    float h = hasIb ? ibH.get(i) : high
    float l = hasIb ? ibL.get(i) : low
    float v = hasIb ? ibV.get(i) : volume

    if validDay and not done and f_tdMin(t) >= trigTd
        done := true
        if vol.size() > 0
            [pMid, pLo, pHi] = f_lvn(vol)
            int x1 = time
            int x2 = timestamp(TZ, year(t, TZ), month(t, TZ), dayofmonth(t, TZ), enH, enM)
            if x2 <= x1
                x2 += 86400000
            string ext = extRight ? extend.right : extend.none
            for [k, p] in pMid
                lvnLines.push(line.new(x1, p, x2, p, xloc = xloc.bar_time, extend = ext, color = colLvn, style = lnStyle, width = lnWidth))
                lvnBoxes.push(showZone ? box.new(x1, pHi.get(k), x2, pLo.get(k), border_color = color(na), border_width = 0, extend = ext, xloc = xloc.bar_time, bgcolor = colZone) : na)
                lvnLabels.push(showLbl ? label.new(x1, p, "LVN " + str.tostring(p, format.mintick), xloc = xloc.bar_time, style = label.style_label_lower_left, color = color(na), textcolor = colLvn, size = size.small) : na)
            perDay.push(pMid.size())
            // alte Tage entfernen
            while perDay.size() > keepDays
                int c = perDay.shift()
                if c > 0
                    for _j = 1 to c
                        lvnLines.shift().delete()
                        lvnBoxes.shift().delete()
                        lvnLabels.shift().delete()

    f_add(vol, h, l, v)

// ═══════════════════════════ VOLUME PROFILE (live, ab Tagesstart) ═══════════════════════════
var polyline vpPoly  = na
var line     pocLine = na

if barstate.islast and showVP and vol.size() > 0
    vpPoly.delete()
    pocLine.delete()
    array<int> ks = vol.keys()
    int span = int(ks.max()) - int(ks.min()) + 1
    int rt   = rowTicks * math.max(1, int(math.ceil(span / (rowTicks * MAX_ROWS * 1.0))))   // nur bei Riesen-Range zusammenfassen
    [raw, base] = f_rows(vol, rt)
    int   n  = raw.size()
    float mx = raw.max()
    if mx > 0
        float wBars = math.max(1, bar_index - dayBar) * vpWidth / 100
        array<chart.point> pts = array.new<chart.point>()
        pts.push(chart.point.from_index(dayBar, f_rowBot(base, rt, 0)))
        for i = 0 to n - 1
            int x = dayBar + int(math.round(raw.get(i) / mx * wBars))
            pts.push(chart.point.from_index(x, f_rowBot(base, rt, i)))
            pts.push(chart.point.from_index(x, f_rowTop(base, rt, i)))
        pts.push(chart.point.from_index(dayBar, f_rowTop(base, rt, n - 1)))
        vpPoly := polyline.new(pts, curved = false, closed = true, xloc = xloc.bar_index, line_color = colVPLine, fill_color = colVP, line_width = 1)
        if showPOC
            float pp = f_rowMid(base, rt, raw.indexof(mx))
            pocLine := line.new(dayBar, pp, bar_index, pp, color = colPOC, width = 1)

// ═══════════════════════════ INFO ═══════════════════════════
var table info = table.new(position.top_right, 1, 1)
if barstate.islast and showInfo
    int   tot = cntIb + cntFb
    float pct = tot > 0 ? 100.0 * cntIb / tot : 0.0
    string src = useLtf ? "Intrabars " + ltf + ": " + str.tostring(pct, "#") + " %" : "Chartkerzen (Intrabar-TF ≥ Chart-TF)"
    info.cell(0, 0, "LVN 925 · " + src + " · Zeile " + str.tostring(rowTicks * syminfo.mintick) + " Pkt", text_color = chart.fg_color, text_size = size.small, bgcolor = color.new(chart.bg_color, 20))
