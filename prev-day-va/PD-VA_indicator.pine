//@version=6
indicator("Previous Day VAH / VAL / POC", shorttitle = "PD VA", overlay = true, max_lines_count = 500, max_labels_count = 500)

// Previous day volume profile (POC/VAH/VAL). Lines start at the beginning of the
// previous day and keep running until price touches the level. Calculates like
// the TradingView VP tool: use the same row settings. Charts above 1m use 1m data.

const string G_S = "Session"
const string G_P = "Profile"
const string G_L = "Lines"

string sessMode  = input.string("Full trading day (ETH)", "Profile basis", options = ["Full trading day (ETH)", "RTH only"], group = G_S)
string rthSess   = input.session("0930-1600", "RTH time", group = G_S)
string rthTz     = input.string("America/New_York", "RTH timezone", group = G_S)
string rowMode   = input.string("Auto (1 Tick)", "Row Layout", options = ["Auto (1 Tick)", "Ticks per row", "Number of rows"], group = G_P, tooltip = "Auto = finest resolution (NQ/ES 0.25, GC 0.10). Otherwise match the TradingView VP tool.")
int    tickRow   = input.int(4, "Ticks per row", minval = 1, maxval = 1000, group = G_P, tooltip = "Only for Row Layout = Ticks per row. 4 = 1 point on NQ.")
int    numRows   = input.int(100, "Number of rows", minval = 10, maxval = 5000, group = G_P, tooltip = "Only for Row Layout = Number of rows.")
float  vaPct     = input.float(70, "Value Area %", minval = 10, maxval = 100, group = G_P) / 100
bool   vaPairs   = input.bool(true, "VA in 2-row steps (like TV)", group = G_P)
bool   showPoc   = input.bool(true, "POC", inline = "poc", group = G_L)
color  colPoc    = input.color(#FF9800, "", inline = "poc", group = G_L)
bool   showVah   = input.bool(true, "VAH", inline = "vah", group = G_L)
color  colVah    = input.color(#2196F3, "", inline = "vah", group = G_L)
bool   showVal   = input.bool(true, "VAL", inline = "val", group = G_L)
color  colVal    = input.color(#2196F3, "", inline = "val", group = G_L)
int    lineW     = input.int(2, "Line width", minval = 1, maxval = 5, group = G_L)
bool   showLbl   = input.bool(true, "Labels", group = G_L)
bool   delTaken  = input.bool(false, "Delete taken lines", group = G_L)
int    maxOpen   = input.int(30, "Max. open levels", minval = 3, maxval = 150, group = G_L)

// ─── State ──────────────────────────────────────────────────────────────────
var float[] dH       = array.new_float()
var float[] dL       = array.new_float()
var float[] dV       = array.new_float()
var int     dStart   = na
var line[]  lvLines  = array.new_line()
var label[] lvLabels = array.new_label()
var float[] lvPrices = array.new_float()
var int     dbgBars  = 0
var float   dbgVol   = 0.0
var float   dbgRow   = 0.0

// ─── Row size (Auto detects NQ/MNQ, ES/MES, GC/MGC) ──────────────────────────
string root    = syminfo.root
string inst    = root == "NQ" or root == "MNQ" ? "NQ" : root == "ES" or root == "MES" ? "ES" : root == "GC" or root == "MGC" ? "GC" : root
float  autoRow = inst == "NQ" or inst == "ES" ? 0.25 : inst == "GC" ? 0.10 : syminfo.mintick
float  rowSize = rowMode == "Auto (1 Tick)" ? math.max(autoRow, syminfo.mintick) : tickRow * syminfo.mintick
int    nRows   = rowMode == "Number of rows" ? numRows : 0

// ─── Profile → [POC, VAH, VAL] ───────────────────────────────────────────────
// Ticks mode (like FRVP "Ticks per row"): each row = one price level, bar volume
// split evenly across all levels from low to high (inclusive).
// Rows mode: range split into n equal rows, volume shared by overlap.
f_profile(float[] hs, float[] ls, float[] vs) =>
    float lo    = ls.min()
    float hi    = hs.max()
    bool  ticks = nRows == 0
    float rs    = ticks ? math.max(rowSize, (hi - lo) / 5000) : math.max(hi - lo, syminfo.mintick) / nRows
    int   n     = ticks ? int(math.floor((hi - lo) / rs + 1e-6)) + 1 : nRows
    float[] bins = array.new_float(n, 0.0)
    for i = 0 to hs.size() - 1
        float h = hs.get(i)
        float l = ls.get(i)
        float v = vs.get(i)
        int b0 = math.max(0, math.min(n - 1, int(math.floor((l - lo) / rs + 1e-6))))
        int b1 = math.max(0, math.min(n - 1, int(math.floor((h - lo) / rs + 1e-6))))
        if ticks or h <= l or b0 == b1
            float share = v / (b1 - b0 + 1)
            for b = b0 to b1
                bins.set(b, bins.get(b) + share)
        else
            for b = b0 to b1
                float bl = lo + b * rs
                float ov = math.min(h, bl + rs) - math.max(l, bl)
                if ov > 0
                    bins.set(b, bins.get(b) + v * ov / (h - l))
    int   poc    = bins.indexof(bins.max())
    float target = bins.sum() * vaPct
    float acc    = bins.get(poc)
    int   up     = poc
    int   dn     = poc
    int   step   = vaPairs ? 2 : 1
    while acc < target and (up < n - 1 or dn > 0)
        float vUp = 0.0
        float vDn = 0.0
        for k = 1 to step
            vUp += up + k <= n - 1 ? bins.get(up + k) : 0.0
            vDn += dn - k >= 0 ? bins.get(dn - k) : 0.0
        if up < n - 1 and (dn <= 0 or vUp >= vDn)
            up := math.min(n - 1, up + step)
            acc += vUp
        else
            dn := math.max(0, dn - step)
            acc += vDn
    float pocPx = ticks ? lo + poc * rs : lo + (poc + 0.5) * rs
    float vahPx = ticks ? lo + up * rs : lo + (up + 1) * rs
    float valPx = lo + dn * rs
    [math.round_to_mintick(pocPx), math.round_to_mintick(vahPx), math.round_to_mintick(valPx)]

// ─── 1m data (on a 1m chart the chart bar itself is used) ───────────────────
bool   useLtf = timeframe.in_seconds() > 60
string ltf    = useLtf ? "1" : timeframe.period
[ltfH, ltfL, ltfV] = request.security_lower_tf(syminfo.tickerid, ltf, [high, low, volume])

// ─── Session logic ──────────────────────────────────────────────────────────
bool isRth   = sessMode == "RTH only"
bool newDay  = timeframe.change("1D")
bool inRth   = not na(time(timeframe.period, rthSess, rthTz))
bool startP  = isRth ? inRth and (not inRth[1] or newDay) : newDay
bool endP    = isRth ? inRth[1] and (not inRth or newDay) : newDay
bool collect = isRth ? inRth : true

// Day finished → build profile, draw lines from the start of that day
if endP and dH.size() > 0 and not na(dStart)
    [pocPx, vahPx, valPx] = f_profile(dH, dL, dV)
    for k = 0 to 2
        bool   on  = k == 0 ? showVah : k == 1 ? showPoc : showVal
        float  px  = k == 0 ? vahPx : k == 1 ? pocPx : valPx
        color  col = k == 0 ? colVah : k == 1 ? colPoc : colVal
        string nm  = k == 0 ? "PD VAH " : k == 1 ? "PD POC " : "PD VAL "
        if on
            lvLines.push(line.new(dStart, px, time, px, xloc.bar_time, extend.none, col, line.style_solid, lineW))
            lvLabels.push(showLbl ? label.new(time, px, nm + str.tostring(px, format.mintick), xloc.bar_time, color = color.new(color.black, 100), textcolor = col, style = label.style_label_left, size = size.small) : na)
            lvPrices.push(px)
    dbgBars := dH.size()
    dbgVol  := dV.sum()
    dbgRow  := nRows > 0 ? (dH.max() - dL.min()) / nRows : rowSize
    dStart  := na

if startP
    dH.clear()
    dL.clear()
    dV.clear()
    dStart := time

// Collect data of the running day
if collect and not na(dStart)
    if useLtf and ltfH.size() > 0
        for j = 0 to ltfH.size() - 1
            dH.push(ltfH.get(j))
            dL.push(ltfL.get(j))
            dV.push(nz(ltfV.get(j)))
    else
        dH.push(high)
        dL.push(low)
        dV.push(nz(volume))

// Too many open levels → stop extending the oldest
while lvPrices.size() > maxOpen
    lvLines.shift()
    label.delete(lvLabels.shift())
    lvPrices.shift()

// ─── Extend open levels / check for take ────────────────────────────────────
bool  anyTaken = false
float hiX      = math.max(high, nz(close[1], high))
float loX      = math.min(low, nz(close[1], low))
int   cnt      = lvPrices.size()
if cnt > 0
    for i = cnt - 1 to 0
        float px = lvPrices.get(i)
        line.set_x2(lvLines.get(i), time)
        label lb = lvLabels.get(i)
        if not na(lb)
            label.set_x(lb, time)
        if hiX >= px and loX <= px
            anyTaken := true
            label.delete(lb)
            if delTaken
                line.delete(lvLines.get(i))
            lvLabels.remove(i)
            lvLines.remove(i)
            lvPrices.remove(i)

// Diagnostics box: bars/volume of the last day profile
var table info = table.new(position.bottom_right, 1, 1, bgcolor = color.new(color.black, 30))
if barstate.islast
    string warn = dbgVol == 0 ? "  ⚠ NO VOLUME (symbol without volume?)" : dbgBars < 50 ? "  ⚠ TOO FEW BARS – use a 1m chart" : ""
    table.cell(info, 0, 0, "PD VA · TF " + timeframe.period + " · Prev day: " + str.tostring(dbgBars) + " bars · Vol " + str.tostring(dbgVol, format.volume) + " · Row " + str.tostring(dbgRow, format.mintick) + " pts" + warn, text_color = color.white, text_size = size.small)

alertcondition(anyTaken, "Previous day level taken", "PD VAH/VAL/POC was taken")
plot(na, "dummy", display = display.none)

// END
